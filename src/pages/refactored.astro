				const handleId = bboxDragMode.replace('scale-', '');
				let scaleX = 1, scaleY = 1;
				
				// Calculate distance from anchor to current position vs original bounds
				if (handleId === 'se') {
					scaleX = b.width > 0 ? (svgPt.x - bboxScaleAnchor.x) / b.width : 1;
					scaleY = b.height > 0 ? (svgPt.y - bboxScaleAnchor.y) / b.height : 1;
				} else if (handleId === 'sw') {
					scaleX = b.width > 0 ? (bboxScaleAnchor.x - svgPt.x) / b.width : 1;
					scaleY = b.height > 0 ? (svgPt.y - bboxScaleAnchor.y) / b.height : 1;
				} else if (handleId === 'ne') {
					scaleX = b.width > 0 ? (svgPt.x - bboxScaleAnchor.x) / b.width : 1;
