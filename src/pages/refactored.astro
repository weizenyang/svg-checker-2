							if (compareShapeBenchBtnEl) compareShapeBenchBtnEl.style.display = "none";
							if (!container.querySelector("[data-compare-carousel]")) {
								container.insertBefore(carouselLabel, imgWrapperEl);
								if (imgWrapperEl) {
									imgWrapperEl.appendChild(prevBtn);
									imgWrapperEl.appendChild(nextBtn);
								}
								container.appendChild(backBtn);
							}
							const updateCarousel = () => {
								carouselLabel.textContent = items[carouselIdx].label;
								previewImg.src = items[carouselIdx].dataUrl;
								prevBtn.style.visibility = carouselIdx <= 0 ? "hidden" : "visible";
								nextBtn.style.visibility = carouselIdx >= items.length - 1 ? "hidden" : "visible";
							};
							updateCarousel();
							prevBtn.onclick = () => { if (carouselIdx > 0) { carouselIdx--; updateCarousel(); } };
							nextBtn.onclick = () => { if (carouselIdx < items.length - 1) { carouselIdx++; updateCarousel(); } };
							backBtn.onclick = () => {
								carouselLabel.remove();
								prevBtn.remove();
								nextBtn.remove();
								backBtn.remove();
								previewText.style.display = "";
								if (compareBtnEl) compareBtnEl.style.display = "";
								compareOpencvBtn.style.display = "";
								const compareShapeBenchBtnEl2 = document.getElementById("compare-shape-bench-btn");
								if (compareShapeBenchBtnEl2) compareShapeBenchBtnEl2.style.display = "";
								previewImg.src = img.data;
								updatePreviewText(img.name, getImageTransform(img.name));
							};
						}
					} catch (err) {
						console.error("OpenCV comparison error:", err);
						const msg = err instanceof Error ? err.message : "OpenCV comparison failed";
						if (scoresEl) scoresEl.textContent = msg;
					} finally {
						compareOpencvBtn.disabled = false;
						compareOpencvBtn.textContent = "Compare (OpenCV)";
					}
				});

				compareShapeBenchBtn.addEventListener("click", async () => {
					const svgEl = document.querySelector("#svg-container svg");
					const pathEl = currentHoveredPathElement;
					const scoresEl = document.getElementById("compare-floorplan-scores");
					if (!svgEl || !pathEl) {
						if (scoresEl) scoresEl.textContent = "Hover a path first";
						return;
					}
					if (shapeBenchmarkCandidates.length === 0) {
						showToast("Load benchmark images via the Silhouette button", "warning");
						if (scoresEl) scoresEl.textContent = "No benchmark images loaded";
						openShapeBenchmarkDialog();
						return;
					}
					const benchPathIdEarly =
						pathEl.getAttribute("id") || pathEl.id || "unknown";
					const escBenchPath = String(benchPathIdEarly)
						.replace(/&/g, "&amp;")
						.replace(/</g, "&lt;")
						.replace(/>/g, "&gt;")
						.replace(/"/g, "&quot;");
					shapeBenchCarouselDismissedPathId = null;
					openShapeBenchmarkDialog();
					const benchResultsWrap = document.getElementById("shape-benchmark-results");
					if (benchResultsWrap) {
						benchResultsWrap.classList.remove("hidden");
						benchResultsWrap.innerHTML = `<p class="p-2 text-xs font-medium border-b border-neutral-200 bg-neutral-50">Silhouette bench · Path: <code>${escBenchPath}</code></p><p class="p-2 text-xs text-neutral-600">Deduplicating and preparing…</p>`;
					}
					compareShapeBenchBtn.disabled = true;
					const prevLabel = compareShapeBenchBtn.textContent;
					compareShapeBenchBtn.textContent = "Running…";
					if (scoresEl) scoresEl.textContent = "Running silhouette benchmark…";
					const progressWrap = document.getElementById("shape-benchmark-progress");
					const progressBar = document.getElementById("shape-benchmark-progress-bar");
					const progressText = document.getElementById("shape-benchmark-progress-text");
					const updateBenchProgress = (done: number, total: number, detail?: string) => {
						if (!progressBar || !progressText) return;
						const pct = total <= 0 ? 0 : Math.min(100, Math.round((done / total) * 100));
						progressBar.style.width = `${pct}%`;
						const line =
							total <= 0
								? "0 / 0"
								: detail
									? `${done} / ${total} — ${detail}`
									: `${done} / ${total}`;
						progressText.textContent = line;
						progressText.setAttribute("title", detail || line);
					};
					if (progressWrap && progressBar && progressText) {
						progressWrap.classList.remove("hidden");
						progressBar.style.width = "0%";
						updateBenchProgress(0, shapeBenchmarkCandidates.length, "Hashing / deduping…");
					}
					try {
						const rawList = shapeBenchmarkCandidates.map((c) => ({ name: c.name, data: c.data }));
						const { kept, dropped, originalCount } =
							await dedupeBenchmarkCandidatesByIdenticalContent(rawList);
						if (dropped.length > 0) {
							console.log("[Silhouette bench] Deduped identical bytes:", dropped);
						}
						if (kept.length === 0) {
							if (scoresEl) scoresEl.textContent = "Nothing to compare after dedupe";
							showToast("No images left after deduplication", "warning");
							return;
						}
						const {
							candidates: keptForBench,
							ruleMatched: unitRuleForBench,
							typeStr: unitTypeForBench,
						} = applyUnitReferenceCandidateFilter(benchPathIdEarly, kept);
						if (unitRuleForBench && keptForBench.length === 0) {
							if (scoresEl) {
								scoresEl.textContent =
									"No benchmark images pass the unit reference filter for this path";
							}
							showToast(
								"No images pass unit reference filter — check type vs image names",
								"warning",
							);
							if (benchResultsWrap) {
								const escType =
									String(unitTypeForBench ?? "")
										.replace(/&/g, "&amp;")
										.replace(/</g, "&lt;")
										.replace(/>/g, "&gt;")
										.replace(/"/g, "&quot;") || "—";
								benchResultsWrap.innerHTML = `<p class="p-2 text-xs font-medium border-b border-neutral-200 bg-neutral-50">Silhouette bench · Path: <code>${escBenchPath}</code></p><p class="p-2 text-xs text-amber-900">Unit filter matched this path but no images passed token rules (type: <code>${escType}</code>).</p>`;
							}
							return;
						}
						const totalBench = keptForBench.length;
						updateBenchProgress(0, totalBench, "Preparing…");
						const flashPreEl = document.getElementById(
							"shape-bench-flash-preprocess",
						) as HTMLInputElement | null;
						const result = await runSilhouetteBenchmarkBatch(svgEl, pathEl, keptForBench, {
							shapeBenchFlashPreprocessSteps: !!flashPreEl?.checked,
							onPreprocessFlashStep: shapeBenchPreprocessFlashStepHandler,
							onProgress: ({ done, total, name, phase }) => {
								if (phase === "cutout") {
									updateBenchProgress(0, total, total ? "Cutout + silhouettes…" : "");
									return;
								}
								updateBenchProgress(done, total, name || "");
							},
							onPartialResult: (snap) => {
								const handled = snap.candidatesHandled ?? snap.rows.length;
								const filtN = snap.filteredOut?.length ?? 0;
								const pending = handled < totalBench;
								renderShapeBenchmarkTable(snap, {
									statusLine: pending
										? `${snap.rows.length} ranked · ${handled} / ${totalBench} processed${filtN ? ` · ${filtN} skipped (aspect)` : ""}`
										: filtN
											? `${snap.rows.length} ranked · ${filtN} skipped (aspect vs cutout)`
											: "",
								});
								if (snap.rankedCarousel.length > 0) {
									showShapeBenchmarkRankCarousel(snap.rankedCarousel, {
										pathId: snap.pathId,
										scored: handled,
										total: totalBench,
										featureColumnLabel: "Score",
									});
									const benchPathIdPartial = pathEl.getAttribute("id") || pathEl.id;
									if (benchPathIdPartial) {
										lastShapeBenchRankCarousel = {
											pathId: benchPathIdPartial,
											featureColumnLabel: "Score",
											items: snap.rankedCarousel.map((it) => ({ ...it })),
										};
										setSilhouetteBenchRankForPath(benchPathIdPartial, snap.rankedCarousel, {
											featureColumnLabel: "Score",
											scored: handled,
											total: totalBench,
										}, svgEl);
									}
								}
							},
						});
						renderShapeBenchmarkTable(result);
						const benchPathId = pathEl.getAttribute("id") || pathEl.id;
						if (benchPathId) {
							lastShapeBenchRankCarousel = {
								pathId: benchPathId,
								featureColumnLabel: "Score",
								items: result.rankedCarousel.map((it) => ({ ...it })),
							};
							if (result.rankedCarousel.length > 0) {
								setSilhouetteBenchRankForPath(benchPathId, result.rankedCarousel, {
									featureColumnLabel: "Score",
									scored: result.rows.length,
									total: keptForBench.length,
								}, svgEl);
							}
						}
						showShapeBenchmarkRankCarousel(result.rankedCarousel, {
							pathId: result.pathId,
							scored: result.rows.length,
							total: keptForBench.length,
							featureColumnLabel: "Score",
						});
						const dedupeBit =
							dropped.length > 0 ? ` · ${kept.length} unique (${originalCount} loaded)` : "";
						const filtBit =
							result.filteredOut?.length > 0
								? ` · ${result.filteredOut.length} skipped (aspect gate vs cutout)`
								: "";
						if (scoresEl) {
							scoresEl.textContent = `Score rank (IoU + Chamfer, best first) · ${result.rows.length} image(s)${dedupeBit}${filtBit}`;
						}
						showToast(
							dropped.length > 0
								? `Silhouette benchmark done — ${kept.length} unique (${dropped.length} duplicate name(s) skipped, shorter name kept)`
								: "Silhouette benchmark done — ranked preview carousel (best first)",
							"success",
						);
					} catch (err) {
						console.error("Silhouette benchmark error:", err);
						const msg = err instanceof Error ? err.message : "Silhouette benchmark failed";
						if (scoresEl) scoresEl.textContent = msg;
						showToast(msg, "error");
					} finally {
						if (progressWrap) progressWrap.classList.add("hidden");
						if (progressBar) progressBar.style.width = "0%";
						if (progressText) {
							progressText.textContent = "0 / 0";
							progressText.removeAttribute("title");
						}
						compareShapeBenchBtn.disabled = false;
						compareShapeBenchBtn.textContent = prevLabel || "Silhouette bench";
					}
				});
			}

			const PREVIEW_HOVER_KEY = "__floorplanPreviewHoverDelegates";
			const prevHoverDel = (parentSVG as any)[PREVIEW_HOVER_KEY];
			if (prevHoverDel) {
				parentSVG.removeEventListener("mousedown", prevHoverDel.mousedown);
				parentSVG.removeEventListener("mouseover", prevHoverDel.mouseover);
				parentSVG.removeEventListener("mouseout", prevHoverDel.mouseout);
				delete (parentSVG as any)[PREVIEW_HOVER_KEY];
			}

			const onPathMousedown = (e: MouseEvent) => {
				const pathEl = (e.target as Element | null)?.closest?.("path") as SVGPathElement | null;
				if (!pathEl || !parentSVG.contains(pathEl)) return;
				const pathId = pathEl.getAttribute("id") || pathEl.id;
				if (!pathId) return;
				previewPinned = true;
				const preview = document.getElementById("image-previewer-container");
				if (preview) {
					preview.style.left = `${e.clientX}px`;
					preview.style.top = `${e.clientY}px`;
				}
			};
			const onPathMouseover = (e: MouseEvent) => {
				const pathEl = (e.target as Element | null)?.closest?.("path") as SVGPathElement | null;
				if (!pathEl || !parentSVG.contains(pathEl)) return;
				const pvShow = document.getElementById("image-previewer-container");
				if (pvShow) pvShow.style.display = "block";
				const pathId = pathEl.getAttribute("id") || pathEl.id;
				const selectedImage = pathId ? findMatchingImage(pathId) : null;
				const container = document.getElementById("image-previewer-container");
				const previewImg = document.getElementById("image-previewer-image") as HTMLImageElement;
				const scoresEl = document.getElementById("compare-floorplan-scores");
				const hasCompareCarousel = container?.querySelector("[data-compare-carousel]");
				const hasRankBenchCarousel = container?.querySelector("[data-benchmark-rank-carousel]");
				const sameHoveredPath = currentHoveredPathElement === pathEl;
				// Keep compare / bench carousels when re-hovering the same path after the panel was
				// hidden by mouseout (previewPinned is still false). Requiring previewPinned caused
				// carousels to be torn down on every re-hover.
				if (selectedImage) {
					if (hasCompareCarousel && sameHoveredPath) {
						currentHoveredPathElement = pathEl;
						currentHoveredImageName = selectedImage.name;
						return;
					}
				}
				if (hasRankBenchCarousel && sameHoveredPath) {
					currentHoveredPathElement = pathEl;
					if (selectedImage) currentHoveredImageName = selectedImage.name;
					else currentHoveredImageName = null;
					return;
				}
				if (scoresEl) scoresEl.textContent = "";
				container?.querySelectorAll("[data-compare-carousel]").forEach((el) => el.remove());
				destroyShapeBenchRankCarouselUI();
				const compareBtnEl = document.getElementById("compare-floorplan-btn");
				const compareOpencvBtnEl = document.getElementById("compare-opencv-btn");
				const compareShapeBenchBtnEl = document.getElementById("compare-shape-bench-btn");

				const rankSvg = parentSVG;
				const silRankEntry = pathId ? getSilhouetteBenchRankEntryForPathOnSvg(rankSvg, pathId) : undefined;
				if (
					pathId &&
					shapeBenchCarouselDismissedPathId !== pathId &&
					silRankEntry?.items?.length
				) {
					currentHoveredPathElement = pathEl;
					if (selectedImage) currentHoveredImageName = selectedImage.name;
					else currentHoveredImageName = null;
					const rs = silRankEntry.scored;
					const rt = silRankEntry.total;
					showShapeBenchmarkRankCarousel(silRankEntry.items, {
						pathId,
						featureColumnLabel: silRankEntry.featureColumnLabel ?? "Score",
						...(rs != null && rt != null ? { scored: rs, total: rt } : {}),
					});
					return;
				}

				if (selectedImage) {
					currentHoveredPathElement = pathEl;
					if (compareBtnEl) compareBtnEl.style.display = "";
					if (compareOpencvBtnEl) compareOpencvBtnEl.style.display = "";
					if (compareShapeBenchBtnEl) compareShapeBenchBtnEl.style.display = "";
					const previewTextEl = document.getElementById("image-previewer-text");
					if (previewTextEl) previewTextEl.style.display = "";
					previewImg.src = selectedImage.data;

					// Track current hovered image name
					currentHoveredImageName = selectedImage.name;

					// Get or create transformation entry
					const transform = getImageTransform(selectedImage.name);

					// Get imported rotation and flip for this image
					const imageIdentifier = getUnitIdentifier(selectedImage.name);
					let importedRotationForImage = null;
					let importedFlipForImage = null;
					if (imageIdentifier && importedUnitReference) {
						const importedUnit = importedUnitReference.find((unit: any) => {
							const unitIdentifier = getUnitIdentifier(unit.name || "");
							return unitIdentifier === imageIdentifier;
						});
						if (importedUnit) {
							importedRotationForImage = typeof importedUnit.rotation === 'string' ? parseInt(importedUnit.rotation) : importedUnit.rotation;
							importedFlipForImage = typeof importedUnit.flip === 'string' ? importedUnit.flip === 'true' : importedUnit.flip;
						}
					}

					// Update preview text with transform values
					updatePreviewText(selectedImage.name, transform);

					// Apply saved transformation after image loads
					previewImg.onload = () => {
						if (transform) {
							applyImageTransform(previewImg, transform, importedRotationForImage, importedFlipForImage);
							updatePreviewText(selectedImage.name, transform);
						}
					};

					// If image is already loaded, apply immediately
					if (previewImg.complete) {
						if (transform) {
							applyImageTransform(previewImg, transform, importedRotationForImage, importedFlipForImage);
							updatePreviewText(selectedImage.name, transform);
						}
					}
				} else if (pathId) {
					const hasBench = shapeBenchmarkCandidates.length > 0;
					currentHoveredPathElement = pathEl;
					currentHoveredImageName = null;
					if (compareBtnEl) compareBtnEl.style.display = "none";
					if (compareOpencvBtnEl) compareOpencvBtnEl.style.display = "none";
					if (compareShapeBenchBtnEl) compareShapeBenchBtnEl.style.display = "";
					previewImg.src = "";
					const previewTextEl = document.getElementById("image-previewer-text");
					if (previewTextEl) {
						previewTextEl.style.display = "";
						previewTextEl.replaceChildren();
						const wrap = document.createElement("span");
						wrap.style.cssText = "color:#444;line-height:1.35;";
						wrap.append("Path ");
						const code = document.createElement("code");
						code.style.fontSize = "9px";
						code.textContent = pathId;
						wrap.appendChild(code);
						wrap.appendChild(document.createElement("br"));
						wrap.append("No Check Floorplans image for this path.");
						wrap.appendChild(document.createElement("br"));
						wrap.append(
							hasBench
								? "Silhouette bench uses the benchmark image set."
								: "Load benchmark images in the panel below for Silhouette bench.",
						);
						previewTextEl.appendChild(wrap);
					}
				} else {
					previewImg.src = "";
					const previewTextEl = document.getElementById("image-previewer-text");
					if (previewTextEl) previewTextEl.innerHTML = "";
					currentHoveredImageName = null;
					currentHoveredPathElement = null;
					if (compareBtnEl) compareBtnEl.style.display = "";
					if (compareOpencvBtnEl) compareOpencvBtnEl.style.display = "";
					if (compareShapeBenchBtnEl) compareShapeBenchBtnEl.style.display = "";
				}
			};
			const onPathMouseout = (e: MouseEvent) => {
				const pathEl = (e.target as Element | null)?.closest?.("path");
				if (!pathEl || !parentSVG.contains(pathEl)) return;
				const preview = document.getElementById("image-previewer-container");
				if (!preview) return;
				if (previewPinned) return;
				const related = e.relatedTarget as Node | null;
				if (related && preview.contains(related)) return;
				preview.style.display = "none";
			};
			(parentSVG as any)[PREVIEW_HOVER_KEY] = {
				mousedown: onPathMousedown,
				mouseover: onPathMouseover,
				mouseout: onPathMouseout,
			};
			parentSVG.addEventListener("mousedown", onPathMousedown);
			parentSVG.addEventListener("mouseover", onPathMouseover);
			parentSVG.addEventListener("mouseout", onPathMouseout);
			highlightPathsWithoutMatchingImages();
			if (!(window as any).__floorplanPreviewMoveClickBound) {
				(window as any).__floorplanPreviewMoveClickBound = true;
				globalSvgContainer.addEventListener("mousemove", (e) => {
					if (!previewPinned) {
						const preview = document.getElementById("image-previewer-container");
						if (preview) {
							preview.style.left = `${e.clientX}px`;
							preview.style.top = `${e.clientY}px`;
						}
					}
				});
				document.addEventListener("click", (e) => {
					const preview = document.getElementById("image-previewer-container");
					if (!preview || preview.style.display === "none") return;
					const target = e.target as Element;
					const isOnPreview = preview.contains(target);
					const isOnPath = target.closest("#svg-container path");
					if (!isOnPreview && !isOnPath) {
						previewPinned = false;
						preview.style.display = "none";
						// Keep compare / Shape-bench carousels in the DOM so re-opening the preview
						// (re-hover or click path) does not require running compare again.
						const stillHasCarousel =
							!!preview.querySelector("[data-compare-carousel]") ||
							!!preview.querySelector("[data-benchmark-rank-carousel]");
						if (!stillHasCarousel) {
							const pt = document.getElementById("image-previewer-text");
							const cb = document.getElementById("compare-floorplan-btn");
							const cob = document.getElementById("compare-opencv-btn");
							const csb = document.getElementById("compare-shape-bench-btn");
							if (pt) pt.style.display = "";
							if (cb) cb.style.display = "";
							if (cob) cob.style.display = "";
							if (csb) csb.style.display = "";
						}
					}
				});
			}

			// Keyboard handlers for image transformation
			// Remove any existing preview keyboard handler to avoid duplicates
			const existingPreviewKeyHandler = (window as any).previewKeyHandler;
			if (existingPreviewKeyHandler) {
				document.removeEventListener("keydown", existingPreviewKeyHandler);
			}

			// Create new keyboard handler
			(window as any).previewKeyHandler = (e: KeyboardEvent) => {
				// Check if previewer is visible and an image is hovered
				const previewContainer = document.getElementById("image-previewer-container");
				if (!previewContainer || previewContainer.style.display === "none" || !currentHoveredImageName) {
					return; // Let other handlers process the key
				}

				// Check if focus is on an input-like element
				const activeEl = document.activeElement;
				const isInputLike = activeEl && (
					activeEl.tagName === "INPUT" || 
					activeEl.tagName === "TEXTAREA" || 
					activeEl.tagName === "SELECT" || 
					(activeEl as HTMLElement).isContentEditable
				);
				if (isInputLike) {
					return; // Don't interfere with input fields
				}

				const previewImg = document.getElementById("image-previewer-image") as HTMLImageElement;
				if (!previewImg || !previewImg.src) {
					return;
				}

				const transform = getImageTransform(currentHoveredImageName);
				if (!transform) {
					return;
				}

				// Get imported rotation and flip for this image to calculate final values and limits
				const imageIdentifier = getUnitIdentifier(currentHoveredImageName);
				let importedRotationForImage = null;
				let importedFlipForImage = null;
				if (imageIdentifier && importedUnitReference) {
					const importedUnit = importedUnitReference.find((unit: any) => {
						const unitIdentifier = getUnitIdentifier(unit.name || "");
						return unitIdentifier === imageIdentifier;
					});
					if (importedUnit) {
						importedRotationForImage = typeof importedUnit.rotation === 'string' ? parseInt(importedUnit.rotation) : importedUnit.rotation;
						importedFlipForImage = typeof importedUnit.flip === 'string' ? importedUnit.flip === 'true' : importedUnit.flip;
					}
				}

				// Handle ArrowLeft: rotate -90 degrees (change)
				if (e.key === "ArrowLeft") {
					e.preventDefault();
					e.stopPropagation();
					// Calculate new change value
					const newChange = transform.rotation - 90;
					// Calculate final rotation with new change
					const finalRotation = importedRotationForImage !== null ? importedRotationForImage + newChange : newChange;
					// Limit final rotation to -90 to 180
					if (finalRotation >= -90 && finalRotation <= 180) {
						transform.rotation = newChange;
						applyImageTransform(previewImg, transform, importedRotationForImage, importedFlipForImage);
						updatePreviewText(currentHoveredImageName, transform);
						console.log("Image transform updated:", transform);
					}
					return;
				}

				// Handle ArrowRight: rotate +90 degrees (change)
				if (e.key === "ArrowRight") {
					e.preventDefault();
					e.stopPropagation();
					// Calculate new change value
					const newChange = transform.rotation + 90;
					// Calculate final rotation with new change
					const finalRotation = importedRotationForImage !== null ? importedRotationForImage + newChange : newChange;
					// Limit final rotation to -90 to 180
					if (finalRotation >= -90 && finalRotation <= 180) {
						transform.rotation = newChange;
						applyImageTransform(previewImg, transform, importedRotationForImage, importedFlipForImage);
						updatePreviewText(currentHoveredImageName, transform);
						console.log("Image transform updated:", transform);
					}
					return;
				}

				// Handle F key: flip image (toggle the change)
				if (e.key === "f" || e.key === "F") {
					e.preventDefault();
					e.stopPropagation();
					transform.flip = !transform.flip; // Toggle the change
					applyImageTransform(previewImg, transform, importedRotationForImage, importedFlipForImage);
					updatePreviewText(currentHoveredImageName, transform);
					console.log("Image transform updated:", transform);
					return;
				}
			};

			// Add the keyboard handler
			document.addEventListener("keydown", (window as any).previewKeyHandler);
		}

		fileInput.addEventListener("change", () => {
			handleFileChange(fileInput.files);
		});

		document
			.getElementById("updateValues")
			.addEventListener("click", (e) => {
				updateValuesList.set([]);
				currentValuesList.set([]);
				updateValuesModal.set(false);
				console.log("UpdateValues clicked");
			});

		document
