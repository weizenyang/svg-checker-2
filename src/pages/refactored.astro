		function renderCSVContents(contents: string) {
			const lines = contents.trim().split("\n");
			const firstLineFields = lines[0].split(",");
			let transformedLines = lines;
			let scaleToFit = false;

			if (firstLineFields.length > 3) {
				transformedLines = lines.map((line) => {
					if (!line || line.trim() === "") return "";
					const fields = line.split(",");
					const [name, x, y, z] = fields;
					const cleanedName = `${name.split("_")[0]}~${name.split("_")[1]}`;
					scaleToFit = true;
					return `${cleanedName},${-y},${-x},${name}`;
				}).filter(line => line !== "");
			}

			const gInstance = document.createElementNS("http://www.w3.org/2000/svg", "g");
			gInstance.setAttribute("id", "g-instance");
			const svgContainer = document.getElementById("svg-container");

			if (svgContainer?.querySelector("svg")) {
				svgContainer.querySelector("svg")?.querySelectorAll("#g-instance").forEach((g) => {
					g.remove();
				});
			} else {
				const newSVG = createNewSVG();
				newSVG.appendChild(gInstance);
				svgContainer?.appendChild(newSVG);

				const tempImage = svgContainer?.querySelector("img:not(#svg-empty-state img)");
				if (tempImage) {
					const svgimg = document.createElementNS("http://www.w3.org/2000/svg", "image");
					svgimg.style.width = "100%";
					svgimg.style.height = "100%";
					svgimg.setAttributeNS("http://www.w3.org/1999/xlink", "xlink:href", (tempImage as HTMLImageElement).src);
					const newSvgEl = svgContainer?.querySelector("svg");
					newSvgEl?.append(svgimg);
					tempImage.remove();
				}
			}

			svgContainer?.querySelector("svg")?.appendChild(gInstance);

			const isProjectCSV = lines[0] && lines[0].toLowerCase().includes('position_x_meters');
			if (isProjectCSV) {
				console.log('Project CSV detected - processing as Project CSV');
				renderProjectCsvPreview(contents);
				return;
			}

			globalFloors = [];
			globalFloorsAggregated = [];

			for (let i = 0; i < transformedLines.length; i++) {
				const fields = transformedLines[i].split(",");
				if (Number(fields[1]) || Number(fields[2])) {
					const floor = fields[0].includes("~") ? fields[0].split("~")[0] : null;
					const name = fields[0].includes("~") ? fields[0].split("~")[1] : fields[0];
					const data = [];
					data.push({ field: "data-csv-row", value: String(i) });
					if (floor) {
						data.push({ field: "data-floor", value: floor });
					}
					if (fields[3]) {
						data.push({ field: "data-fullname", value: fields[3] });
					}
					globalFloors.push({
						floor: floor,
						circle: spawnCircle(
							name,
							Number(fields[flipYX ? 2 : 1]).toFixed(4),
							Number(fields[flipYX ? 1 : 2]).toFixed(4),
							data,
						),
					});
				} else if (i > 0 && fields[0] && fields[0].toLowerCase() !== "name") {
					console.error(`${fields[0] ? fields[0] : `(Nameless), Row ${i + 1}`} does not contain any cx, cy data`);
				}
			}

			var floorNumbers = [];
			const labelDivInstance = document.getElementById("labelDiv");
			if (labelDivInstance) labelDivInstance.remove();
			globalFloors.forEach((e) => {
				if (!floorNumbers.includes(e.floor)) floorNumbers.push(e.floor);
			});

			const floorSection = document.getElementById("show-floors");
			floorSection?.querySelectorAll("div").forEach((e) => e.remove());

			if (floorNumbers.length > 0) {
				if (floorSection?.classList.contains("hidden")) floorSection.classList.remove("hidden");
				checkboxesId = [];
				floorNumbers.forEach((e) => {
					const div = document.createElement("div");
					const checkbox = document.createElement("input");
					const label = document.createElement("label");
					label.innerText = `Floor ${e}`;
					label.htmlFor = `floor-${e}-checkbox`;
					checkbox.type = "checkbox";
					checkbox.checked = true;
					checkbox.id = `floor-${e}-checkbox`;
					checkboxesId.push(`floor-${e}-checkbox`);
					div.appendChild(checkbox);
					div.appendChild(label);
					checkbox.addEventListener("change", () => {
						toggleFloors(aggregatePoints);
						spawnLabel();
					});
					floorSection?.appendChild(div);
				});
			}

			const globalFloorsCopy = Object.assign(globalFloors);
			globalFloorsAggregated = getAveragedCircles(globalFloorsCopy);

			if (document.getElementById("aggregate-points-parent")) {
				document.getElementById("aggregate-points-parent")?.remove();
			}
			const editOptions = document.getElementById("edit-options");
			const div = document.createElement("div");
			div.id = "aggregate-points-parent";
			const aggregateOptionsCheckbox = document.createElement("input");
			const label = document.createElement("label");
			div.classList.add("col-span-2");
			div.classList.add("mt-2");
			label.innerText = `Aggregate points`;
			label.classList.add("ml-1");
			label.htmlFor = `aggregate-points`;
			aggregateOptionsCheckbox.type = "checkbox";
			aggregateOptionsCheckbox.checked = true;
			aggregateOptionsCheckbox.id = `aggregate-points`;
			div.appendChild(aggregateOptionsCheckbox);
			div.appendChild(label);
			editOptions?.appendChild(div);

			aggregatePoints = true;
			toggleFloors(aggregatePoints);
			spawnLabel();

			aggregateOptionsCheckbox.addEventListener("change", (e) => {
				aggregatePoints = (e.target as HTMLInputElement).checked;
				toggleFloors(aggregatePoints);
				spawnLabel();
			});

			if (scaleToFit) {
				scaleToFitSVG();
			}
		}

		function csvMediaMatchScore(csvName: string, targetName: string): number {
			const cBase = getBaseName(csvName);
			const tBase = getBaseName(targetName);
			if (cBase && cBase === tBase) return 4;
			const cKey = unitMatchKey(csvName);
			const tKey = unitMatchKey(targetName);
			if (cKey && tKey && cKey === tKey) return 3;
			const cTok = hyphenUnitToken(cKey);
			const tTok = hyphenUnitToken(tKey);
			if (cTok && tTok && cTok === tTok) return 2;
			const c2 = lastUnderscoreSegments(cBase, 2);
			const t2 = lastUnderscoreSegments(tBase, 2);
			if (c2 && c2 === t2 && !isGenericSceneSuffix(c2)) return 1;
			return 0;
		}

		function selectBestMatchingCSV() {
			if (importedCSVs.length === 0) return;
			if (_syncingMedia) return;
			const currentSvg = importedSVGs[currentSVGIndex];
			if (!currentSvg) return;

			let bestIdx = 0;
			let bestScore = 0;
			importedCSVs.forEach((csvObj, idx) => {
				const score = csvMediaMatchScore(csvObj.name, currentSvg.name);
				if (score > bestScore) {
					bestScore = score;
					bestIdx = idx;
				}
			});
			if (bestScore > 0 && bestIdx !== currentCSVIndex) {
				_syncingMedia = true;
				currentCSVIndex = bestIdx;
				applySelectedCSV();
				updateCSVNavigationUI();
				_syncingMedia = false;
			}
		}

		function selectBestMatchingCSVForImage(imageName: string) {
			if (importedCSVs.length === 0) return;
			if (_syncingMedia) return;
			if (!imageName) return;

			let bestIdx = 0;
			let bestScore = 0;
			importedCSVs.forEach((csvObj, idx) => {
				const score = csvMediaMatchScore(csvObj.name, imageName);
				if (score > bestScore) {
					bestScore = score;
					bestIdx = idx;
				}
			});
			if (bestScore > 0 && bestIdx !== currentCSVIndex) {
				_syncingMedia = true;
				currentCSVIndex = bestIdx;
				applySelectedCSV();
				updateCSVNavigationUI();
				_syncingMedia = false;
			}
		}

		function syncSVGAndBackplateToCSV() {
			if (_syncingMedia) return;
			if (importedCSVs.length === 0) return;
			const csvObj = importedCSVs[currentCSVIndex];
			if (!csvObj) return;

			_syncingMedia = true;

			let bestSvgIdx = currentSVGIndex;
			let bestSvgScore = 0;
			importedSVGs.forEach((svgObj, idx) => {
				const score = csvMediaMatchScore(csvObj.name, svgObj.name);
				if (score > bestSvgScore) {
					bestSvgScore = score;
					bestSvgIdx = idx;
				}
			});

			if (bestSvgScore > 0 && bestSvgIdx !== currentSVGIndex) {
				currentSVGIndex = bestSvgIdx;
				processSVG(importedSVGs[currentSVGIndex].element);
				updateSVGNavigationUI();
			}

			let bestImgName: string | null = null;
			let bestImgScore = 0;
			imageList.forEach((imgObj) => {
				const score = csvMediaMatchScore(csvObj.name, imgObj.name);
				if (score > bestImgScore) {
					bestImgScore = score;
					bestImgName = imgObj.name;
				}
			});

			if (bestImgScore > 0 && bestImgName && bestImgName !== currentHoveredImageName) {
				currentHoveredImageName = bestImgName;
			}

			_syncingMedia = false;
		}

		function processMultipleCsvFiles(csvFiles: File[]) {
			if (!csvFiles || csvFiles.length === 0) return;

			importedCSVs = [];
			currentCSVIndex = 0;

			let filesProcessed = 0;
			const tempCsvData: { name: string, file: File, contents: string, matchScore: number }[] = [];

			csvFiles.forEach((csvFile) => {
				const reader = new FileReader();
				reader.onload = (event) => {
					const contents = event.target?.result as string;
					const csvName = getBaseName(csvFile.name);

					let matchScore = 0;
					importedSVGs.forEach((svgObj) => {
						matchScore = Math.max(matchScore, csvMediaMatchScore(csvName, svgObj.name));
					});
					imageList.forEach((imgObj) => {
						matchScore = Math.max(matchScore, csvMediaMatchScore(csvName, imgObj.name));
					});

					tempCsvData.push({
						name: csvName,
						file: csvFile,
						contents: contents,
						matchScore: matchScore
					});

					filesProcessed++;
					if (filesProcessed === csvFiles.length) {
						tempCsvData.sort((a, b) => b.matchScore - a.matchScore);
						importedCSVs = tempCsvData;

						if (importedCSVs.length > 0) {
							currentCSVIndex = 0;
							applySelectedCSV();
							spawnCSVNavigation();
							syncSVGAndBackplateToCSV();
						}
					}
				};
				reader.readAsText(csvFile);
			});
		}

