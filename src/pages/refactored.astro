		</section>

		<dialog
			id="image-list-dialog"
			class="rounded-md border border-neutral-200 p-0 shadow-lg backdrop:bg-black/40 max-w-[min(90vw,42rem)] w-full"
		>
			<div class="flex items-center justify-between gap-2 px-3 py-2 border-b border-neutral-200 bg-neutral-50">
				<p class="text-sm font-medium">Image List</p>
				<button
