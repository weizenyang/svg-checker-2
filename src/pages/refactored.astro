		// Helper function to apply 180-degree offset when flip is true and rotation is 90/-90
		function applyFlipRotationOffset(rotation, flip) {
			// Convert flip to boolean
			const flipBool = typeof flip === 'boolean' ? flip : (flip === 'true' || flip === true);
			
			// Apply 180-degree offset if flip is true and rotation is 90 or -90
			if (flipBool && (rotation === 90 || rotation === -90)) {
				rotation = rotation + 180;
				// Normalize rotation to -90 to 180 degrees after offset
				while (rotation < -90) rotation += 360;
				while (rotation > 180) rotation -= 360;
			}
			return rotation;
		}

		// Export unit-reference handler
		document.getElementById("export-unit-reference-button").addEventListener("click", () => {
			if (!importedUnitReference || importedUnitReference.length === 0) {
				console.log("No imported unit-reference data to export. Please upload a unit-reference file first.");
				return;
			}
			
			// Merge imported data with current transform values
			const mergedData = importedUnitReference.map((unit: any) => {
				const unitName = unit.name || "";
				const identifier = getUnitIdentifier(unitName);
				
				// Get imported rotation
				let importedRotation = typeof unit.rotation === 'string' ? parseInt(unit.rotation) : unit.rotation;
				
				// Find matching transform by identifier
				const transform = identifier && imageTransformLookup[identifier] ? imageTransformLookup[identifier] : null;
				
				// Calculate final rotation: importedRotation + change (if transform exists)
				let rotation = importedRotation;
				let flip = unit.flip;
				
			if (transform) {
				// Final rotation = importedRotation + change
				const rotationChange = transform.rotation || 0;
				rotation = importedRotation + rotationChange;
				
				// Normalize rotation to -90 to 180 degrees
				while (rotation < -90) rotation += 360;
				while (rotation > 180) rotation -= 360;
				
				// For flip: apply change relative to imported (XOR logic)
				// transform.flip represents whether user has toggled it (change)
				const importedFlipBool = typeof unit.flip === 'string' ? unit.flip === 'true' : unit.flip;
				flip = importedFlipBool !== transform.flip; // XOR: final = imported XOR change
			} else {
				// Use imported values as-is
				if (typeof rotation === 'string') {
					rotation = parseInt(rotation);
				}
				// Normalize rotation even if no transform
				while (rotation < -90) rotation += 360;
				while (rotation > 180) rotation -= 360;
			}
			
			// Apply 180-degree offset if flip is true and rotation is 90/-90
			rotation = applyFlipRotationOffset(rotation, flip);
				
				// Convert flip to string format ("true" or "false")
				const flipString = typeof flip === 'boolean' ? flip.toString() : (flip === 'true' || flip === true ? 'true' : 'false');
				
				return {
					name: unit.name,
					type: unit.type,
					flip: flipString,
					rotation: rotation
				};
			});
			
			// Wrap merged data in units key
			const exportData = {
				units: mergedData
			};
			
			// Create and download JSON file
			const jsonString = JSON.stringify(exportData, null, 2);
			const blob = new Blob([jsonString], { type: "application/json" });
			const url = URL.createObjectURL(blob);
			const a = document.createElement("a");
			a.href = url;
			a.download = "unit-reference.json";
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
			URL.revokeObjectURL(url);
			
			console.log("Exported unit-reference:", exportData);
			console.log(`Successfully exported ${mergedData.length} unit(s)`);
		});

		document.getElementById("batch-opencv-button").addEventListener("click", async () => {
			const btn = document.getElementById("batch-opencv-button");
			const progressContainer = document.getElementById("batch-opencv-progress");
			const progressBar = document.getElementById("batch-opencv-progress-bar");
			const progressText = document.getElementById("batch-opencv-progress-text");
			const svgsToProcess = importedSVGs?.length > 0
				? importedSVGs.map((s) => s.element)
				: (() => { const el = document.querySelector("#svg-container svg"); return el ? [el] : []; })();
			if (svgsToProcess.length === 0 || imageList.length === 0) {
				showToast("Load SVG and floorplan images first", "warning");
				return;
			}
			btn.disabled = true;
			btn.textContent = "Processing...";
			if (progressContainer && progressBar && progressText) {
				progressContainer.classList.remove("hidden");
				progressBar.style.width = "0%";
				progressText.textContent = "0 / 0";
			}
			const results = [];
			let totalTasks = 0;
			let completedTasks = 0;
			// Pre-count total paths that have matching images so progress is accurate
			for (const svgEl of svgsToProcess) {
				const paths = svgEl.querySelectorAll("path");
				for (const pathEl of paths) {
					const pathId = pathEl.getAttribute("id") || pathEl.id;
					if (!pathId) continue;
					const img = findMatchingImage(pathId);
					if (!img?.data) continue;
					totalTasks++;
				}
			}
			const updateProgress = () => {
				if (!progressBar || !progressText || totalTasks === 0) return;
				const pct = Math.min(100, Math.round((completedTasks / totalTasks) * 100));
				progressBar.style.width = `${pct}%`;
				progressText.textContent = `${completedTasks} / ${totalTasks}`;
			};
			updateProgress();
			try {
				let batchCount = 0;
				for (const svgEl of svgsToProcess) {
					// Keep the viewer in sync: move to this SVG as if the user pressed "next"
					if (importedSVGs?.length > 0) {
						const idx = importedSVGs.findIndex((s) => s.element === svgEl);
						if (idx !== -1) {
							currentSVGIndex = idx;
							processSVG(importedSVGs[currentSVGIndex].element);
						}
					}
					const paths = svgEl.querySelectorAll("path");
					for (const pathEl of paths) {
						const pathId = pathEl.getAttribute("id") || pathEl.id;
						if (!pathId) continue;
						const img = findMatchingImage(pathId);
						if (!img?.data) continue;
						try {
							const r = await runFloorplanComparisonOpencv(svgEl, pathEl, img.data, { includeIntermediates: false });
							completedTasks++;
							const correctOrientation = r.bestRotation === 0 && !r.bestOrbFlipped;
							results.push({
								name: pathId,
								orb: r.orb,
								contour: r.contour,
								bestRotation: r.bestRotation,
								bestFlip: r.bestOrbFlipped ? "Flip" : "",
								correct_orientation: correctOrientation
							});
						} catch (err) {
							console.warn(`Batch OpenCV failed for ${pathId}:`, err);
							results.push({
								name: pathId,
								orb: "",
								contour: "",
								bestRotation: "",
								bestFlip: "",
								correct_orientation: false
							});
							completedTasks++;
						}
						updateProgress();

						// Yield every few paths to keep UI responsive
						batchCount++;
						if (batchCount % 10 === 0) {
							await new Promise((resolve) => setTimeout(resolve, 0));
						}
					}
				}
				results.sort((a, b) => String(a.name).localeCompare(String(b.name)));
				const headers = ["name", "orb", "contour", "bestRotation", "bestFlip", "correct_orientation"];
				const escapeCsv = (v) => {
					const s = String(v);
					return s.includes(",") || s.includes('"') || s.includes("\n") ? `"${s.replace(/"/g, '""')}"` : s;
				};
				const rows = [headers.map(escapeCsv).join(",")];
				for (const r of results) {
					rows.push(headers.map((h) => escapeCsv(r[h])).join(","));
				}
				const csv = rows.join("\n");
				const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
				const url = URL.createObjectURL(blob);
				const a = document.createElement("a");
				a.href = url;

				// Derive CSV name from common prefix of loaded SVGs
				let baseName = "batch-opencv";
				if (Array.isArray(importedSVGs) && importedSVGs.length > 0) {
					const names = importedSVGs
						.map((s) => s.name || "")
						.filter(Boolean)
						.map((n) => n.replace(/\.svg$/i, ""));
					if (names.length > 0) {
						let prefix = names[0];
						for (let i = 1; i < names.length; i++) {
							const cur = names[i];
							let j = 0;
							while (j < prefix.length && j < cur.length && prefix[j] === cur[j]) j++;
							prefix = prefix.slice(0, j);
							if (!prefix) break;
						}
						if (prefix && prefix.length > 2) baseName = prefix;
					}
				}

				a.download = `${baseName || "batch-opencv"}-opencv-${new Date().toISOString().slice(0, 10)}.csv`;
				document.body.appendChild(a);
				a.click();
				document.body.removeChild(a);
				URL.revokeObjectURL(url);
				showToast(`Exported ${results.length} results`, "success");
			} catch (err) {
				console.error("Batch OpenCV error:", err);
				showToast(err instanceof Error ? err.message : "Batch OpenCV failed", "error");
			} finally {
				btn.disabled = false;
				btn.textContent = "Batch OpenCV";
				if (progressContainer) {
					progressContainer.classList.add("hidden");
				}
			}
		});

		document.getElementById("clear-images").addEventListener("click", () => {
			// 1. empty the array that the previewer uses
			imageList.splice(0, imageList.length);

