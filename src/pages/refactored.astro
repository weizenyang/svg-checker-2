		// SC-ROUND-1: Compute fillet geometry for a corner
		// Returns { t1x, t1y, t2x, t2y, cx, cy, r, sweep } or null if not applicable
		function computeFilletGeometry(vertices, vertexIdx, requestedRadius) {
			if (requestedRadius <= 0) return null;
			
			const v = vertices[vertexIdx];
			const prev = vertices[vertexIdx - 1];
			let next = vertices[vertexIdx + 1];
			
			if (!v || !prev) return null;
			
			// Determine the "prev" point for the incoming edge
			let prevX, prevY;
			if (prev.cmd === 'M') {
				// First vertex after M in a closed path - incoming edge comes from last vertex before Z
				let lastBeforeZ = null;
				for (let i = vertices.length - 1; i >= 0; i--) {
					if (vertices[i].cmd === 'Z') continue;
					if (vertices[i].cmd !== 'M') {
						lastBeforeZ = vertices[i];
						break;
					}
				}
				if (lastBeforeZ) {
					prevX = lastBeforeZ.x;
					prevY = lastBeforeZ.y;
				} else {
					return null;
				}
			} else {
				prevX = prev.x;
				prevY = prev.y;
			}
			
			// Handle closing corner (last vertex before Z)
			let nextX, nextY;
			if (next && next.cmd === 'Z') {
				// Find the first vertex after M (the closing target)
				const firstAfterM = vertices.find((vv, i) => i > 0 && vv.cmd !== 'M' && vv.cmd !== 'Z');
				if (firstAfterM) {
					nextX = firstAfterM.x;
					nextY = firstAfterM.y;
				} else {
					return null;
				}
			} else if (next) {
				nextX = next.x;
				nextY = next.y;
			} else {
				return null;
			}
			
			// Compute vectors from vertex to prev and next
			const dx1 = prevX - v.x;
			const dy1 = prevY - v.y;
			const dx2 = nextX - v.x;
			const dy2 = nextY - v.y;
			
			const len1 = Math.sqrt(dx1 * dx1 + dy1 * dy1);
			const len2 = Math.sqrt(dx2 * dx2 + dy2 * dy2);
			
			if (len1 < 0.001 || len2 < 0.001) return null;
			
			// Normalize direction vectors
			const ux1 = dx1 / len1;
			const uy1 = dy1 / len1;
			const ux2 = dx2 / len2;
			const uy2 = dy2 / len2;
			
			// Compute angle between edges
			const dot = ux1 * ux2 + uy1 * uy2;
			const cross = ux1 * uy2 - uy1 * ux2;
			const angle = Math.acos(Math.max(-1, Math.min(1, dot)));
			
			// For very small angles (nearly straight) or very large angles (nearly 180°), skip
			if (angle < 0.01 || angle > Math.PI - 0.01) return null;
			
			// Compute max radius that fits both edges (tangent point can't go past midpoint)
			const maxRadius = Math.min(len1, len2) * Math.tan(angle / 2);
			const r = Math.min(requestedRadius, maxRadius * 0.99); // Small margin to avoid edge issues
			
			if (r <= 0.001) return null;
			
			// Distance from vertex to tangent point
			const tangentDist = r / Math.tan(angle / 2);
			
			// Tangent points
			const t1x = v.x + ux1 * tangentDist;
			const t1y = v.y + uy1 * tangentDist;
			const t2x = v.x + ux2 * tangentDist;
			const t2y = v.y + uy2 * tangentDist;
			
			// Determine sweep direction based on cross product
			const sweep = cross > 0 ? 0 : 1;
			
			return { t1x, t1y, t2x, t2y, r, sweep };
		}

		function rebuildPathD(vertices, originalD) {
			if (!vertices.length) return originalD;
			
