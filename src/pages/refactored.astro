		document.getElementById("batch-shape-bench-button")?.addEventListener("click", async () => {
			const btn = document.getElementById("batch-shape-bench-button") as HTMLButtonElement | null;
			const progressContainer = document.getElementById("batch-shape-bench-progress");
			const progressBar = document.getElementById("batch-shape-bench-progress-bar");
			const progressText = document.getElementById("batch-shape-bench-progress-text");
			const svgsToProcess =
				importedSVGs?.length > 0
					? importedSVGs.map((s) => s.element)
					: (() => {
							const el = document.querySelector("#svg-container svg");
							return el ? [el] : [];
						})();
			if (svgsToProcess.length === 0) {
				showToast("Load an SVG first", "warning");
				return;
			}
			if (shapeBenchmarkCandidates.length === 0) {
				showToast("Load benchmark images via the Silhouette button", "warning");
				return;
			}
			let totalTasks = 0;
			for (const svgEl of svgsToProcess) {
				for (const pathEl of svgEl.querySelectorAll("path")) {
					const pathId = pathEl.getAttribute("id") || pathEl.id;
					if (pathId) totalTasks++;
				}
			}
			if (totalTasks === 0) {
				showToast("No paths with an id attribute in the loaded SVG(s)", "warning");
				return;
			}
			if (!btn) return;
			btn.disabled = true;
			const prevBtnText = btn.textContent;
			btn.textContent = "Processing…";
			if (progressContainer && progressBar && progressText) {
				progressContainer.classList.remove("hidden");
				progressBar.style.width = "0%";
				progressText.textContent = "0 / 0";
				progressText.removeAttribute("title");
			}
			const escapeCsv = (v: unknown) => {
				const s = String(v ?? "");
				return s.includes(",") || s.includes('"') || s.includes("\n")
					? `"${s.replace(/"/g, '""')}"`
					: s;
			};
			/** @type {Record<string, string>[]} */
			const csvRecords = [];
			let completedTasks = 0;
			const updateProgress = (detail?: string) => {
				if (!progressBar || !progressText || totalTasks === 0) return;
				const pct = Math.min(100, Math.round((completedTasks / totalTasks) * 100));
				progressBar.style.width = `${pct}%`;
				progressText.textContent = `${completedTasks} / ${totalTasks}`;
				if (detail) progressText.setAttribute("title", detail);
				else progressText.removeAttribute("title");
			};
			updateProgress();
			try {
				const rawList = shapeBenchmarkCandidates.map((c) => ({ name: c.name, data: c.data }));
				const { kept, dropped, originalCount } =
					await dedupeBenchmarkCandidatesByIdenticalContent(rawList);
				if (kept.length === 0) {
					showToast("No benchmark images left after deduplication", "warning");
					return;
				}
				let batchCount = 0;
				for (const svgEl of svgsToProcess) {
					const svgMeta = importedSVGs?.find((s) => s.element === svgEl);
					const svgFile = svgMeta?.name || "current.svg";
					if (importedSVGs?.length > 0) {
						const idx = importedSVGs.findIndex((s) => s.element === svgEl);
						if (idx !== -1) {
							currentSVGIndex = idx;
							processSVG(importedSVGs[currentSVGIndex].element);
						}
					}
					const paths = svgEl.querySelectorAll("path");
					for (const pathEl of paths) {
						const pathId = pathEl.getAttribute("id") || pathEl.id;
						if (!pathId) continue;
						updateProgress(pathId);
						try {
							const {
								candidates: keptForPath,
								ruleMatched: unitRuleMatched,
								typeStr: unitTypeStr,
							} = applyUnitReferenceCandidateFilter(pathId, kept);
							if (unitRuleMatched && keptForPath.length === 0) {
								csvRecords.push({
									svg_file: svgFile,
									path_id: pathId,
									benchmark_image: "",
									rank_in_path: "",
									score_pct: "",
									iou_pct: "",
									chamfer_pct: "",
									chf_mean_px: "",
									chf_std_px: "",
									chf_blend: "",
									chf_d0_frac: "",
									chf_exp: "",
									chf_sigma_w: "",
									chf_amp: "",
									best_pose: "",
									status: "unit_filter_no_candidates",
									detail: unitTypeStr ? `type ${unitTypeStr}` : "",
								});
								completedTasks++;
								updateProgress(pathId);
								continue;
							}
							const result = await runSilhouetteBenchmarkBatch(svgEl, pathEl, keptForPath, {
								logTimings: false,
								shapeBenchFlashPreprocessSteps: false,
								silhouetteVisualFirstN: 0,
								onProgress: () => {},
								onPartialResult: (snap) => {
									const handled = snap.candidatesHandled ?? snap.rows.length;
									if (snap.rankedCarousel.length > 0) {
										setSilhouetteBenchRankForPath(pathId, snap.rankedCarousel, {
											featureColumnLabel: "Score",
											scored: handled,
											total: keptForPath.length,
										}, svgEl);
									}
								},
							});
							if (result.rankedCarousel.length > 0) {
								setSilhouetteBenchRankForPath(pathId, result.rankedCarousel, {
									featureColumnLabel: "Score",
									scored: result.rows.length,
									total: keptForPath.length,
								}, svgEl);
							}
							const sortedRows = [...result.rows].sort(shapeBenchCompareRowsForRank);
							sortedRows.forEach((row, i) => {
								csvRecords.push({
									svg_file: svgFile,
									path_id: pathId,
									benchmark_image: row.name,
									rank_in_path: String(i + 1),
									score_pct: String(row.rankScore ?? ""),
									iou_pct: String(row.silhouetteIou ?? ""),
									chamfer_pct: String(row.silhouetteChamfer ?? ""),
									chf_mean_px: String(row.silhouetteChamferMeanPx ?? ""),
									chf_std_px: String(row.silhouetteChamferStdPx ?? ""),
									chf_blend: String(row.chamferBlend ?? ""),
									chf_d0_frac: String(row.chamferDiagFrac ?? ""),
									chf_exp: String(row.chamferExponent ?? ""),
									chf_sigma_w: String(row.chamferVarWeight ?? ""),
									chf_amp: String(row.chamferDistAmplify ?? ""),
									best_pose: String(row.bestPoseLabel ?? ""),
									status: "ok",
									detail: "",
								});
							});
							for (const f of result.filteredOut || []) {
								csvRecords.push({
									svg_file: svgFile,
									path_id: pathId,
									benchmark_image: f.name,
									rank_in_path: "",
									score_pct: "",
									iou_pct: "",
									chamfer_pct: "",
									chf_mean_px: "",
									chf_std_px: "",
									chf_blend: "",
									chf_d0_frac: "",
									chf_exp: "",
									chf_sigma_w: "",
									chf_amp: "",
									best_pose: "",
									status: "aspect_filtered",
									detail: f.reason || "",
								});
							}
						} catch (err) {
							console.warn(`Batch Silhouette bench failed for ${pathId}:`, err);
							const msg = err instanceof Error ? err.message : String(err);
							csvRecords.push({
								svg_file: svgFile,
								path_id: pathId,
								benchmark_image: "",
								rank_in_path: "",
								score_pct: "",
								iou_pct: "",
								chamfer_pct: "",
								chf_mean_px: "",
								chf_std_px: "",
								chf_blend: "",
								chf_d0_frac: "",
								chf_exp: "",
								chf_sigma_w: "",
								chf_amp: "",
								best_pose: "",
								status: "error",
								detail: msg,
							});
						}
						completedTasks++;
						updateProgress(pathId);
						batchCount++;
						if (batchCount % 10 === 0) {
							await new Promise((resolve) => setTimeout(resolve, 0));
						}
					}
				}
				const headers = [
					"svg_file",
					"path_id",
					"benchmark_image",
					"rank_in_path",
					"score_pct",
					"iou_pct",
					"chamfer_pct",
					"chf_mean_px",
					"chf_std_px",
					"chf_blend",
					"chf_d0_frac",
					"chf_exp",
					"chf_sigma_w",
					"chf_amp",
					"best_pose",
					"status",
					"detail",
				];
				csvRecords.sort((a, b) => {
					const s = a.svg_file.localeCompare(b.svg_file);
					if (s !== 0) return s;
					const p = a.path_id.localeCompare(b.path_id);
					if (p !== 0) return p;
					const st = a.status.localeCompare(b.status);
					if (st !== 0) return st;
					return a.benchmark_image.localeCompare(b.benchmark_image);
				});
				const rows = [headers.map((h) => escapeCsv(h)).join(",")];
				for (const r of csvRecords) {
					rows.push(headers.map((h) => escapeCsv(r[h])).join(","));
				}
				const csv = rows.join("\n");
				const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
				const url = URL.createObjectURL(blob);
				const a = document.createElement("a");
				a.href = url;
				let baseName = "batch-silhouette-bench";
				if (Array.isArray(importedSVGs) && importedSVGs.length > 0) {
					const names = importedSVGs
						.map((s) => s.name || "")
						.filter(Boolean)
						.map((n) => n.replace(/\.svg$/i, ""));
					if (names.length > 0) {
						let prefix = names[0];
						for (let i = 1; i < names.length; i++) {
							const cur = names[i];
							let j = 0;
							while (j < prefix.length && j < cur.length && prefix[j] === cur[j]) j++;
							prefix = prefix.slice(0, j);
							if (!prefix) break;
						}
						if (prefix && prefix.length > 2) baseName = prefix;
					}
				}
				a.download = `${baseName || "batch-silhouette-bench"}-silhouette-bench-${new Date().toISOString().slice(0, 10)}.csv`;
				document.body.appendChild(a);
				a.click();
				document.body.removeChild(a);
				URL.revokeObjectURL(url);
				const dedupeNote =
					dropped.length > 0 ? ` (${kept.length} unique benchmark images from ${originalCount})` : "";
				showToast(`Exported ${csvRecords.length} row(s) for ${totalTasks} path(s)${dedupeNote}`, "success");
			} catch (err) {
				console.error("Batch Silhouette bench error:", err);
				showToast(err instanceof Error ? err.message : "Batch Silhouette bench failed", "error");
			} finally {
				btn.disabled = false;
				btn.textContent = prevBtnText || "Batch Silhouette bench";
				if (progressContainer) progressContainer.classList.add("hidden");
			}
		});

