				if (!toggleTarget && (target.closest('#selection-ui') || target.getAttribute?.('data-bbox-interior') === 'true')) {
					toggleTarget = getSelectablePathAtPoint(svgPt);
				}
				
				if (toggleTarget) {
					e.preventDefault();
