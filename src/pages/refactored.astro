				const v1 = pathEditVertices[edgeDragIndex];
				const v2 = pathEditVertices[edgeDragIndex + 1];
				
				if (v1 && v1.cmd !== 'Z') {
					v1.x += dx;
					v1.y += dy;
				}
				if (v2 && v2.cmd !== 'Z') {
