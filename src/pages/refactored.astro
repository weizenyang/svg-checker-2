						const globalAggregateCircle =
							globalFloorsAggregated.map((item) => item.circle);
						const totalCircles = [
							...globalCircle,
							...globalAggregateCircle,
						];
						scaleBoundingBoxToFitInstance(
							svgContainer.querySelector("svg"),
							totalCircles,
						);
					}
					requestAnimationFrame(() => applyCsvPathCollisions());
					// scaleBoundingBoxToFit(svgContainer.querySelector("svg"));

					// Add single CSV to importedCSVs for carousel tracking
					importedCSVs = [{
						name: getBaseName(file.name),
						file: file,
						contents: contents,
						matchScore: 0
					}];
					currentCSVIndex = 0;
					updateCSVNavigationUI();
				};
				reader.readAsText(file);

				labelToggle();

				//Lord will spite me for this method
				setTimeout((e) => {
					spawnLabel();
				}, 50);
			}
			}


