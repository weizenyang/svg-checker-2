		/**
		 * @param {{ pathId: string, rows: any[] }} result
		 * @param {{ statusLine?: string, tableMode?: "silhouette" }} [extra] - non-empty while benchmark is in progress
		 */
		function renderShapeBenchmarkTable(result, extra = {}) {
			const wrap = document.getElementById("shape-benchmark-results");
			if (!wrap) return;
			const statusLine = extra.statusLine;
			const hasSilDetail = result.rows.some((r) => typeof r.silhouetteIou === "number");
			/** Batch-level Chamfer metric knobs (same on every row; shown once, not as redundant columns). */
			const chamferTuningRow = result.rows.find(
				(r) => typeof r.chamferBlend === "number" && !Number.isNaN(r.chamferBlend),
			);
			/** Per-image Chamfer geometry: lower is better; do not use max-based row highlight. */
			const chamferPerImageMetricKeys = new Set([
				"silhouetteChamferMeanPx",
				"silhouetteChamferStdPx",
			]);
			const formatSilhouetteTableCell = (key: string, v: unknown) => {
				if (v === undefined || v === null) return "";
				if (
					chamferPerImageMetricKeys.has(key) &&
					typeof v === "number" &&
					!Number.isNaN(v)
				) {
					return v.toFixed(2);
				}
				return v as string | number;
			};
			const cols = hasSilDetail
				? [
						{ key: "rankScore", label: "Score %" },
						{ key: "silhouetteIou", label: "IoU %" },
						{ key: "silhouetteChamfer", label: "Chamfer %" },
						{ key: "silhouetteChamferMeanPx", label: "Chf μ px" },
						{ key: "silhouetteChamferStdPx", label: "Chf σ px" },
						{ key: "bestPoseLabel", label: "Best pose" },
					]
				: [
						{ key: "rankScore", label: "IoU %" },
						{ key: "bestPoseLabel", label: "Best pose" },
					];
			const colCount = 1 + cols.length;
			const sortedRows = [...result.rows].sort((a, b) => {
				if (b.rankScore !== a.rankScore) return b.rankScore - a.rankScore;
				if (hasSilDetail) {
					if ((b.silhouetteIou ?? 0) !== (a.silhouetteIou ?? 0))
						return (b.silhouetteIou ?? 0) - (a.silhouetteIou ?? 0);
					if ((b.silhouetteChamfer ?? 0) !== (a.silhouetteChamfer ?? 0))
						return (b.silhouetteChamfer ?? 0) - (a.silhouetteChamfer ?? 0);
				}
				if (b.orbMax8 !== a.orbMax8) return b.orbMax8 - a.orbMax8;
				if (b.contourMax8 !== a.contourMax8) return b.contourMax8 - a.contourMax8;
				if (b.legacySilhouette !== a.legacySilhouette) return b.legacySilhouette - a.legacySilhouette;
				if (b.contour0 !== a.contour0) return b.contour0 - a.contour0;
				return a.name.localeCompare(b.name);
			});
			const bests = {};
			for (const { key } of cols) {
				if (key === "bestPoseLabel" || chamferPerImageMetricKeys.has(key)) continue;
				const vals = sortedRows
					.map((r) => r[key])
					.filter((v) => typeof v === "number" && !Number.isNaN(v));
				bests[key] = vals.length ? Math.max(...vals) : 0;
			}
			const esc = (s) =>
				String(s)
					.replace(/&/g, "&amp;")
					.replace(/</g, "&lt;")
					.replace(/>/g, "&gt;")
					.replace(/"/g, "&quot;");
			let html = `<p class="p-2 text-xs font-medium border-b border-neutral-200 bg-neutral-50">Path: <code>${esc(result.pathId)}</code></p>`;
			const blendExplain = hasSilDetail
				? "Silhouette bench: best pose over four 90° rotations and mirrored floor. The floorplan mask is stretched (non-uniform) to fill the cutout comparison frame at each pose, then IoU and Chamfer run on that grid. Rank blends IoU with Chamfer on Euclidean edge distances: effective distance = mean + weight×spread (σ) on both masks, then amplified so small outline differences matter more (defaults in floorplan-comparison.js). Rows sorted by Score (best first)."
				: "Silhouette bench: max IoU over four 90° rotations; horizontal flip is tried only if the best unflipped IoU is below 70%. Rows sorted by IoU (best first). Highlighted = best IoU.";
			html += `<p class="px-2 py-1.5 text-[11px] text-neutral-600 border-b border-neutral-200 bg-white">${blendExplain}`;
			if (hasSilDetail && chamferTuningRow) {
				const b = chamferTuningRow.chamferBlend;
				const d0 = chamferTuningRow.chamferDiagFrac;
				const ex = chamferTuningRow.chamferExponent;
				const sw = chamferTuningRow.chamferVarWeight;
				const am = chamferTuningRow.chamferDistAmplify;
				const parts = [
					`Chf w ${typeof b === "number" && !Number.isNaN(b) ? b.toFixed(2) : "—"}`,
					`d₀ frac ${typeof d0 === "number" && !Number.isNaN(d0) ? d0.toFixed(3) : "—"}`,
					`exp ${typeof ex === "number" && !Number.isNaN(ex) ? ex.toFixed(3) : "—"}`,
					`σ w ${typeof sw === "number" && !Number.isNaN(sw) ? sw.toFixed(3) : "—"}`,
					`amp ${typeof am === "number" && !Number.isNaN(am) ? am.toFixed(3) : "—"}`,
				];
				html += `<p class="px-2 py-1 text-[11px] text-neutral-700 border-b border-neutral-200 bg-neutral-50/90 font-mono tabular-nums"><span class="font-sans font-semibold text-neutral-800 mr-1.5">Chamfer tuning</span>(same for all rows): ${esc(parts.join(" · "))}</p>`;
			}
			if (hasSilDetail) {
				html += `<p class="px-2 py-1 text-[10px] text-neutral-600 border-b border-neutral-200 bg-white">Chf μ px / Chf σ px: symmetric mean distance and spread of boundary samples (Euclidean DT) at comparison-grid resolution for each image&rsquo;s <strong>best pose</strong>; grid pixels, lower is tighter alignment.</p>`;
			}
			if (statusLine) {
				html +=
					' <span class="text-amber-900 font-medium">Live:</span> table re-sorts after each image finishes.</p>';
			} else {
				html += "</p>";
			}
			html += '<table class="w-full border-collapse text-left"><thead><tr class="border-b border-neutral-200 bg-neutral-50">';
			html += '<th class="p-1.5 sticky left-0 bg-neutral-50 z-10 max-w-[100px]">Rank · image</th>';
			for (const { label } of cols) {
				html += `<th class="p-1.5 whitespace-nowrap">${esc(label)}</th>`;
			}
			html += "</tr></thead><tbody>";
			sortedRows.forEach((row, i) => {
				html += "<tr class=\"border-b border-neutral-100 hover:bg-neutral-50/80\">";
				html += `<td class="p-1.5 sticky left-0 bg-white font-medium max-w-[100px] truncate" title="${esc(row.name)}"><span class="tabular-nums font-semibold text-amber-900">${i + 1}.</span> ${esc(row.name)}</td>`;
				for (const { key } of cols) {
					const v = row[key];
					const display = formatSilhouetteTableCell(key, v);
					const isBest =
						key !== "bestPoseLabel" &&
						!chamferPerImageMetricKeys.has(key) &&
						sortedRows.length > 1 &&
						v !== undefined &&
						v !== null &&
						typeof v === "number" &&
						v === bests[key];
					html += `<td class="p-1.5 tabular-nums ${isBest ? "bg-amber-100 font-semibold" : ""}">${display}</td>`;
				}
				html += "</tr>";
			});
			if (statusLine) {
				html += `<tr class="border-b border-amber-200 bg-amber-50/90"><td colspan="${colCount}" class="p-1.5 text-[11px] text-amber-950">${esc(statusLine)}</td></tr>`;
			}
			html += "</tbody></table>";

			const visualRows = sortedRows.filter((r) => r.silhouetteVisual);
			if (visualRows.length > 0) {
				html += `<div class="border-t border-amber-200/80 bg-white p-2">`;
				html += `<p class="text-xs font-semibold text-neutral-900 mb-1">How scores are derived (top ${visualRows.length} by table rank — best first, not load order)</p>`;
				html += `<p class="text-[11px] text-neutral-600 mb-3 leading-snug">Table <strong>Score</strong> blends fill IoU with boundary Chamfer on the same grid. Overlap viz uses filled binary silhouettes. <span class="text-amber-900 font-medium">Yellow</span> = intersection (both), <span class="text-blue-700 font-medium">blue</span> = cutout-only, <span class="text-red-700 font-medium">red</span> = floorplan-only. Fill IoU = intersection ÷ union.</p>`;
				sortedRows.forEach((row, rankIdx) => {
					if (!row.silhouetteVisual) return;
					const tableRank = rankIdx + 1;
					const v = row.silhouetteVisual;
					const pose = row.bestPoseLabel ? esc(String(row.bestPoseLabel)) : "";
					html += `<div class="mb-4 last:mb-0 pb-3 last:pb-0 border-b border-neutral-100 last:border-0">`;
					html += `<p class="text-xs font-medium text-neutral-800 mb-1"><span class="tabular-nums text-amber-900 font-semibold">#${tableRank}</span> ${esc(row.name)}${pose ? ` · ${pose}` : ""} — <span class="tabular-nums">${esc(String(row.rankScore))}%</span></p>`;
					html += `<p class="text-[11px] text-neutral-700 mb-2 font-mono tabular-nums">${esc(v.formula)}</p>`;
					html += `<div class="flex flex-wrap gap-3 items-end">`;
					html += `<div class="text-center max-w-[140px]"><img src="${v.cutoutMaskUrl}" alt="" class="mx-auto border border-neutral-200 rounded-sm bg-neutral-900 max-h-36 w-auto object-contain" style="image-rendering:pixelated"/><div class="text-[10px] text-neutral-500 mt-0.5">${esc(String(v.gridPx.w))}×${esc(String(v.gridPx.h))} · Cutout</div></div>`;
					html += `<div class="text-center max-w-[140px]"><img src="${v.floorMaskUrl}" alt="" class="mx-auto border border-neutral-200 rounded-sm bg-neutral-900 max-h-36 w-auto object-contain" style="image-rendering:pixelated"/><div class="text-[10px] text-neutral-500 mt-0.5">Floorplan (pose)</div></div>`;
					html += `<div class="text-center max-w-[140px]"><img src="${v.overlapUrl}" alt="" class="mx-auto border border-neutral-200 rounded-sm max-h-36 w-auto object-contain" style="image-rendering:pixelated"/><div class="text-[10px] text-neutral-500 mt-0.5">Overlap</div></div>`;
					html += `</div></div>`;
				});
				html += `</div>`;
			}

			wrap.innerHTML = html;
			wrap.classList.remove("hidden");
		}

		/** Ranked benchmark images: best first. Same preview container as floorplan hover; refreshes in place during live Shape bench. */
		function showShapeBenchmarkRankCarousel(
			items: Array<{
				rank: number;
				name: string;
				data: string;
				rankScore: number;
				orbProduction: number;
				orbMax8: number;
				contourMax8: number;
				legacySilhouette: number;
				bestPoseLabel?: string;
				silhouetteVisual?: {
					gridPx: { w: number; h: number };
					formula: string;
					cutoutMaskUrl: string;
					floorMaskUrl: string;
					overlapUrl: string;
				};
			}>,
			opts?: { pathId?: string; scored?: number; total?: number; featureColumnLabel?: string },
		) {
			if (!items.length) return;
			const pathId = opts?.pathId ?? "unknown";
			const featureColumnLabel = opts?.featureColumnLabel ?? "IoU";
			const pendingLine =
				opts?.scored != null && opts?.total != null && opts.scored < opts.total
					? `Benchmark: ${opts.scored} / ${opts.total} scored (live ranking)`
					: "";

			previewPinned = true;
			const container = document.getElementById("image-previewer-container");
			const previewImg = document.getElementById("image-previewer-image") as HTMLImageElement;
			const previewText = document.getElementById("image-previewer-text");
			if (!container || !previewImg || !previewText) return;
			container.style.display = "block";

			const compareBtnEl = document.getElementById("compare-floorplan-btn");
			const compareOpencvBtnEl = document.getElementById("compare-opencv-btn");
			const compareShapeBenchBtnEl = document.getElementById("compare-shape-bench-btn");

			const runUpdate = () => {
				const c = shapeBenchRankCarouselUI;
				if (!c) return;
				const it = c.items[c.index];
				if (!it) return;
				const extra = c.pendingLine ? `\n${c.pendingLine}` : "";
				const featLbl = c.featureColumnLabel ?? "IoU";
				if (it.bestPoseLabel) {
					const silExtra =
						typeof it.silhouetteIou === "number" && typeof it.silhouetteChamfer === "number"
							? `\nIoU ${it.silhouetteIou}% · Chamfer ${it.silhouetteChamfer}%${
