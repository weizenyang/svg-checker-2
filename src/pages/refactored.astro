				const v = pathEditVertices[vertexDragIndex];
				v.x += dx;
				v.y += dy;
			}
			
			vertexDragStartX += dx;
			vertexDragStartY += dy;
			multiHandleDragStartX += dx;
			multiHandleDragStartY += dy;
			
			applyVertexChanges();
		}

		function handleEdgeDrag(svgPt, shiftHeld) {
