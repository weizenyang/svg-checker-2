		const processSVG = (svgElement) => {
			convertShapesToPaths(svgElement);
			const list = Array.from(svgElement.querySelectorAll(`[id]`)).filter(
				(el) => el !== svgElement && !el.closest("#g-instance"),
			);
			svgElement.setAttribute("data-csv-editor", "svg");
			document.getElementById("id-list").innerHTML = "";

			const processIdList = (idFormat) => {
				const regexLastUnderscore = /_(?=[^_]*$)/g;
				const regexLastDash = /-(?=[^-]*$)/g;
				const regexDashUnderscore = /\w+-\w+_\w+/;
				const regexText = /^[^-]*/;
				const regexGroupName = /^([A-Z]{2}\d{2}-\d{1,2})/;
				const regexUnitNumber = /(\d{1,3})\D*$/;

				const handleId = (currentId) => {
					const listItem = document.createElement("li");

					const regexResult =
						idFormat === format.fullUnderscore
							? currentId.replaceAll("-", "_")
							: !regexDashUnderscore.test(currentId)
								? currentId.replace(regexLastDash, "_")
								: currentId;

					const selected = svgElement.getElementById(`${currentId}`);
					if (!selected) return;
					const groupMatched = selected.id.match(regexGroupName);
					const unitMatched = selected.id.match(regexUnitNumber);

					if (groupMatched) {
						selected.setAttribute(
							"group-attribute",
							groupMatched[1],
						);
					}

					if (unitMatched) {
						selected.setAttribute("unit-attribute", unitMatched[1]);
					}

					selected.id = regexResult;
					listItem.innerHTML = regexResult;
					clusterId.push({
						id: object3dCount,
						clusterId: regexText.exec(regexResult)[0],
						unitId: regexResult,
					});

					object3dCount++;
					listItem.style.listStyle = "none";
					listItem.style.padding = "0.5em 0em";
					document.getElementById("id-list").append(listItem);
				};

				list.forEach((i) => {
					const currentId = i.id;

					if (idFormat === format.underscore) {
						handleId(currentId);
					} else if (idFormat === format.dash) {
						handleId(
							regexDashUnderscore.test(currentId)
								? currentId.replace(regexLastUnderscore, "-")
								: currentId,
						);
					} else if (
						idFormat === format.none ||
						idFormat === format.fullUnderscore
					) {
						handleId(currentId);
					}
				});
			};

			processIdList(idFormat);

			// Append the SVG element to the div element
			const svgContainer = document.getElementById("svg-container");
			lastShapeBenchRankCarousel = null;
			shapeBenchCarouselDismissedPathId = null;
			if (silBenchHoverPanelRefreshTimer != null) {
				clearTimeout(silBenchHoverPanelRefreshTimer);
				silBenchHoverPanelRefreshTimer = null;
			}
			destroyShapeBenchRankCarouselUI();
			previewPinned = false;
			currentHoveredPathElement = null;
			currentHoveredImageName = null;
			const hoverPreviewHost = document.getElementById("image-previewer-container");
			if (hoverPreviewHost) {
				hoverPreviewHost.style.display = "none";
				hoverPreviewHost
					.querySelectorAll("[data-compare-carousel], [data-benchmark-rank-carousel]")
					.forEach((el) => el.remove());
			}
			const hoverPreviewImg = document.getElementById("image-previewer-image") as HTMLImageElement | null;
			if (hoverPreviewImg) {
				hoverPreviewImg.src = "";
				hoverPreviewImg.style.display = "";
			}
			const hoverPreviewText = document.getElementById("image-previewer-text");
			if (hoverPreviewText) {
				hoverPreviewText.style.display = "";
				hoverPreviewText.replaceChildren();
			}
			const hcb = document.getElementById("compare-floorplan-btn");
			const hcob = document.getElementById("compare-opencv-btn");
			const hcsb = document.getElementById("compare-shape-bench-btn");
			if (hcb) hcb.style.display = "";
			if (hcob) hcob.style.display = "";
			if (hcsb) hcsb.style.display = "";
			const hscores = document.getElementById("compare-floorplan-scores");
			if (hscores) hscores.textContent = "";
			svgContainer.innerHTML = "";
			// Ensure container has overflow hidden to prevent going out of bounds
			svgContainer.style.overflow = 'hidden';
			svgElement.setAttributeNS(null, "width", "100%");
			svgElement.setAttributeNS(null, "height", "100%");
			svgContainer.appendChild(svgElement);

			// Setup context menu for the SVG
			setupSVGContextMenu(svgElement);

			console.log(imageList.length)

			const svgInContainer = document.getElementById("svg-container")?.querySelector("svg");
			if (svgInContainer) {
				previewBackplate(svgInContainer);
			}

			// Set type for export filename
			type =
				idFormat === format.underscore
					? "underscore"
					: idFormat === format.dash
						? "dash"
						: "";

			updateSVGNavigationUI();
			requestAnimationFrame(() => applyCsvPathCollisions());
		};

		function getBaseName(fileName) {
			return String(fileName || "")
				.replace(/\.[^/.]+$/, "")
				.toLowerCase();
		}

		function unitMatchKey(fileName) {
			return getBaseName(fileName)
				.replace(/^backplate_image_floorplan_/, "")
				.replace(/^backplate_image_tower-floorplate_/, "")
				.replace(/^backplate_image_camera_/, "")
				.replace(/^backplate_image_/, "")
				.replace(/^csv_floorplan_/, "")
				.replace(/^csv_camera_/, "")
				.replace(/_export$/i, "")
				.replace(/_s\d+_\d+$/i, "")
				.replace(/_s\d+$/i, "");
		}

		function lastUnderscoreSegments(base, n) {
			const parts = String(base || "")
				.toLowerCase()
				.split("_")
				.filter(Boolean);
			if (parts.length === 0) return "";
			if (parts.length < n) return parts.join("_");
			return parts.slice(-n).join("_");
		}

		function isGenericSceneSuffix(seg) {
			return /^s\d+_\d+$/i.test(String(seg || ""));
		}

		function hyphenUnitToken(key) {
			const m = String(key || "").match(/[a-z][a-z0-9]*-\d+-\d+/i);
			return m ? m[0].toLowerCase() : "";
		}

		function isUnitPlateFileName(fileName) {
			const key = unitMatchKey(fileName);
			return /^[a-z][a-z0-9]*-\d+-\d+$/i.test(key);
		}

		function svgMediaMatchScore(svgName, mediaName) {
			const sBase = getBaseName(svgName);
			const mBase = getBaseName(mediaName);
			if (sBase && sBase === mBase) return 4;
			const sKey = unitMatchKey(svgName);
			const mKey = unitMatchKey(mediaName);
			if (sKey && mKey && sKey === mKey) return 3;
			const sTok = hyphenUnitToken(sKey);
			const mTok = hyphenUnitToken(mKey);
			if (sTok && mTok && sTok === mTok) return 2;
			const s2 = lastUnderscoreSegments(sBase, 2);
			const m2 = lastUnderscoreSegments(mBase, 2);
			if (s2 && s2 === m2 && !isGenericSceneSuffix(s2)) return 1;
			return 0;
		}

		function findMatchedSvgObjects(mediaName, svgObjs) {
			const list = svgObjs || [];
			let best = 0;
			const hits = [];
			list.forEach((svgObj) => {
				const score = svgMediaMatchScore(svgObj.name, mediaName);
				if (score > best) {
					best = score;
					hits.length = 0;
				}
				if (score > 0 && score === best) hits.push(svgObj);
			});
			return hits;
		}

		function shouldSkipDropDirectory(name) {
			const n = String(name || "").toLowerCase();
			return n === "transparent" || n === "_ss" || (n.startsWith("_") && n !== "svgs");
		}

		async function filesFromDataTransfer(dataTransfer) {
			if (!dataTransfer) return [];
			const walkEntry = async (entry) => {
				if (!entry) return [];
				if (entry.isFile) {
					const file = await new Promise((resolve, reject) =>
						entry.file(resolve, reject),
					);
					return file ? [file] : [];
				}
				if (entry.isDirectory) {
					if (shouldSkipDropDirectory(entry.name)) return [];
					const reader = entry.createReader();
					const collected = [];
					const readAll = async () => {
						const batch = await new Promise((resolve, reject) =>
							reader.readEntries(resolve, reject),
						);
						if (!batch.length) return;
						collected.push(...batch);
						await readAll();
					};
					await readAll();
					const nested = [];
					for (const child of collected) {
						nested.push(...(await walkEntry(child)));
					}
					return nested;
				}
				return [];
			};

			const items = dataTransfer.items;
			const entries = [];
			if (items && items.length) {
				for (let i = 0; i < items.length; i++) {
					const item = items[i];
					const entry =
						typeof item.webkitGetAsEntry === "function"
							? item.webkitGetAsEntry()
							: null;
					if (entry) entries.push(entry);
				}
			}
			if (entries.length) {
				const out = [];
				for (const entry of entries) {
					out.push(...(await walkEntry(entry)));
				}
				if (out.length) return out;
			}
			return Array.from(dataTransfer.files || []);
		}

		function handleDraggedImages(files) {
			const mediaFiles = Array.from(files).filter((file) =>
				isRasterOrVideoFile(file),
			);
			if (mediaFiles.length === 0) return;

			mediaFiles.forEach((mediaFile) => {
				const reader = new FileReader();
				const isVideo =
					String(mediaFile.type || "").startsWith("video/") ||
					/\.(mp4|webm|ogg)$/i.test(mediaFile.name || "");
				reader.onload = (event) => {
					const contents = event.target.result;
					const matchedSvgs = findMatchedSvgObjects(
						mediaFile.name,
						importedSVGs,
					);
					console.log(
						isVideo ? "Video File" : "Image File",
						mediaFile.name,
						"->",
						matchedSvgs.map((s) => s.name),
					);

					if (!isVideo && !imageList.some((img) => img.name === mediaFile.name)) {
						imageList.push({ name: mediaFile.name, data: contents as string });
					}

					const applyToMatchedSvgs = () => {
					matchedSvgs.forEach((svgObj) => {
							const svgElement = svgObj.element;
							const viewBox = svgElement.getAttribute("viewBox").split(" ");
							
							// Remove any existing background media (images, videos, foreignObject) before adding new one
							const existingImages = svgElement.querySelectorAll("image");
							existingImages.forEach(img => {
								// Only remove images that appear to be background images (full size)
								const imgWidth = img.getAttribute("width");
								const imgHeight = img.getAttribute("height");
								
								if (imgWidth === viewBox[2] && imgHeight === viewBox[3]) {
									img.remove();
									console.log("Removed existing background image from SVG");
								}
							});
							
							// Remove existing foreignObject elements (videos)
							const existingForeignObjects = svgElement.querySelectorAll("foreignObject");
							existingForeignObjects.forEach(fo => {
								const foWidth = fo.getAttribute("width");
								const foHeight = fo.getAttribute("height");
								if (foWidth === viewBox[2] && foHeight === viewBox[3]) {
									fo.remove();
									console.log("Removed existing background video from SVG");
								}
							});
							
							if (isVideo) {
								// Create a <foreignObject> to contain HTML video element
								const foreignObject = document.createElementNS(
									"http://www.w3.org/2000/svg",
									"foreignObject",
								);
								foreignObject.setAttributeNS(null, "x", "0");
								foreignObject.setAttributeNS(null, "y", "0");
								foreignObject.setAttributeNS(null, "width", viewBox[2]);
								foreignObject.setAttributeNS(null, "height", viewBox[3]);
								
								// Create video element
								const video = document.createElement("video");
								video.src = contents;
								video.style.width = "100%";
								video.style.height = "100%";
								video.style.objectFit = "cover";
								video.setAttribute("loop", "");
								video.setAttribute("muted", "");
								video.setAttribute("autoplay", "");
								video.setAttribute("playsinline", "");
								
								foreignObject.appendChild(video);
								console.log("Adding new background video to SVG");
								svgElement.insertBefore(foreignObject, svgElement.firstChild);
							} else {
								// Keep existing viewBox (4096×4096); CSV coords are authored in that space.
								// Stretch the bitmap to fill — do not resize viewBox to naturalWidth.
								const nw = Number(viewBox[2]) || 4096;
								const nh = Number(viewBox[3]) || 4096;
								const svgImage = document.createElementNS(
									"http://www.w3.org/2000/svg",
									"image",
								);
								svgImage.setAttributeNS(null, "href", contents);
								svgImage.setAttributeNS(null, "x", "0");
								svgImage.setAttributeNS(null, "y", "0");
								svgImage.setAttributeNS(null, "width", String(nw));
								svgImage.setAttributeNS(null, "height", String(nh));
								svgImage.setAttributeNS(
									null,
									"preserveAspectRatio",
									"none",
								);
								svgImage.setAttributeNS(null, "data-original-filename", mediaFile.name || "");
								console.log("Adding new background image to SVG");
								svgElement.insertBefore(svgImage, svgElement.firstChild);
							}
					});
					};

					applyToMatchedSvgs();
				};
				reader.readAsDataURL(mediaFile);
			});
		}

		function handleFileChange(files, opts) {
			let fileArr;
			if (!files) {
				fileArr = [];
			} else if (Array.isArray(files)) {
				fileArr = files;
			} else if (files instanceof FileList) {
				fileArr = Array.from(files);
			} else {
				fileArr = [files];
			}
			let pendingCsvFollowUp = null;
			if (opts && opts.pendingCsvs) {
				pendingCsvFollowUp = opts.pendingCsvs;
			} else if (opts && opts.pendingCsv) {
				pendingCsvFollowUp = [opts.pendingCsv];
			}

			// Mixed drop: load SVG / raster first, then CSVs so points land on the mounted canvas
			if (!pendingCsvFollowUp && fileArr.length >= 2) {
				const csvFiles = fileArr.filter(
					(f) => isCsvFile(f) && !/^automation_/i.test(f.name || ""),
				);
				const rest = fileArr.filter((f) => !csvFiles.includes(f));
				if (csvFiles.length > 0 && rest.length > 0) {
					handleFileChange(rest, { pendingCsvs: csvFiles });
					return;
				}
			}

			console.log(fileArr);
			const file = fileArr[0];
			let filesToProcess = fileArr.filter((f) => isSvgFile(f));
			const isRasterMedia =
				filesToProcess.length === 0 && isRasterOrVideoFile(file);

			// Only reset global states when not importing a raster media (image/video)
			if (!isRasterMedia) {
				flipped = false;
				object3dCount = 0;
				globalFloors = [];
				globalFloorsAggregated = [];
				canvasFlipX = false;
				canvasFlipY = false;
				canvasRotate = 0;
			}
			// if(!document.getElementById("image-list-container").classList.contains("hidden")){
			// 	document.getElementById("image-list-container").classList.add("hidden")
			// }

			// if (files.length === 1) {
			// 	importedSVGs = [];
			// 	currentSVGIndex = 0;
			// 	globalSvgContainer.innerHTML = "";
			// }
			// importedSVGs = []; // Reset the array

			// if (filesToProcess.length === 0) {
			// 	alert("Please import valid SVG files.");
			// 	return;
			// }

			// Only reset UI/toggles when not importing a raster media (jpeg/png/webp/video)
			if (!isRasterMedia) {
				updateResetButtons();

				// Refresh show floors section
				const floorSection = document.getElementById("show-floors");
				floorSection.querySelectorAll("div").forEach((e) => {
					e.remove();
				});
				if (!floorSection.classList.contains("hidden")) {
					floorSection.classList.add("hidden");
				}

				if (document.getElementById("showLabelsDiv")) {
					document.getElementById("showLabelsDiv").remove();
				}
			}
			console.log(fileArr.length)
			if(fileArr.length > 1){
				
				if (filesToProcess.length > 0) {
					if(document.getElementById("image-list-container").classList.contains("hidden")){
						document.getElementById("image-list-container").classList.remove("hidden")
					}
					importedSVGs = [];
					currentSVGIndex = 0;
					globalSvgContainer.innerHTML = "";
				filesToProcess.forEach((fileToProcess, index) => {
					const reader = new FileReader();
					reader.onload = () => {
						const svgString = reader.result;
						const parser = new DOMParser();
						const svgDoc = parser.parseFromString(
							svgString,
							"image/svg+xml",
						);
						// For each file, we assume the root element is the SVG element
						const svgElement = svgDoc.documentElement;
						// Store both lowercased name (for matching) and original basename (for export)
						const originalBasename = String(fileToProcess.name || "").replace(/\.[^/.]+$/, "");
						importedSVGs.push({ name: getBaseName(fileToProcess.name), originalName: originalBasename, element: svgElement });

						// Once all SVGs have been processed, show the first one and spawn navigation
						if (importedSVGs.length === filesToProcess.length) {
							currentSVGIndex = 0;
							processSVG(importedSVGs[currentSVGIndex].element);
							spawnSVGNavigation();
							handleDraggedImages(fileArr.filter((f) => isRasterOrVideoFile(f)));
							if (pendingCsvFollowUp && pendingCsvFollowUp.length > 0) {
								_pendingCsvFilesForReScore = pendingCsvFollowUp;
							}
							loadFloorplanFilesToImageList(fileArr);
						}
					};
					reader.readAsText(fileToProcess);
				});
			} else if (isRasterOrVideoFile(file)) {
				handleDraggedImages(fileArr)
				if (pendingCsvFollowUp && pendingCsvFollowUp.length > 0) {
					setTimeout(() => processMultipleCsvFiles(pendingCsvFollowUp), 100);
				}
			} else if (isCsvFile(file)) {
				const allCsvs = fileArr.filter((f) => isCsvFile(f) && !/^automation_/i.test(f.name || ""));
				if (allCsvs.length > 0) {
					processMultipleCsvFiles(allCsvs);
				}
			}
			} else {
				if (isSvgFile(file)) {
					if(document.getElementById("image-list-container").classList.contains("hidden")){
						document.getElementById("image-list-container").classList.remove("hidden")
					}
					    importedSVGs = [];
					currentSVGIndex = 0;
					globalSvgContainer.innerHTML = "";

				filesToProcess.forEach((fileToProcess, index) => {
					const reader = new FileReader();
					reader.onload = () => {
						const svgString = reader.result;
						const parser = new DOMParser();
						const svgDoc = parser.parseFromString(
							svgString,
							"image/svg+xml",
						);
						// For each file, we assume the root element is the SVG element
						const svgElement = svgDoc.documentElement;
						// Store both lowercased name (for matching) and original basename (for export)
						const originalBasename = String(fileToProcess.name || "").replace(/\.[^/.]+$/, "");
						importedSVGs.push({ name: getBaseName(fileToProcess.name), originalName: originalBasename, element: svgElement });

						// Once all files have been processed, show the first one and spawn navigation
						if (importedSVGs.length === filesToProcess.length) {
							currentSVGIndex = 0;
							processSVG(importedSVGs[currentSVGIndex].element);
							spawnSVGNavigation();
							// Auto-load backplate_image_floorplan images from the selection into Check Floorplans
							if (pendingCsvFollowUp && pendingCsvFollowUp.length > 0) {
								_pendingCsvFilesForReScore = pendingCsvFollowUp;
							}
							loadFloorplanFilesToImageList(fileArr);
						}
					};
					reader.readAsText(fileToProcess);
				});
			} else if (isRasterOrVideoFile(file)) {
				if (importedSVGs.length > 0) {
					handleDraggedImages(fileArr);
					if (pendingCsvFollowUp && pendingCsvFollowUp.length > 0) {
						processMultipleCsvFiles(pendingCsvFollowUp);
					}
				} else {
				const isVideo =
					String(file.type || "").startsWith("video/") ||
					/\.(mp4|webm|ogg)$/i.test(file.name || "");
				fileNameGlobal = file.name
					.replace("backplate_image_camera", "csv_floorplan")
					.replace("backplate_image_floorplan", "csv_floorplan")
					.replace("camera", "floorplan");
				document.getElementById("export-file-name").value =
					fileNameGlobal;
				const reader = new FileReader();
				reader.onload = (event) => {
					const contents = event.target.result;
					const svgContainer =
						document.getElementById("svg-container");
					// Use any existing SVG (including one created by CSV import). Do not clear container if found.
					var internalSVG = svgContainer.querySelector("svg");

					if (!internalSVG) {
						// No SVG yet; create a new one
						const newSVG = createNewSVG();
						svgContainer.appendChild(newSVG);
						internalSVG = newSVG;
					}

					const svgViewbox = internalSVG.getAttribute("viewBox").split(" ");

					// Remove any existing background images before adding new one
					const existingImages = internalSVG.querySelectorAll("image");
					existingImages.forEach(img => {
						// Only remove images that appear to be background images (full size)
						const imgWidth = img.getAttribute("width");
						const imgHeight = img.getAttribute("height");
						
						if (imgWidth === svgViewbox[2] && imgHeight === svgViewbox[3]) {
							img.remove();
							console.log("Removed existing background image");
						}
					});

					// Remove existing foreignObject elements (videos)
					const existingForeignObjects = internalSVG.querySelectorAll("foreignObject");
					existingForeignObjects.forEach(fo => {
						const foWidth = fo.getAttribute("width");
						const foHeight = fo.getAttribute("height");
						if (foWidth === svgViewbox[2] && foHeight === svgViewbox[3]) {
							fo.remove();
							console.log("Removed existing background video");
						}
					});

					if (isVideo) {
						// Create a <foreignObject> to contain HTML video element
						const foreignObject = document.createElementNS(
							"http://www.w3.org/2000/svg",
							"foreignObject",
						);
						foreignObject.setAttributeNS(null, "x", "0");
						foreignObject.setAttributeNS(null, "y", "0");
						foreignObject.setAttributeNS(null, "width", svgViewbox[2]);
						foreignObject.setAttributeNS(null, "height", svgViewbox[3]);
						
						// Create video element
						const video = document.createElement("video");
						video.src = contents;
						video.style.width = "100%";
						video.style.height = "100%";
						video.style.objectFit = "cover";
						video.setAttribute("loop", "");
						video.setAttribute("muted", "");
						video.setAttribute("autoplay", "");
						video.setAttribute("playsinline", "");
						
						foreignObject.appendChild(video);
						console.log("Adding new background video");
						internalSVG.insertBefore(foreignObject, internalSVG.firstChild);
					} else {
						// Default <image> preserveAspectRatio is xMidYMid meet, which letterboxes
						// inside width×height while CSV coords use the full viewBox — markers look
						// shifted (often upward). Fill the existing viewBox; never resize it to
						// naturalWidth (e.g. 4320) — production coords are always 4096-space.
						const vbW = Number(svgViewbox[2]) || 4096;
						const vbH = Number(svgViewbox[3]) || 4096;
						const svgImage = document.createElementNS(
							"http://www.w3.org/2000/svg",
							"image",
						);
						svgImage.setAttributeNS(null, "href", contents);
						svgImage.setAttributeNS(null, "x", "0");
						svgImage.setAttributeNS(null, "y", "0");
						svgImage.setAttributeNS(null, "width", String(vbW));
						svgImage.setAttributeNS(null, "height", String(vbH));
						svgImage.setAttributeNS(
							null,
							"preserveAspectRatio",
							"none",
						);
						svgImage.setAttributeNS(
							null,
							"data-original-filename",
							file.name || "",
						);
						console.log("Adding new background image");
						internalSVG.insertBefore(svgImage, internalSVG.firstChild);
					}
					if (pendingCsvFollowUp && pendingCsvFollowUp.length > 0) {
						processMultipleCsvFiles(pendingCsvFollowUp);
					}
				};
				reader.readAsDataURL(file);
				}
			} else if (isCsvFile(file)) {
				if (
					document
						.getElementById("svg-container")
						.getElementsByTagName("p").length > 0
				) {
					Array.from(
						document
							.getElementById("svg-container")
							.getElementsByTagName("p"),
					).forEach((e) => {
						e.remove();
					});
				}

				fileNameGlobal = file.name
					.replace("backplate_image_camera", "csv_floorplan")
					.replace("backplate_image_floorplan", "csv_floorplan")
					.replace("camera", "floorplan");

				document.getElementById("export-file-name").value =
					fileNameGlobal;
				const reader = new FileReader();
				reader.onload = (event) => {
					const contents = event.target.result;
					const lines = contents.trim().split("\n");

					// Check the number of columns and decide to transform
					const firstLineFields = lines[0].split(",");
					let transformedLines = lines;
					let scaleToFit = false;
					//column > 3
					if (firstLineFields.length > 3) {
						// Transform the data if more than three columns
						transformedLines = lines.map((line) => {
						if (!line || line.trim() === "") return ""; // Skip empty lines
							const fields = line.split(",");

							const [name, x, y, z] = fields;
							const cleanedName = `${name.split("_")[0]}~${name.split("_")[1]}`; //Curly line for easier text separation
							scaleToFit = true;

							return `${cleanedName},${-y},${-x},${name}`; // Swap x and y
					}).filter(line => line !== ""); // Remove empty lines
					}

					var gInstance = document.createElementNS(
						"http://www.w3.org/2000/svg",
						"g",
					); //Create group to contain all points
					gInstance.setAttribute("id", "g-instance");
					const svgContainer =
						document.getElementById("svg-container");

					if (svgContainer.querySelector("svg")) {
						// Keep tower path groups; only replace previous point layer
						svgContainer
							.querySelector("svg")
							.querySelectorAll("#g-instance")
							.forEach((g) => {
								g.remove();
							});
					} else {
						const newSVG = createNewSVG();
						newSVG.appendChild(gInstance);
						svgContainer.appendChild(newSVG);

						const tempImage = svgContainer.querySelector("img:not(#svg-empty-state img)");
						if (tempImage) {
							const svgimg = document.createElementNS(
								"http://www.w3.org/2000/svg",
								"image",
							);
							svgimg.style.width = "100%";
							svgimg.style.height = "100%";
							svgimg.setAttributeNS(
								"http://www.w3.org/1999/xlink",
								"xlink:href",
								tempImage.src,
							);
							newSVG.append(svgimg);
							tempImage.remove();
						}
					}

					svgContainer.querySelector("svg").appendChild(gInstance); //Add g into the svg

					// Check if this is a project CSV (has Position_X_Meters header)
					const isProjectCSV = lines[0] && lines[0].toLowerCase().includes('position_x_meters');
					
					if (isProjectCSV) {
						console.log('Project CSV detected - processing as Project CSV');
						renderProjectCsvPreview(contents);
						return; // Skip simple CSV processing
					}

					//Floors
					for (let i = 0; i < transformedLines.length; i++) {
						const fields = transformedLines[i].split(",");

						if (Number(fields[1]) || Number(fields[2])) {
							const floor = fields[0].includes("~")
								? fields[0].split("~")[0]
								: null;
							const name = fields[0].includes("~")
								? fields[0].split("~")[1]
								: fields[0];

							const data = [];
