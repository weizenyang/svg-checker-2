			vertexDragIndex = idx;
			vertexDragStartX = svgPt.x;
			vertexDragStartY = svgPt.y;
			// SC-SEL-3: Start axis lock gesture tracking
			startAxisLockGesture(svgPt.x, svgPt.y);
		}

		function startEdgeDrag(handle, svgPt, isCtrlOrCmd) {
