		const imageList = [];
		/** @type {{ name: string, data: string }[]} */
		const shapeBenchmarkCandidates = [];

		/** @type {{ name: string, type: string }[] | null} Loaded unit reference (optional silhouette candidate filter). */
		let unitReferenceFilterUnits: { name: string; type: string }[] | null = null;

		function normalizeUnitReferencePathKey(s: string): string {
			return s.trim().toLowerCase().replace(/-/g, "_");
		}

		/**
		 * Longest JSON `name` wins (shortest is guaranteed contained in path id; longest is most specific).
		 * @returns `type` string or null if no JSON / no row matches this path id.
		 */
		function findUnitTypeForPathId(pathId: string): string | null {
			if (!unitReferenceFilterUnits?.length) return null;
			const p = normalizeUnitReferencePathKey(pathId);
			let best: { name: string; type: string } | null = null;
			let bestLen = -1;
			for (const u of unitReferenceFilterUnits) {
				const n = normalizeUnitReferencePathKey(u.name);
				if (!n || n.length >= p.length) continue;
				if (!p.includes(n)) continue;
				if (n.length > bestLen) {
					bestLen = n.length;
					best = u;
				}
			}
			return best?.type ?? null;
		}

		/**
		 * Silhouette benchmark image filter from unit `type` (underscore-separated).
		 * - Image basename tokens: 6th (1-based) must equal type 3rd; 7th’s first char must equal type 4th’s first char.
		 * - If type 4th ends with `m` (mirror line), 7th must start with same first letter and end with `m`.
		 */
		function benchmarkImagePassesUnitType(imageFileName: string, typeStr: string): boolean {
			const base = imageFileName.replace(/\.[^.]+$/i, "");
			const imgParts = base.split("_");
			if (imgParts.length < 7) return false;
			const typeParts = typeStr.split("_").filter((t) => t.length);
			if (typeParts.length < 4) return false;
			const type3 = typeParts[2];
			const type4 = typeParts[3];
			const img6 = imgParts[5];
			const img7 = imgParts[6];
			if (img6 !== type3) return false;
			if (!type4.length || !img7.length) return false;
			if (type4[0].toLowerCase() !== img7[0].toLowerCase()) return false;
			const lastType4 = type4[type4.length - 1].toLowerCase();
			if (lastType4 === "m") {
				if (img7[img7.length - 1].toLowerCase() !== "m") return false;
			}
			return true;
		}

		/**
		 * @returns Filtered list and whether a unit rule applied (path matched JSON `name`).
		 */
		function applyUnitReferenceCandidateFilter(
			pathId: string,
			kept: { name: string; data: string }[],
		): { candidates: { name: string; data: string }[]; ruleMatched: boolean; typeStr: string | null } {
			const typeStr = findUnitTypeForPathId(pathId);
			if (typeStr == null) {
				return { candidates: kept, ruleMatched: false, typeStr: null };
			}
			const candidates = kept.filter((c) => benchmarkImagePassesUnitType(c.name, typeStr));
			return { candidates, ruleMatched: true, typeStr };
		}

