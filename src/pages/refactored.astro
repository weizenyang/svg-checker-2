				} else if (v.cmd === 'L') {
					newD += `L ${v.x} ${v.y} `;
				} else if (v.cmd === 'H') {
					newD += `L ${v.x} ${v.y} `;
				} else if (v.cmd === 'V') {
					newD += `L ${v.x} ${v.y} `;
