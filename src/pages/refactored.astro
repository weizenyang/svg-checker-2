			if (isNaN(idx) || idx < 0 || idx >= pathEditVertices.length) return;
			
			const v = pathEditVertices[idx];
			if (!v) return;
			
			filletDragActive = true;
			filletDragIndex = idx;
			filletDragStartX = svgPt.x;
			filletDragStartY = svgPt.y;
