---
import UpdateValuesModal from "../components/UpdateValuesModal.astro";
import Tutorial from "../components/Tutorial.astro";
import "../styles.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
		<link rel="stylesheet" href="/fonts/poppins.css" />
		<style>
			/* Floor toggle drag styles */
			[data-project-floor] {
				transition: background-color 0.15s ease !important;
			}

			[data-project-floor]:hover {
				background-color: rgba(255, 255, 255, 0.1) !important;
			}

			[data-project-floor].dragging {
				background-color: rgba(0, 150, 255, 0.3) !important;
			}

			/* Toast Notifications */
			.toast {
				position: fixed;
				bottom: 24px;
				right: 24px;
				padding: 16px 24px;
				background-color: #333;
				color: white;
				border-radius: 4px;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
				opacity: 0;
				transform: translateY(20px);
				transition: all 0.3s;
				pointer-events: none;
				max-width: 400px;
				z-index: 1000;
			}

			.toast.show {
				opacity: 1;
				transform: translateY(0);
				pointer-events: auto;
			}

			.toast.success {
				background-color: #28a745;
			}

			.toast.error {
				background-color: #dc3545;
			}

			.toast.warning {
				background-color: #ffc107;
				color: #000;
			}

			/* Paths without matching floorplan images — hover only */
			path.no-matching-floorplan:hover {
				fill: #ef4444 !important;
				fill-opacity: 0.6;
			}

			/* CSV point → path collision (editor only; stripped on SVG export) */
			path.csv-collision-single:hover {
				fill: #2563eb !important;
				fill-opacity: 0.55;
			}
			path.csv-collision-multi:hover {
				fill: #dc2626 !important;
				fill-opacity: 0.55;
			}
		</style>
	</head>
	<body class="">
		<div class="drag-drop-prompt">
			<div class="animated-border">
				<h1>Drag and Drop Here</h1>
			</div>
		</div>
		<UpdateValuesModal />
		<main class="toolsets" style="display: flex">
			<div class="toolset-section">
				<a
					href="/"
					class="flex w-fit items-center gap-1.5 px-2.5 py-1.5 mb-1 text-sm font-medium text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100 rounded-lg transition-colors"
				>
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
						<path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"></path>
					</svg>
					Home
				</a>
				<!-- <section class="container">
					<input
						class="dropdown"
						id="custom-formatting"
						name="formatting"
						type="checkbox"
						style="display: none"
					/>
					<label for="custom-formatting"
						>Custom SVG ID Formatting <span class="arrow">^</span
						></label
					>

					<div class="toggle">
						<div class="sub-item">
							<input
								type="radio"
								name="data-format"
								class="formatting"
								id="underscore"
								value="underscore"
							/>Underscore on Last Identifier (NHXX-XX<b>_</b>XX)
						</div>

						<div class="sub-item">
							<input
								type="radio"
								name="data-format"
								class="formatting"
								value="dash"
								id="dash"
							/>Dash on Last Identifier (NHXX-XX<b>-</b>XX)
						</div>
						<div class="sub-item">
							<input
								type="radio"
								name="data-format"
								class="formatting"
								value="none"
								id="none"
								checked="checked"
							/>None
						</div>
						<div class="sub-item">
							<input
								type="radio"
								name="data-format"
								class="formatting"
								value="fullUnderscore"
								id="fullUnderscore"
							/>Full Underscore
						</div>
					</div>
				</section> -->

				<section class="container">
					<p class="section-label">Files</p>
					<label for="myFile" class="button-style"
						>Import 						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="24"
							height="24"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path
								d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
								stroke-width="2"></path>
							<polyline points="17 8 12 3 7 8" stroke-width="2"
							></polyline>
							<line
								x1="12"
								x2="12"
								y1="3"
								y2="15"
								stroke-width="2"></line>
						</svg></label
					>
					<input
						type="file"
						class="input-style"
						id="myFile"
						name="filename"
						multiple
						style="display:none; "
					/>
					<label
						for="updateValues"
						class="flex items-center justify-center gap-1.5 bg-neutral-100 hover:bg-neutral-200 border border-neutral-200 rounded-md px-2.5 py-1.5 text-xs font-medium text-neutral-700 cursor-pointer transition-colors"
						>Update Names
						<svg
							class="ml-1"
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path
								d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
								stroke-width="2"></path>
							<polyline points="17 8 12 3 7 8" stroke-width="2"
							></polyline>
							<line
								x1="12"
								x2="12"
								y1="3"
								y2="15"
								stroke-width="2"></line>
						</svg></label
					>
					<input
						type="file"
						class="input-style"
						id="updateValues"
						name="filename"
						accept="text/csv"
						style="display:none"
					/>
				</section>

				<section class="container">
					<div class="sub-item hidden" id="show-floors">
						<p class="section-label">Floors</p>
					</div>
					<div id="edit-options" class="flex flex-col gap-1 empty:hidden"></div>

					<div class="sub-item">
						<p class="section-label">Naming</p>
						<input
							id="group"
							type="text"
							placeholder="Group"
							class="input-style"
						/>
						<input
							id="unit"
							type="text"
							placeholder="Unit"
							class="input-style"
						/>
						<div class="button-gap flex gap-1">
							<button class="w-full p-1.5" id="set-name">Set</button>
							<button class="w-full p-1.5" id="set-unit">Apply Units</button>
						</div>
					</div>

					<div class="sub-item">
						<p class="section-label">Label Properties</p>
						<input
							id="item-id"
							type="text"
							placeholder="ID"
							class="input-style"
						/>
						<div class="flex gap-1.5">
							<button class="w-full p-1.5 button-gap" id="set-id">Set</button>
							<button class="w-full p-1.5 button-gap" id="add-point">+ Point</button>
						</div>
						<button
							class="w-full flex items-center justify-center text-xs p-1.5 rounded-md bg-red-600 hover:bg-red-700 text-white font-medium transition-colors"
							id="delete-point">Delete</button>
					</div>
				</section>

				<section class="container">
					<div class="relative" id="export-menu-wrap">
						<button
							id="export-menu-trigger"
							class="button-style w-full"
							type="button"
							aria-expanded="false"
							aria-haspopup="true"
						>
							<span>Export</span>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="20"
								height="20"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="ml-2"
							>
								<path
									d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
									stroke-width="2"></path>
								<polyline points="7 10 12 15 17 10" stroke-width="2"
								></polyline>
								<line
									x1="12"
									x2="12"
									y1="15"
									y2="3"
									stroke-width="2"></line>
							</svg>
							<span class="ml-2 text-xs opacity-80" aria-hidden="true">▾</span>
						</button>
						<div
							id="export-menu"
							class="hidden flex-col gap-2 mt-2"
							role="menu"
						>
							<input
								type="text"
								placeholder="File Name"
								class="input-style"
								id="export-file-name"
							/>
							<button
								id="export"
								class="flex w-full items-center justify-center text-sm p-2 rounded bg-neutral-800 hover:bg-neutral-700 text-white"
								type="button"
							>
								Export SVG
								<span style="margin-left: 8px" class="boxed">4096px</span>
							</button>
							<button
								id="export-csv-layer"
								class="flex w-full items-center justify-center text-sm p-2 rounded bg-neutral-800 hover:bg-neutral-700 text-white"
								type="button"
							>
								Export CSV
								<span style="margin-left: 8px" class="boxed">4096px</span>
							</button>
							<div class="hidden">
								<input
									type="checkbox"
									id="yx-flip"
									name="yx-flip"
									value="true"
									checked
								/>
								<label for="yx-flip"> Y/X Flip</label>
							</div>
						</div>
					</div>
				</section>

				<Tutorial x="some data" id="tutorial" />

				<div class="container" id="id-container">
					<div class="id-list-title-container">
						<p class="id-list-title text-xs font-semibold text-neutral-600">Elements</p>
						<p class="hide-toggle" id="hide-toggle">^</p>
					</div>
					<ul class="id-list text-sm" id="id-list">
					</ul>
				</div>
			</div>
		</main>

		<section class="container editor grid">
			<div id="image-list-container" class="hidden flex-col">
				<div class="flex gap-1 items-stretch">
					<input
						type="text"
						placeholder="To Remove"
						id="text-replacement"
					/>
					<label
						for="check-floorplans-button"
						class="flex w-fit align-center text-center bg-neutral-100 hover:bg-neutral-300 p-1 pl-2 pr-2 rounded-sm text-sm self-center"
					>
						Check Floorplans
					</label>
					<input
						type="file"
						class="input-style"
						id="check-floorplans-button"
						accept="image/jpeg, image/png, image/webp, video/mp4, video/webm, video/ogg"
						name="filename"
						multiple
						style="display:none; "
					/>
					<button
						id="clear-images"
						class="flex align-center text-center bg-neutral-100 hover:bg-neutral-300 p-1 pl-2 pr-2 rounded-sm text-sm self-center"
						type="button"
					>
						Clear Images
					</button>

					<!-- Compact image-list window (opens dialog) -->
					<button
						type="button"
						id="image-list-window"
						title="View loaded images"
						class="ml-auto flex items-center gap-1.5 min-w-[7.5rem] max-w-[10rem] h-9 px-2 bg-neutral-100 hover:bg-neutral-200 border border-neutral-200 rounded-sm text-left"
					>
						<div
							id="image-list-window-preview"
							class="flex items-center gap-0.5 overflow-hidden flex-1 min-w-0 h-6"
						></div>
						<span
							id="image-list-window-count"
							class="shrink-0 text-[11px] text-neutral-600 font-medium"
						>0</span>
					</button>

					<!-- Compact silhouette benchmark button (opens dialog) -->
					<button
						type="button"
						id="shape-benchmark-toggle"
						aria-expanded="false"
						aria-controls="shape-benchmark-dialog"
						title="Silhouette benchmark"
						class="flex items-center gap-1.5 h-9 px-2 bg-amber-50 hover:bg-amber-100 border border-amber-200/70 rounded-sm text-xs font-medium text-amber-900 whitespace-nowrap"
					>
						<span>Silhouette</span>
						<span id="shape-benchmark-count" class="text-[11px] font-normal text-amber-800/80">0</span>
					</button>
				</div>

				<div class="flex gap-2 mt-2">
					<label
						for="upload-unit-reference-button"
						class="flex w-fit align-center text-center bg-neutral-100 hover:bg-neutral-300 p-1 pl-2 pr-2 rounded-sm text-sm self-end cursor-pointer"
					>
						Upload unit-reference
					</label>
					<input
						type="file"
						class="input-style"
						id="upload-unit-reference-button"
						accept=".json"
						name="unit-reference"
						style="display:none;"
					/>
					<button id="export-unit-reference-button"
						class="flex align-center text-center bg-neutral-100 hover:bg-neutral-300 p-1 pl-2 pr-2 rounded-sm text-sm self-end"
						type="button">
						Export unit-reference
					</button>
					<div class="flex flex-col items-end space-y-1 self-end">
						<button id="batch-opencv-button"
							class="flex align-center text-center bg-neutral-100 hover:bg-neutral-300 p-1 pl-2 pr-2 rounded-sm text-sm"
							type="button">
							Batch OpenCV
						</button>
						<div id="batch-opencv-progress" class="hidden w-48 text-xs text-neutral-700">
							<div class="w-full bg-neutral-200 h-1 rounded">
								<div id="batch-opencv-progress-bar" class="h-1 bg-blue-500 rounded" style="width:0%"></div>
							</div>
							<div id="batch-opencv-progress-text" class="mt-1 text-right">0 / 0</div>
						</div>
					</div>
				</div>
			</div>

			<div
				id="editor-button-container"
				style="display: flex; flex-direction: row; justify-content: space-between; align-items: center;"
			>
				<span class="text-xs font-semibold text-neutral-500 tracking-wide uppercase">Viewer</span>
				<div class="relative" id="download-canvas-zip-wrap">
					<button
						id="download-canvas-zip-trigger"
						class="flex items-center gap-1 text-center bg-neutral-100 hover:bg-neutral-300 p-1 pl-2 pr-2 rounded-sm text-sm"
						type="button"
						aria-expanded="false"
						aria-haspopup="true"
					>
						<span id="download-canvas-zip-label">Download ZIP</span>
						<span class="text-[10px] opacity-70" aria-hidden="true">▾</span>
					</button>
					<div
						id="download-canvas-zip-menu"
						class="hidden absolute right-0 top-full z-50 mt-0.5 min-w-[11rem] rounded-sm border border-neutral-200 bg-white py-0.5 text-sm shadow-md"
						role="menu"
					>
						<button
							type="button"
							class="download-canvas-zip-option block w-full px-3 py-2 text-left hover:bg-neutral-100"
							role="menuitem"
							data-zip-scope="this"
						>
							This SVG
						</button>
						<button
							type="button"
							class="download-canvas-zip-option block w-full px-3 py-2 text-left hover:bg-neutral-100"
							role="menuitem"
							data-zip-scope="all"
						>
							All Loaded
						</button>
					</div>
				</div>
			</div>
			<!-- Canvas stage wrapper for floating pill -->
			<div class="relative aspect-square max-h-[91vh] max-w-[91vh]">
				<div
					class="w-full h-full"
					id="scalable-canvas"
				>
					<div class="output" id="svg-container">
						<div id="svg-empty-state" class="absolute inset-0 flex flex-col items-center justify-center gap-3 pointer-events-none select-none">
							<img src="data:image/svg+xml,%3Csvg%20xmlns%3D%27http://www.w3.org/2000/svg%27%20width%3D%2740%27%20height%3D%2740%27%20viewBox%3D%270%200%2024%2024%27%20fill%3D%27none%27%20stroke%3D%27%23d4d4d8%27%20stroke-width%3D%271.2%27%20stroke-linecap%3D%27round%27%20stroke-linejoin%3D%27round%27%3E%3Cpath%20d%3D%27M21%2015v4a2%202%200%200%201-2%202H5a2%202%200%200%201-2-2v-4%27/%3E%3Cpolyline%20points%3D%2717%208%2012%203%207%208%27/%3E%3Cline%20x1%3D%2712%27%20y1%3D%273%27%20x2%3D%2712%27%20y2%3D%2715%27/%3E%3C/svg%3E" width="40" height="40" alt="" aria-hidden="true" />
							<p style="font-size:0.82rem;color:#a1a1aa;font-weight:500;margin:0;">Drop an SVG or CSV, or click Import</p>
						</div>
					</div>
				</div>

				<!-- Floating transform pill -->
				<div
					id="canvas-transform-toolbar"
					class="absolute bottom-4 left-1/2 -translate-x-1/2 z-30 flex items-center gap-0.5 px-2 py-1.5 rounded-full border border-white/10"
					style="background:rgba(20,20,24,0.82);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:0 8px 32px rgba(0,0,0,.45),0 1.5px 4px rgba(0,0,0,.3);"
				>
					<button id="canvas-flip-x" type="button" title="Canvas Flip X" aria-label="Canvas Flip X"
						class="flex items-center justify-center h-8 w-8 rounded-full text-neutral-200 hover:bg-white/15 hover:text-white active:bg-white/25 transition-colors duration-150">
						<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M8 8l-4 4 4 4"/><path d="M16 8l4 4-4 4"/></svg>
					</button>
					<button id="canvas-flip-y" type="button" title="Canvas Flip Y" aria-label="Canvas Flip Y"
						class="flex items-center justify-center h-8 w-8 rounded-full text-neutral-200 hover:bg-white/15 hover:text-white active:bg-white/25 transition-colors duration-150">
						<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18"/><path d="M8 8l4-4 4 4"/><path d="M8 16l4 4 4-4"/></svg>
					</button>
					<span class="inline-block w-px h-4 mx-1" style="background:rgba(255,255,255,0.18);" aria-hidden="true"></span>
					<button id="canvas-rotate-left" type="button" title="Rotate Left" aria-label="Rotate Left"
						class="flex items-center justify-center h-8 w-8 rounded-full text-neutral-200 hover:bg-white/15 hover:text-white active:bg-white/25 transition-colors duration-150">
						<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
					</button>
					<button id="canvas-rotate-right" type="button" title="Rotate Right" aria-label="Rotate Right"
						class="flex items-center justify-center h-8 w-8 rounded-full text-neutral-200 hover:bg-white/15 hover:text-white active:bg-white/25 transition-colors duration-150">
						<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
					</button>
					<span class="inline-block w-px h-4 mx-1" style="background:rgba(255,255,255,0.18);" aria-hidden="true"></span>
					<button id="flip-x" type="button" title="Flip Label Positions X" aria-label="Flip Label Positions X"
						class="flex items-center justify-center h-8 px-2.5 rounded-full text-neutral-300 hover:bg-white/15 hover:text-white active:bg-white/25 transition-colors duration-150 text-[11px] font-medium tracking-wide">L⇔</button>
					<button id="flip-y" type="button" title="Flip Label Positions Y" aria-label="Flip Label Positions Y"
						class="flex items-center justify-center h-8 px-2.5 rounded-full text-neutral-300 hover:bg-white/15 hover:text-white active:bg-white/25 transition-colors duration-150 text-[11px] font-medium tracking-wide">L⇕</button>
					<button id="reset-flip" type="button" title="Reset Flip" aria-label="Reset Flip"
						class="hidden items-center justify-center h-8 px-3 rounded-full bg-amber-400 hover:bg-amber-300 active:bg-amber-500 text-neutral-900 text-[11px] font-semibold transition-colors duration-150">Reset Flip</button>
					<button id="reset-rotation" type="button" title="Reset Rotation" aria-label="Reset Rotation"
						class="hidden items-center justify-center h-8 px-3 rounded-full bg-amber-400 hover:bg-amber-300 active:bg-amber-500 text-neutral-900 text-[11px] font-semibold transition-colors duration-150">Reset Rot</button>
				</div>
			</div>

			<div
				id="svg-nav"
				class="flex items-center justify-center gap-3 mt-2 min-h-[2rem]"
			>
				<button
					type="button"
					id="svg-prev"
					class="px-2 py-1 rounded-sm bg-neutral-100 hover:bg-neutral-200 text-sm disabled:opacity-40 disabled:pointer-events-none"
					aria-label="Previous SVG"
					disabled
				>
					&#8592;
				</button>
				<span
					id="svg-current-name"
					class="text-sm text-neutral-700 truncate max-w-[min(60vw,28rem)] text-center"
					title=""
				></span>
				<button
