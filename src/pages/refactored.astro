			"show",
			"back",
			"boh",
			"powder",
			"bedroom",
			"bathroom",
			"kitchen",
			"living",
			"laundry",
			"terrace",
			"wardrobe",
			"dining",
			"dinning",
			"corridor",
			"entrance",
			"room",
		].sort((a, b) => b.length - a.length);

		function splitCompoundRoomWord(word) {
			if (/^\d+$/.test(word)) return [word];
			let rest = String(word || "").toLowerCase();
			const parts = [];
			while (rest.length) {
				if (/^\d+/.test(rest)) {
					const n = rest.match(/^\d+/)[0];
					parts.push(n);
					rest = rest.slice(n.length);
					continue;
				}
				const tok = ROOM_NAME_TOKENS.find((t) => rest.startsWith(t));
				if (tok) {
					parts.push(tok);
					rest = rest.slice(tok.length);
				} else {
					parts.push(rest);
					break;
				}
			}
			return parts;
		}

		function toSpacedTitleCase(raw) {
			if (raw == null) return "";
			const spaced = String(raw)
				.replace(/[_-]+/g, " ")
				.replace(/([a-z])([A-Z])/g, "$1 $2")
				.replace(/([a-zA-Z])(\d+)/g, "$1 $2")
				.replace(/\s+/g, " ")
				.trim();
			if (!spaced) return "";
			return spaced
				.split(" ")
				.filter(Boolean)
				.flatMap(splitCompoundRoomWord)
				.map((word) => {
					if (/^\d+$/.test(word)) return word;
					if (word.toLowerCase() === "boh") return "BOH";
					return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
				})
				.join(" ");
		}

		function getCsvPointCoords(el) {
			let x = parseFloat(el.getAttribute("cx"));
			let y = parseFloat(el.getAttribute("cy"));
			if (isNaN(x) || isNaN(y)) {
				x = parseFloat(el.getAttribute("data-center-x"));
				y = parseFloat(el.getAttribute("data-center-y"));
			}
			return { x, y };
		}

		function pathContainsUserPoint(path, svg, x, y) {
			if (!path || !svg || !isFinite(x) || !isFinite(y)) return false;
			try {
				const pt = svg.createSVGPoint();
				pt.x = x;
				pt.y = y;
				if (typeof path.isPointInFill === "function" && path.isPointInFill(pt)) {
					return true;
				}
			} catch (_err) {
				/* path not rendered or geometry unavailable */
			}
			return false;
		}

		function bboxContainsPoint(path, x, y) {
			if (!path || !isFinite(x) || !isFinite(y)) return false;
			try {
				const box = path.getBBox();
				return (
					x >= box.x &&
					x <= box.x + box.width &&
					y >= box.y &&
					y <= box.y + box.height
				);
			} catch (_err) {
				return false;
			}
		}

		function pickSmallestPath(paths) {
			if (!paths.length) return null;
			let chosen = paths[0];
			let bestArea = pathArea(chosen);
			for (let i = 1; i < paths.length; i++) {
				const area = pathArea(paths[i]);
				if (area < bestArea) {
					bestArea = area;
					chosen = paths[i];
				}
			}
			return chosen;
		}

		function csvPointRowIndex(pointEl, fallbackIndex) {
			const rowAttr = pointEl.getAttribute("data-csv-row");
			if (rowAttr != null && rowAttr !== "") return String(rowAttr);
			return String(fallbackIndex);
		}

		function csvPointDisplayName(pointEl) {
			const fullName = pointEl.getAttribute("data-fullname");
			const rawName =
				pointEl.getAttribute("id") ||
				(fullName && fullName !== "undefined" ? fullName : "") ||
				"";
			return toSpacedTitleCase(rawName);
		}

		function pathArea(path) {
			try {
				const box = path.getBBox();
				return Math.abs(box.width * box.height);
			} catch (_err) {
				return Number.POSITIVE_INFINITY;
			}
		}

		function restoreCsvPathCollisions(svg) {
			if (!svg) return;
			svg.querySelectorAll("path[data-csv-collision]").forEach((path) => {
				const origId = path.getAttribute("data-csv-original-id");
				const origName = path.getAttribute("data-csv-original-name");
				if (origId !== null) path.setAttribute("id", origId);
				if (origName) path.setAttribute("name", origName);
				else path.removeAttribute("name");
				path.removeAttribute("data-csv-original-id");
				path.removeAttribute("data-csv-original-name");
				path.removeAttribute("data-csv-collision");
				path.classList.remove("csv-collision-single", "csv-collision-multi", "csv-collision-renumbered");
			});
		}

		function takeUniqueSvgId(desired, usedIds) {
			const base = desired == null || desired === "" ? "-" : String(desired);
			if (!usedIds.has(base)) {
				usedIds.add(base);
				return base;
			}
			let n = 2;
			let candidate = `${base}_${n}`;
			while (usedIds.has(candidate)) {
				n += 1;
				candidate = `${base}_${n}`;
			}
			usedIds.add(candidate);
			return candidate;
		}

		function refreshIdListFromSvg(svg) {
			const listEl = document.getElementById("id-list");
			if (!listEl || !svg) return;
			listEl.innerHTML = "";
			svg.querySelectorAll("[id]").forEach((el) => {
				if (el === svg) return;
				if (el.closest("#g-instance")) return;
				const li = document.createElement("li");
				const name = el.getAttribute("name");
				li.textContent =
					name && name !== el.id ? `${el.id}  ${name}` : el.id;
				li.style.listStyle = "none";
				li.style.padding = "0.5em 0em";
				listEl.append(li);
			});
		}

		function convertShapesToPaths(svg) {
			if (!svg) return;
			const ns = "http://www.w3.org/2000/svg";
			svg.querySelectorAll("polygon, polyline, rect").forEach((el) => {
				if (el.closest("#g-instance, defs, clipPath, mask, symbol")) return;
				const tag = el.tagName.toLowerCase();
				let d = "";
				if (tag === "polygon" || tag === "polyline") {
					const raw = el.getAttribute("points") || "";
					const nums = raw.trim().split(/[\s,]+/).filter(Boolean).map(Number);
					if (nums.length < 4) return;
					const pairs = [];
					for (let i = 0; i < nums.length; i += 2) {
						if (!isFinite(nums[i]) || !isFinite(nums[i + 1])) continue;
						pairs.push(`${nums[i]},${nums[i + 1]}`);
					}
					if (pairs.length < 2) return;
					d = `M${pairs.join(" L")}${tag === "polygon" ? " Z" : ""}`;
				} else if (tag === "rect") {
					const x = parseFloat(el.getAttribute("x") || "0");
					const y = parseFloat(el.getAttribute("y") || "0");
					const w = parseFloat(el.getAttribute("width") || "0");
					const h = parseFloat(el.getAttribute("height") || "0");
					if (!isFinite(x) || !isFinite(y) || !isFinite(w) || !isFinite(h)) return;
					d = `M${x},${y} h${w} v${h} h${-w} Z`;
				}
				const path = document.createElementNS(ns, "path");
				Array.from(el.attributes).forEach((attr) => {
					if (["points", "x", "y", "width", "height", "rx", "ry"].includes(attr.name)) return;
					path.setAttribute(attr.name, attr.value);
				});
				path.setAttribute("d", d);
				el.replaceWith(path);
			});
		}

		function stripCsvCollisionFromClone(svgClone) {
			if (!svgClone) return;
			convertShapesToPaths(svgClone);
			svgClone.querySelectorAll("image").forEach((el) => el.remove());
			svgClone.querySelectorAll("#g-instance").forEach((g) => g.remove());
			// SC-SEL-1: Remove selection UI overlay from export
			svgClone.querySelectorAll("#selection-ui").forEach((g) => g.remove());
			svgClone.querySelectorAll("circle").forEach((c) => c.remove());
			svgClone.querySelectorAll("[data-triangle]").forEach((el) => el.remove());
			svgClone.querySelectorAll("[data-csv-collision]").forEach((path) => {
				path.removeAttribute("data-csv-original-id");
				path.removeAttribute("data-csv-original-name");
				path.removeAttribute("data-csv-collision");
				path.classList.remove("csv-collision-single", "csv-collision-multi", "csv-collision-renumbered");
			});
			svgClone.querySelectorAll(".no-matching-floorplan, .hovered, .svg-tool-selected").forEach((el) => {
				el.classList.remove("no-matching-floorplan", "hovered", "svg-tool-selected");
				if (el.getAttribute("class") === "") el.removeAttribute("class");
				if (el.getAttribute("style") === "") el.removeAttribute("style");
			});
		}

		let csvCollisionActive = false;
		let csvCollisionRaf = 0;

		function scheduleCsvPathCollisions() {
			if (csvCollisionRaf) return;
			csvCollisionRaf = requestAnimationFrame(() => {
				csvCollisionRaf = 0;
				applyCsvPathCollisions();
			});
		}

		function applyCsvPathCollisions() {
			const svg = document.querySelector("#svg-container svg");
			if (!svg) {
				csvCollisionActive = false;
				return;
			}

			restoreCsvPathCollisions(svg);
			convertShapesToPaths(svg);

			const paths = Array.from(svg.querySelectorAll("path")).filter((path) => {
				if (path.closest("#g-instance, defs, clipPath, mask, symbol")) return false;
				const d = path.getAttribute("d");
				return d && d.trim().length > 0;
			});
			const points = Array.from(
				svg.querySelectorAll("#g-instance circle, #g-instance [data-triangle]"),
			).sort((a, b) => {
				const ra = Number(a.getAttribute("data-csv-row"));
				const rb = Number(b.getAttribute("data-csv-row"));
				return (
					(Number.isFinite(ra) ? ra : 1e9) -
					(Number.isFinite(rb) ? rb : 1e9)
				);
			});

			csvCollisionActive = points.length > 0;
			if (paths.length === 0 || points.length === 0) {
				refreshIdListFromSvg(svg);
				return;
			}

			const usedPaths = new Set();
			const assignments = [];
			points.forEach((pointEl, pointIndex) => {
				const { x, y } = getCsvPointCoords(pointEl);
				if (!isFinite(x) || !isFinite(y)) return;

				const unused = paths.filter((path) => !usedPaths.has(path));
				let chosen = pickSmallestPath(
					unused.filter((path) =>
						pathContainsUserPoint(path, svg, x, y),
					),
				);
				if (!chosen) {
					chosen = pickSmallestPath(
						unused.filter((path) => bboxContainsPoint(path, x, y)),
					);
				}
				if (!chosen) return;

				usedPaths.add(chosen);
				assignments.push({
					path: chosen,
					rowIndex: csvPointRowIndex(pointEl, pointIndex),
					name: csvPointDisplayName(pointEl),
				});
			});

			const usedIds = new Set();
			svg.querySelectorAll("[id]").forEach((el) => {
				if (el === svg) return;
				if (el.closest("#g-instance")) return;
				if (usedPaths.has(el)) return;
				if (el.id) usedIds.add(el.id);
			});

			assignments.forEach(({ path, rowIndex, name }) => {
				if (!path.hasAttribute("data-csv-original-id")) {
					path.setAttribute(
						"data-csv-original-id",
						path.getAttribute("id") || "",
					);
					path.setAttribute(
						"data-csv-original-name",
						path.getAttribute("name") || "",
					);
				}

				path.classList.remove("csv-collision-single", "csv-collision-multi");
				path.setAttribute("id", takeUniqueSvgId(String(rowIndex), usedIds));
				if (name) path.setAttribute("name", name);
				else path.removeAttribute("name");
				path.setAttribute("data-csv-collision", "single");
				path.classList.add("csv-collision-single");
			});

			const nonCollidingPaths = paths.filter((p) => !usedPaths.has(p));
			let nextFourDigit = 1001;
			nonCollidingPaths.forEach((path) => {
				if (!path.hasAttribute("data-csv-original-id")) {
					path.setAttribute(
						"data-csv-original-id",
						path.getAttribute("id") || "",
					);
				}

				while (usedIds.has(`-${String(nextFourDigit).padStart(4, "0")}`)) {
					nextFourDigit++;
					if (nextFourDigit > 9999) break;
				}
				if (nextFourDigit > 9999) return;

				const newId = `-${String(nextFourDigit).padStart(4, "0")}`;
				usedIds.add(newId);
				path.setAttribute("id", newId);
				path.removeAttribute("name");
				path.setAttribute("data-csv-collision", "renumbered");
				path.classList.add("csv-collision-renumbered");
				nextFourDigit++;
			});

			refreshIdListFromSvg(svg);
		}

