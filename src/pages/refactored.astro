				const layers = layerNodes
					.map((layer, index) => {
						const layerId = layer.getAttribute("id");
						if (layerId && layerId.toLowerCase() === "reference") {
							return undefined;
						}
						const id = layerId
							? layerId.replace("_", "")
							: `item-${index}`;
						const children = Array.from(layer.children)
							.filter((child) => {
