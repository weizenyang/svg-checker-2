			const reader = new FileReader();
			reader.onload = () => {
				try {
					const text = String(reader.result ?? "");
					const j = JSON.parse(text) as unknown;
					let rawList: unknown[] | null = null;
					if (Array.isArray(j)) rawList = j;
					else if (
						j &&
						typeof j === "object" &&
						"units" in j &&
						Array.isArray((j as { units: unknown }).units)
					) {
						rawList = (j as { units: unknown[] }).units;
					}
					if (!rawList) {
						showToast('JSON must be { "units": [...] } or a top-level array', "warning");
						return;
					}
					const next: { name: string; type: string }[] = [];
					for (const row of rawList) {
						if (!row || typeof row !== "object") continue;
						const name = String((row as { name?: unknown }).name ?? "").trim();
						const type = String((row as { type?: unknown }).type ?? "").trim();
						if (name && type) next.push({ name, type });
					}
					if (next.length === 0) {
						showToast("No valid name/type entries in JSON", "warning");
						return;
					}
					unitReferenceFilterUnits = next;
					updateUnitReferenceJsonStatus();
					showToast(`Unit reference loaded (${next.length} row(s))`, "success");
				} catch (err) {
					console.error(err);
					showToast("Could not parse unit reference JSON", "error");
				}
			};
			reader.onerror = () => showToast("Failed to read JSON file", "error");
			reader.readAsText(file);
		});

