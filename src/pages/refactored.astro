				handle.setAttribute('stroke', vertexSelected ? '#fbbf24' : '#ffffff');
				handle.setAttribute('stroke-width', vertexSelected ? selectedStrokeWidth : strokeWidth);
				handle.style.cursor = 'move';
				handle.style.pointerEvents = 'all';
				ui.appendChild(handle);

