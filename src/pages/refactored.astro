				if (bboxOriginalBounds) {
					const b = bboxOriginalBounds;
					if (handleId === 'nw') bboxScaleAnchor = { x: b.x + b.width, y: b.y + b.height };
					else if (handleId === 'ne') bboxScaleAnchor = { x: b.x, y: b.y + b.height };
					else if (handleId === 'sw') bboxScaleAnchor = { x: b.x + b.width, y: b.y };
					else if (handleId === 'se') bboxScaleAnchor = { x: b.x, y: b.y };
