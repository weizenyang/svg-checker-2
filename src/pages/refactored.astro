								return {
									id: childId,
									x: child.getAttribute("cx"),
									y: child.getAttribute("cy"),
								};
							});
						if (children.length === 0) return undefined;
						return { id, children };
					})
					.filter((layer) => layer !== undefined);

				var csv;
