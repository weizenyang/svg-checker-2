			const v = vertices[vertexIdx];
			if (!v || v.cmd === 'Z' || v.cmd === 'M') return false;
			
			const prev = vertices[vertexIdx - 1];
			const next = vertices[vertexIdx + 1];
			
			// Check if the incoming edge is straight
			if (!isVertexStraightSegment(v)) return false;
			
			// Special case: first vertex after M in a closed path
			// The corner is between the closing edge (last→first) and the first edge (first→second)
			if (prev && prev.cmd === 'M') {
				// Find if path is closed
				const hasZ = vertices.some(vv => vv.cmd === 'Z');
				if (hasZ) {
					// Find the last vertex before Z (the incoming edge comes from there via the closing Z)
					let lastBeforeZ = null;
					for (let i = vertices.length - 1; i >= 0; i--) {
						if (vertices[i].cmd === 'Z') continue;
						if (vertices[i].cmd !== 'M' && isVertexStraightSegment(vertices[i])) {
							lastBeforeZ = vertices[i];
							break;
						}
					}
					if (!lastBeforeZ) return false;
					
					// Check if the outgoing edge is straight
					if (next && next.cmd !== 'Z' && isVertexStraightSegment(next)) {
						return true;
					}
				}
				return false;
			}
			
			// Check if the outgoing edge is straight (or it's the closing corner)
			if (next) {
				if (next.cmd === 'Z') {
					// Closing corner - check the first vertex after M
					const firstAfterM = vertices.find((vv, i) => i > 0 && vv.cmd !== 'M' && vv.cmd !== 'Z');
					return firstAfterM ? isVertexStraightSegment(firstAfterM) : false;
