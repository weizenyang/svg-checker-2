				const v = pathEditVertices[i];
				if (v.cmd === 'Z') continue;

				// SC-SEL-5: Check if this vertex is selected
				const vertexSelected = isHandleSelected('vertex', i);

				const handle = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
				handle.setAttribute('class', 'vertex-handle');
				handle.setAttribute('data-vertex-idx', i);
				handle.setAttribute('x', v.x - vertexSize / 2);
				handle.setAttribute('y', v.y - vertexSize / 2);
				handle.setAttribute('width', vertexSize);
				handle.setAttribute('height', vertexSize);
				// SC-SEL-5: Different fill/stroke for selected vertices
