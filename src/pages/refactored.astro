		 * @param {number} cumulativeX - Total X displacement so far
		 * @param {number} cumulativeY - Total Y displacement so far
		 * @returns {{dx: number, dy: number}} - Constrained deltas
		 */
		function constrainAxisDeltaCumulative(dx, dy, shiftHeld, cumulativeX, cumulativeY) {
			if (!shiftHeld) {
