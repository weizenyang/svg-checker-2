					}
				} else if (v.cmd === 'S') {
					// SC-ROUND-1: Preserve smooth cubic Bézier curve commands
					if (v.cp2x !== undefined && v.cp2y !== undefined) {
						newD += `S ${v.cp2x} ${v.cp2y} ${v.x} ${v.y} `;
					} else {
