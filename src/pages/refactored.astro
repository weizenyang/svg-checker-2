					globalSvgContainer.querySelector("svg")?.cloneNode(true) as SVGElement
				);
				redoStack.push(currentState);
				if (redoStack.length > MAX_HISTORY) {
					redoStack.shift();
				}
				
				const previousState = undoStack.pop();
				if (previousState) {
					restoreState(previousState);
				}
			}
		}

