					<input
						type="file"
						id="unit-reference-json-input"
						accept=".json,application/json"
						class="hidden"
					/>
					<button
						type="button"
						id="unit-reference-json-clear"
						class="flex align-center text-center bg-neutral-100 hover:bg-neutral-300 p-1 pl-2 pr-2 rounded-sm text-xs"
					>
						Clear unit filter
					</button>
					<span id="unit-reference-json-status" class="text-xs text-neutral-600 max-w-[280px] leading-tight"
						>No unit filter file</span>
				</div>
				<div class="flex flex-wrap gap-2 items-end mt-2">
					<button
						type="button"
						id="batch-shape-bench-button"
						class="flex align-center text-center bg-amber-200 hover:bg-amber-300 p-1 pl-2 pr-2 rounded-sm text-sm border border-amber-300/80"
					>
						Batch Silhouette bench
					</button>
					<div id="batch-shape-bench-progress" class="hidden w-48 text-xs text-neutral-700">
						<div class="w-full bg-neutral-200 h-1 rounded">
							<div
								id="batch-shape-bench-progress-bar"
								class="h-1 bg-amber-600 rounded"
								style="width:0%"
							></div>
						</div>
						<div id="batch-shape-bench-progress-text" class="mt-1 text-right truncate" title="">
							0 / 0
						</div>
					</div>
				</div>
				<div id="shape-benchmark-progress" class="hidden w-full max-w-md mt-2 text-xs text-neutral-700">
					<div class="w-full bg-neutral-200 h-1.5 rounded">
						<div
							id="shape-benchmark-progress-bar"
							class="h-1.5 bg-amber-600 rounded transition-[width] duration-150"
							style="width:0%"
						></div>
					</div>
					<div id="shape-benchmark-progress-text" class="mt-1 text-neutral-600 truncate" title="">
						0 / 0
					</div>
				</div>
				<div
					id="shape-benchmark-results"
					class="hidden mt-2 overflow-x-auto max-h-72 overflow-y-auto text-xs border border-neutral-200 rounded-sm bg-white"
				></div>
			</div>
		</dialog>

		<!-- Toast notification -->
		<div id="toast" class="toast"></div>

	</body>

	<script>
		// import { onMount } from 'astro/client';
		// import * as svgOp from "./svg-scripts/svg-operations"
		import { transform } from "typescript";
		import JSZip from "jszip";
		import {
			runFloorplanComparison,
			imageDataToDataUrl,
			exportSilhouettePreprocessCacheZipBlob,
			importSilhouettePreprocessCacheFromZipArrayBuffer,
			getSilhouettePreprocessCacheStats,
		} from "../scripts/floorplan-comparison.js";
		import {
			runFloorplanComparisonOpencv,
			runSilhouetteBenchmarkBatch,
			dedupeBenchmarkCandidatesByIdenticalContent,
			shapeBenchCompareRowsForRank,
		} from "../scripts/floorplan-comparison-opencv.js";
		import {
			currentValuesList,
			updateValuesList,
			updateValuesModal,
			circlesToSpawn,
		} from "../store.js";
		enum format {
			underscore,
			dash,
			none,
			fullUnderscore,
		}

		var flipped = false;
		var canvasFlipX = false;
		var canvasFlipY = false;
		var canvasRotate = 0;
		var multiSelect = false;
		var clusterId = [];
		var canvasScale = 1;

		var idFormat = format.none; //SVG ID format
		var mouseDown = false;
		var globalSvgContainer = document.getElementById("svg-container");
		var mouseInContainer = false;
		var tempSelected;
		var flipYX = true;

		let prevMouseX = 0;
		let prevMouseY = 0;

		let rightMouseDown = false;
		let anchorPoint = { x: 0, y: 0 };
		let typing = false;

		let globalFloors = [];
		let globalFloorsAggregated = [];
		let aggregatePoints = false;
		let checkboxesId = [];

		// Image transformation lookup for preview images
		let imageTransformLookup = {};
		let currentHoveredImageName = null;
		let currentHoveredPathElement = null;
		let previewPinned = false;
		/** Re-open ranked carousel when re-hovering the same path after the panel was cleared. */
		let lastShapeBenchRankCarousel: null | {
			pathId: string;
			/** Carousel label for the score column (e.g. IoU %). */
			featureColumnLabel?: string;
			items: Array<{
				rank: number;
				name: string;
				data: string;
				rankScore: number;
				orbProduction: number;
				orbMax8: number;
				contourMax8: number;
				legacySilhouette: number;
				bestPoseLabel?: string;
				silhouetteVisual?: {
					gridPx: { w: number; h: number };
					formula: string;
					cutoutMaskUrl: string;
					floorMaskUrl: string;
					overlapUrl: string;
				};
			}>;
		} = null;
		/** After "Back" on ranked carousel, re-hover shows floorplan text until next Shape bench. */
		let shapeBenchCarouselDismissedPathId: string | null = null;

		type SilhouetteBenchRankEntry = {
			featureColumnLabel?: string;
			scored?: number;
			total?: number;
			items: Array<{
				rank: number;
				name: string;
				data: string;
				rankScore: number;
				orbProduction: number;
				orbMax8: number;
				contourMax8: number;
				legacySilhouette: number;
				bestPoseLabel?: string;
				silhouetteIou?: number;
				silhouetteChamfer?: number;
				silhouetteChamferMeanPx?: number;
				silhouetteChamferStdPx?: number;
				silhouetteVisual?: unknown;
			}>;
		};

		/** Per loaded SVG element (same reference as `importedSVGs[].element`) — survives arrow navigation. */
		const silhouetteBenchRankBySvgEl = new Map<Element, Map<string, SilhouetteBenchRankEntry>>();

		function ensureSilhouetteBenchRankMapForSvg(svgEl: Element): Map<string, SilhouetteBenchRankEntry> {
			let inner = silhouetteBenchRankBySvgEl.get(svgEl);
			if (!inner) {
				inner = new Map();
				silhouetteBenchRankBySvgEl.set(svgEl, inner);
			}
			return inner;
		}

		function getSilhouetteBenchRankEntryForPathOnSvg(
			svgEl: Element | null | undefined,
			pathId: string,
		): SilhouetteBenchRankEntry | undefined {
			if (!svgEl || !pathId) return undefined;
			return silhouetteBenchRankBySvgEl.get(svgEl)?.get(pathId);
		}

		let silBenchHoverPanelRefreshTimer: ReturnType<typeof setTimeout> | null = null;

		function setSilhouetteBenchRankForPath(
			pathId: string,
			rankedCarousel: Array<{
				rank: number;
				name: string;
				data: string;
				rankScore: number;
				orbProduction: number;
				orbMax8: number;
				contourMax8: number;
				legacySilhouette: number;
				bestPoseLabel?: string;
				silhouetteIou?: number;
				silhouetteChamfer?: number;
				silhouetteChamferMeanPx?: number;
				silhouetteChamferStdPx?: number;
				silhouetteVisual?: unknown;
			}>,
			opts?: { featureColumnLabel?: string; scored?: number; total?: number },
			rankSvgEl?: Element | null,
		) {
			if (!pathId || !rankedCarousel?.length) return;
			const svgEl = rankSvgEl ?? document.querySelector("#svg-container svg");
			if (!svgEl) return;
			const inner = ensureSilhouetteBenchRankMapForSvg(svgEl);
			inner.set(pathId, {
				items: rankedCarousel.map((it) => ({ ...it })),
				featureColumnLabel: opts?.featureColumnLabel,
				scored: opts?.scored,
				total: opts?.total,
			});
			const hid = currentHoveredPathElement?.getAttribute?.("id") || currentHoveredPathElement?.id;
			if (hid !== pathId) return;
			const preview = document.getElementById("image-previewer-container");
			if (!preview || preview.style.display === "none") return;
			if (silBenchHoverPanelRefreshTimer != null) clearTimeout(silBenchHoverPanelRefreshTimer);
			silBenchHoverPanelRefreshTimer = setTimeout(() => {
				silBenchHoverPanelRefreshTimer = null;
				refreshHoverPanelSilhouetteRankIfActive(pathId);
			}, 90);
		}

		/** Update floating hover rank carousel when this path is hovered (live bench / batch). One image decoded at a time via ‹ ›. */
		function refreshHoverPanelSilhouetteRankIfActive(pathId: string) {
			const hid = currentHoveredPathElement?.getAttribute?.("id") || currentHoveredPathElement?.id;
			if (hid !== pathId) return;
			if (shapeBenchCarouselDismissedPathId === pathId) return;
			const domSvg = document.querySelector("#svg-container svg");
			const entry = getSilhouetteBenchRankEntryForPathOnSvg(domSvg, pathId);
			if (!entry?.items?.length) return;
			const preview = document.getElementById("image-previewer-container");
			if (!preview || preview.style.display === "none") return;
			const s = entry.scored;
			const t = entry.total;
			showShapeBenchmarkRankCarousel(entry.items, {
				pathId,
				featureColumnLabel: entry.featureColumnLabel ?? "Score",
				...(s != null && t != null ? { scored: s, total: t } : {}),
			});
		}

		/** Live rank carousel in the floating preview; updated during Shape bench partial results. */
		let shapeBenchRankCarouselUI: null | {
			pathId: string;
			items: Array<{
				rank: number;
				name: string;
				data: string;
				rankScore: number;
				orbProduction: number;
				orbMax8: number;
				contourMax8: number;
				legacySilhouette: number;
				bestPoseLabel?: string;
				silhouetteVisual?: {
					gridPx: { w: number; h: number };
					formula: string;
					cutoutMaskUrl: string;
					floorMaskUrl: string;
					overlapUrl: string;
				};
			}>;
			index: number;
			pendingLine: string;
			featureColumnLabel: string;
			label: HTMLDivElement;
			prevBtn: HTMLButtonElement;
			nextBtn: HTMLButtonElement;
			backBtn: HTMLButtonElement;
			previewImg: HTMLImageElement;
			previewText: HTMLElement;
			compareBtnEl: HTMLElement | null;
			compareOpencvBtnEl: HTMLElement | null;
			compareShapeBenchBtnEl: HTMLElement | null;
			iouExplainWrap: HTMLDivElement | null;
			iouCutImg: HTMLImageElement | null;
			iouFloorImg: HTMLImageElement | null;
			iouOverlapImg: HTMLImageElement | null;
			iouFormulaEl: HTMLDivElement | null;
		} = null;

		function destroyShapeBenchRankCarouselUI() {
			const c = shapeBenchRankCarouselUI;
			if (!c) return;
			c.label.remove();
			c.prevBtn.remove();
			c.nextBtn.remove();
			c.backBtn.remove();
			if (c.iouExplainWrap) c.iouExplainWrap.remove();
			shapeBenchRankCarouselUI = null;
		}

		/** Shape bench: show each OpenCV preprocess step (raw → bg removed → morph → crop) in the floating image preview. */
		async function shapeBenchPreprocessFlashStepHandler(info: {
			label: string;
			imageData: ImageData;
			candidateName: string;
			stepIndex: number;
			stepTotal: number;
		}) {
			const container = document.getElementById("image-previewer-container");
			const previewImg = document.getElementById("image-previewer-image") as HTMLImageElement;
			const previewText = document.getElementById("image-previewer-text");
			if (!container || !previewImg || !previewText) return;
			if (info.stepIndex === 0) {
				destroyShapeBenchRankCarouselUI();
			}
			container.style.display = "block";
			previewPinned = true;
			previewText.style.display = "block";
			const compareBtnEl = document.getElementById("compare-floorplan-btn");
			const compareOpencvBtnEl = document.getElementById("compare-opencv-btn");
			const compareShapeBenchBtnEl = document.getElementById("compare-shape-bench-btn");
			if (compareBtnEl) compareBtnEl.style.display = "none";
			if (compareOpencvBtnEl) compareOpencvBtnEl.style.display = "none";
			if (compareShapeBenchBtnEl) compareShapeBenchBtnEl.style.display = "none";
			previewImg.src = imageDataToDataUrl(info.imageData);
			const esc = (s: string) =>
				String(s)
					.replace(/&/g, "&amp;")
					.replace(/</g, "&lt;")
					.replace(/>/g, "&gt;")
					.replace(/"/g, "&quot;");
			previewText.style.whiteSpace = "pre-wrap";
			previewText.style.fontSize = "10px";
			previewText.style.lineHeight = "1.35";
			previewText.style.color = "#1a1a1a";
			previewText.innerHTML = `${esc(info.candidateName)}\n<span style="color:#b45309">Preprocess preview ${info.stepIndex + 1}/${info.stepTotal}</span>\n${esc(info.label)}\n<code style="font-size:9px">${info.imageData.width}×${info.imageData.height}</code>`;
		}

		// Imported unit-reference data
		let importedUnitReference = null;

		// Asset Delivery API Integration
		const API_BASE_URL = 'http://localhost:9234';

		// Extract project key from URL parameters
		function getProjectKey() {
			const urlParams = new URLSearchParams(window.location.search);
			return urlParams.get('project') || urlParams.get('key') || urlParams.get('id') || 'default';
		}

		// Fetch project assets from API
		async function fetchProjectAssets(projectKey) {
			try {
				const response = await fetch(`${API_BASE_URL}/api/project/${projectKey}`);
				if (!response.ok) {
					throw new Error(`HTTP ${response.status}: ${response.statusText}`);
				}
				return await response.json();
			} catch (error) {
				console.warn('Primary API endpoint failed, trying legacy endpoints:', error);

				// Try legacy endpoints as fallback
				try {
					const [modelsRes, csvRes] = await Promise.allSettled([
						fetch(`${API_BASE_URL}/model`),
						fetch(`${API_BASE_URL}/camera-csv`)
					]);

					const result = { mode: 'roomscale-4', models: [], cameraCSV: null, images: [], unitFloorplans: [] };

					if (modelsRes.status === 'fulfilled' && modelsRes.value.ok) {
						const modelsData = await modelsRes.value.json();
						result.models = modelsData.models || [];
					}

					if (csvRes.status === 'fulfilled' && csvRes.value.ok) {
						const csvData = await csvRes.value.json();
						result.cameraCSV = csvData;
					}

					return result;
				} catch (legacyError) {
					console.error('All API endpoints failed:', legacyError);
					return null;
				}
			}
		}

		// Convert API data formats to application format
		function convertApiData(data) {
			const converted = { ...data };

			// Convert base64 strings to Uint8Array if needed
			if (converted.models) {
				converted.models = converted.models.map(model => ({
					...model,
					data: typeof model.data === 'string' && !model.data.startsWith('data:')
						? Uint8Array.from(atob(model.data), c => c.charCodeAt(0))
						: model.data
				}));
			}

			if (converted.cameraCSV && typeof converted.cameraCSV.data === 'string') {
				converted.cameraCSV.data = converted.cameraCSV.data;
			}

			if (converted.images) {
				console.log('Converting images data:', converted.images.map(img => ({
					name: img.imageName,
					mimeType: img.mimeType,
					dataType: typeof img.data,
					dataLength: img.data?.length,
					dataPreview: typeof img.data === 'string' ? img.data.substring(0, 50) : 'non-string'
				})));

				converted.images = converted.images.map(img => {
					let data = img.data;
					console.log(`Processing image: ${img.imageName}, mimeType: ${img.mimeType}`);

					// For SVG files, if it's base64 encoded, keep as string for direct parsing
					// For other image types, convert to data URLs
					if (img.mimeType !== 'image/svg+xml') {
						console.log(`Converting non-SVG image to data URL: ${img.imageName}`);
						if (typeof data === 'string' && !data.startsWith('data:')) {
							data = `data:${img.mimeType};base64,${data}`;
							console.log(`Converted to data URL, new length: ${data.length}`);
						}
					} else {
						console.log(`Processing SVG image: ${img.imageName}`);
						// For SVG, handle different data formats
						if (data instanceof ArrayBuffer) {
							// Convert ArrayBuffer to string
							console.log('Converting ArrayBuffer to string');
							const decoder = new TextDecoder('utf-8');
							data = decoder.decode(data);
						} else if (data instanceof Uint8Array) {
							// Convert Uint8Array to string
							console.log('Converting Uint8Array to string');
							const decoder = new TextDecoder('utf-8');
							data = decoder.decode(data);
						} else if (typeof data === 'string') {
							console.log(`Processing string data, starts with: ${data.substring(0, 50)}`);
							// Handle data URLs and plain content
							if (data.startsWith('data:image/svg+xml;base64,')) {
								console.log('Decoding base64 data URL');
								const base64Data = data.split(',')[1];
								data = atob(base64Data);
							} else if (data.startsWith('data:image/svg+xml,')) {
								console.log('Decoding plain data URL');
								data = decodeURIComponent(data.split(',')[1]);
							} else {
								// Check if it's a base64-encoded string (not a data URL)
								// Base64 strings typically don't contain spaces and are longer than typical SVG content
								const isLikelyBase64 = /^[A-Za-z0-9+/]+=*$/.test(data) && data.length > 100 && !data.includes('<');
								console.log(`Checking if base64: ${isLikelyBase64}, length: ${data.length}, contains '<': ${data.includes('<')}`);
								if (isLikelyBase64) {
									try {
										console.log('Decoding base64 string');
										data = atob(data);
									} catch (e) {
										// If atob fails, assume it's already decoded SVG content
										console.warn('Failed to decode base64 SVG data, assuming it\'s already decoded');
									}
								} else {
									console.log('Assuming already decoded SVG content');
								}
								// If it's already a string and not a data URL or base64, assume it's SVG content
							}
						}
						console.log(`Final SVG data length: ${data.length}, starts with: ${data.substring(0, 50)}`);
					}
					return { ...img, data };
				});
			}

			if (converted.unitFloorplans) {
				console.log('Converting unitFloorplans data:', converted.unitFloorplans.map(img => ({
					name: img.imageName,
					mimeType: img.mimeType,
					dataType: typeof img.data,
					dataLength: img.data?.length,
					dataPreview: typeof img.data === 'string' ? img.data.substring(0, 50) : 'non-string'
				})));

				converted.unitFloorplans = converted.unitFloorplans.map(img => {
					let data = img.data;
					console.log(`Processing unitFloorplan: ${img.imageName}, mimeType: ${img.mimeType}`);

					// Same logic as images above
					if (img.mimeType !== 'image/svg+xml') {
						console.log(`Converting non-SVG unitFloorplan to data URL: ${img.imageName}`);
						if (typeof data === 'string' && !data.startsWith('data:')) {
							data = `data:${img.mimeType};base64,${data}`;
							console.log(`Converted to data URL, new length: ${data.length}`);
						}
					} else {
						console.log(`Processing SVG unitFloorplan: ${img.imageName}`);
						// For SVG, handle different data formats
						if (data instanceof ArrayBuffer) {
							// Convert ArrayBuffer to string
							console.log('Converting ArrayBuffer to string');
							const decoder = new TextDecoder('utf-8');
							data = decoder.decode(data);
						} else if (data instanceof Uint8Array) {
							// Convert Uint8Array to string
							console.log('Converting Uint8Array to string');
							const decoder = new TextDecoder('utf-8');
							data = decoder.decode(data);
						} else if (typeof data === 'string') {
							console.log(`Processing string data, starts with: ${data.substring(0, 50)}`);
							// Handle data URLs and plain content
							if (data.startsWith('data:image/svg+xml;base64,')) {
								console.log('Decoding base64 data URL');
								const base64Data = data.split(',')[1];
								data = atob(base64Data);
							} else if (data.startsWith('data:image/svg+xml,')) {
								console.log('Decoding plain data URL');
								data = decodeURIComponent(data.split(',')[1]);
							} else {
								// Check if it's a base64-encoded string (not a data URL)
								// Base64 strings typically don't contain spaces and are longer than typical SVG content
								const isLikelyBase64 = /^[A-Za-z0-9+/]+=*$/.test(data) && data.length > 100 && !data.includes('<');
								console.log(`Checking if base64: ${isLikelyBase64}, length: ${data.length}, contains '<': ${data.includes('<')}`);
								if (isLikelyBase64) {
									try {
										console.log('Decoding base64 string');
										data = atob(data);
									} catch (e) {
										// If atob fails, assume it's already decoded SVG content
										console.warn('Failed to decode base64 SVG data, assuming it\'s already decoded');
									}
								} else {
									console.log('Assuming already decoded SVG content');
								}
								// If it's already a string and not a data URL or base64, assume it's SVG content
							}
						}
						console.log(`Final unitFloorplan SVG data length: ${data.length}, starts with: ${data.substring(0, 50)}`);
					}
					return { ...img, data };
				});
			}

			return converted;
		}

		// Process API response and load assets
		async function processApiAssets(apiData) {
			if (!apiData) return;

			console.log('Processing API assets:', apiData);

			const convertedData = convertApiData(apiData);

			// Store assets globally for the application to use
			window.apiAssets = convertedData;

			// Process based on mode
			if (convertedData.mode === 'refactored') {
				console.log('Processing refactored mode assets', {
					workflow: convertedData.workflow,
					images: convertedData.images?.length || 0,
					unitFloorplans: convertedData.unitFloorplans?.length || 0,
					csv: convertedData.cameraCSV ? convertedData.cameraCSV.csvName : null
				});

				const isPreviewThumb = (name) => /_w\d+_q\d+/i.test(name || '') || /_thumb/i.test(name || '');
				const isUnitFloorplanName = (name) => {
					const n = name || '';
					return n.includes('backplate_image_floorplan') && !n.includes('tower-floorplate');
				};

				const svgImages = (convertedData.images || []).filter(img => img.mimeType === 'image/svg+xml');
				let unitFloorplans = [];
				if (convertedData.unitFloorplans && convertedData.unitFloorplans.length > 0) {
					unitFloorplans = convertedData.unitFloorplans.filter(img => !isPreviewThumb(img.imageName));
				}
				// Also pick unit rasters that accidentally arrived in images[]
				(convertedData.images || []).forEach(img => {
					if (img.mimeType === 'image/svg+xml') return;
					if (!isUnitFloorplanName(img.imageName || '')) return;
					if (isPreviewThumb(img.imageName)) return;
					if (!unitFloorplans.some(u => u.imageName === img.imageName)) {
						unitFloorplans.push(img);
					}
				});

				const workflow =
					convertedData.workflow ||
					(svgImages.length === 0 && unitFloorplans.length > 0 ? 'unit-floorplan' : 'tower-qa');

				// ------------------------------------------------------------------
				// Unit floorplan edit: CSV + raster backplate. Never require tower SVG.
				// Same load path as the Floorplan Generator bridge (image then CSV).
				// ------------------------------------------------------------------
				if (workflow === 'unit-floorplan' || (svgImages.length === 0 && unitFloorplans.length > 0)) {
					console.log('📐 Unit-floorplan workflow — loading CSV + image (no tower SVG)');

					try {
						flipYX = false;
						const yxToggle = document.getElementById("yx-flip");
						if (yxToggle) yxToggle.checked = false;
					} catch (e) {
						console.warn('Could not set flipYX=false:', e);
					}

					const primary = unitFloorplans[0];
					const csvInfo = convertedData.cameraCSV;

					async function dataUrlToFile(dataUrl, filename, mimeHint) {
						const res = await fetch(dataUrl);
						const blob = await res.blob();
						return new File([blob], filename, { type: mimeHint || blob.type || 'application/octet-stream' });
					}

					try {
						const fpFile = await dataUrlToFile(
							primary.data,
							primary.imageName || 'backplate_image_floorplan.webp',
							primary.mimeType
						);
						let csvFile = null;
						if (csvInfo && csvInfo.data) {
							csvFile = new File(
								[csvInfo.data],
								csvInfo.csvName || 'csv_floorplan.csv',
								{ type: 'text/csv' }
							);
						}

						if (csvFile) {
							handleFileChange([fpFile], { pendingCsv: csvFile });
						} else {
							handleFileChange([fpFile]);
							console.warn('📐 No CSV in API payload — image only');
						}

						// List siblings in Check Floorplans for switching overlays
						window.unitFloorplans = unitFloorplans;
						loadApiImagesToImageList(unitFloorplans, 'unitFloorplans', { quiet: true });

						setupFtaCsvSaveButton(getProjectKey());
						showToast(
							csvFile
								? `Loaded floorplan + CSV (${csvFile.name})`
								: `Loaded floorplan image (no CSV found)`,
							'success'
						);
					} catch (e) {
						console.error('📐 Unit-floorplan load failed:', e);
						showToast('Failed to load floorplan/CSV from Project Opener', 'error');
					}
					return;
				}

				let backgroundImages = [];

				// Load SVG floorplates and collect background images (tower QA only)
				if (convertedData.images && convertedData.images.length > 0) {
					console.log('Processing images array:', convertedData.images.length, 'items');

					// Reset SVG state for API loading
					importedSVGs = [];
					currentSVGIndex = 0;
					globalSvgContainer.innerHTML = "";

				// Separate SVGs from background images (tower floorplates)
				// Also filter out unit floorplan images (they should be in unitFloorplans array, not images)
				backgroundImages = convertedData.images.filter(img => {
					// Exclude SVGs
					if (img.mimeType === 'image/svg+xml') return false;
					// Exclude unit floorplan images (they have "backplate_image_floorplan" in name, not "backplate_image_tower-floorplate")
					const imageName = img.imageName || '';
					if (imageName.includes('backplate_image_floorplan') && !imageName.includes('tower-floorplate')) {
						console.log(`⚠️ Filtering out unit floorplan from background images: ${imageName}`);
						return false;
					}
					return true;
				});

				console.log(`Found ${svgImages.length} SVG files and ${backgroundImages.length} background images (tower floorplates) in images array`);

					// Process each SVG
					for (const image of svgImages) {
						try {
							console.log(`Loading SVG: ${image.imageName}`);
							// Load SVG using existing logic (data is already processed in convertApiData)
							loadSVGFromData(image.data, image.imageName);
						} catch (error) {
							console.error(`Failed to load SVG ${image.imageName}:`, error);
						}
					}

					// Show image-list-container when SVGs are loaded
					if (svgImages.length > 0) {
						const imageListContainer = document.getElementById("image-list-container");
						if (imageListContainer && imageListContainer.classList.contains("hidden")) {
							console.log('Showing image-list-container after SVG load');
							imageListContainer.classList.remove("hidden");
						}
					}

					// Bind/update SVG name + prev/next row under the viewer
					if (importedSVGs.length > 0) {
						spawnSVGNavigation();
					}
				}

				// Extract unit floorplan images from images array if they're present there
				const unitFloorplanImagesFromImagesArray = convertedData.images ? convertedData.images.filter(img => {
					const imageName = img.imageName || '';
					return imageName.includes('backplate_image_floorplan') && !imageName.includes('tower-floorplate');
				}) : [];

				// Combine unitFloorplans from both sources
				let allUnitFloorplans = unitFloorplans.slice();
				if (unitFloorplanImagesFromImagesArray.length > 0) {
					console.log('📋 Found unit floorplan images in images array:', unitFloorplanImagesFromImagesArray.length, 'items');
					// Merge with existing unitFloorplans (avoid duplicates)
					unitFloorplanImagesFromImagesArray.forEach(img => {
						const exists = allUnitFloorplans.some(uf => uf.imageName === img.imageName);
						if (!exists) {
							allUnitFloorplans.push(img);
						}
					});
				}

				// Load unitFloorplans for overlay functionality (hover check)
				if (allUnitFloorplans.length > 0) {
					console.log('📋 Processing total unitFloorplans:', allUnitFloorplans.length, 'items for overlay functionality');
					// Store unit floorplans for later use
					window.unitFloorplans = allUnitFloorplans;

					// Load unit floorplans into imageList for overlay functionality (hover check)
					loadApiImagesToImageList(allUnitFloorplans, 'unitFloorplans');
				} else {
					console.log('📋 No unitFloorplans found for overlay functionality');
				}

				// Load background images (tower floorplates) via simulated drag-and-drop AFTER SVGs are loaded
				if (backgroundImages.length > 0) {
					console.log(`🏗️ Loading ${backgroundImages.length} background images (tower floorplates) via simulated drag-and-drop`);
					loadApiBackgroundImages(backgroundImages);
				} else {
					console.log('🏗️ No background images found to load');
				}
			} else if (convertedData.mode === 'roomscale-4') {
				// For roomscale mode, store assets but don't auto-load (user can load manually)
				console.log('Roomscale assets loaded via API:', {
					models: convertedData.models?.length || 0,
					csv: convertedData.cameraCSV ? 'present' : 'none',
					images: convertedData.images?.length || 0
				});

				// Store for manual loading by user
				if (convertedData.cameraCSV) {
					window.apiCameraCSV = convertedData.cameraCSV;
				}
				if (convertedData.models && convertedData.models.length > 0) {
					window.apiModels = convertedData.models;
				}
			}
		}

		// Load SVG from data (helper function to integrate with existing logic)
		function loadSVGFromData(svgData, filename) {
			console.log(`loadSVGFromData called for: ${filename}`);
			try {
				// Ensure svgData is a string
				let svgText = svgData;
				console.log(`SVG data type: ${typeof svgText}, length: ${svgText?.length}`);
				if (typeof svgText !== 'string') {
					console.warn(`SVG data for ${filename} is not a string, converting...`);
					if (svgText instanceof ArrayBuffer) {
						const decoder = new TextDecoder('utf-8');
						svgText = decoder.decode(svgText);
					} else if (svgText instanceof Uint8Array) {
						const decoder = new TextDecoder('utf-8');
						svgText = decoder.decode(svgText);
					} else {
						svgText = String(svgText);
					}
				}

				// Basic validation - check if it starts with SVG tag or XML declaration
				if (!svgText.trim().startsWith('<') && !svgText.trim().startsWith('<?xml')) {
					console.error(`SVG content for ${filename} doesn't appear to be valid SVG/XML:`, svgText.substring(0, 200));
					throw new Error('Content does not appear to be valid SVG');
				}

				console.log(`Parsing SVG: ${filename}`);
				// Parse and process the SVG similar to existing file loading
				const parser = new DOMParser();
				const svgDoc = parser.parseFromString(svgText, 'image/svg+xml');

				if (svgDoc.querySelector('parsererror')) {
					console.error(`SVG parsing error for ${filename}:`, svgDoc.querySelector('parsererror'));
					console.error(`First 500 chars of SVG content:`, svgText.substring(0, 500));
					throw new Error('Invalid SVG content');
				}

				const svgElement = svgDoc.documentElement;
				console.log(`SVG parsed successfully: ${filename}, element:`, svgElement.tagName);

				// Use existing SVG processing logic (same as in handleFileChange)
				// Store both lowercased name (for matching) and original basename (for export)
				const originalBasename = String(filename || "").replace(/\.[^/.]+$/, "");
				importedSVGs.push({ name: getBaseName(filename), originalName: originalBasename, element: svgElement });
				console.log(`Added SVG to importedSVGs. Total SVGs now: ${importedSVGs.length}`);

				// Process the SVG
				console.log(`Processing SVG with processSVG: ${filename}`);
				processSVG(svgElement);

				// Hover preview + Shape bench need path listeners even when Check Floorplans is empty
				console.log(`Setting up preview / overlay for ${filename} (imageList: ${imageList.length})`);
				previewBackplate(svgElement);

				console.log(`Successfully loaded SVG: ${filename}`);

			} catch (error) {
				console.error(`Error loading SVG ${filename}:`, error);
			}
		}

		// Load API background images (tower floorplates) via simulated drag-and-drop
		function loadApiBackgroundImages(apiImages) {
			console.log(`🏗️ loadApiBackgroundImages called with ${apiImages.length} background images`);
			console.log('Available SVGs:', importedSVGs.map(svg => svg.name));

			if (apiImages.length === 0 || importedSVGs.length === 0) {
				console.log('No background images or no SVGs loaded, skipping background image loading');
				return;
			}

			apiImages.forEach((imageData) => {
				console.log(`Processing background image: ${imageData.imageName}`);

				const matchedSvgs = findMatchedSvgObjects(
					imageData.imageName,
					importedSVGs,
				);
				console.log(
					`Image name: ${imageData.imageName} -> matches`,
					matchedSvgs.map((s) => s.name),
				);

				matchedSvgs.forEach((svgObj) => {
						console.log(`Found match! Loading ${imageData.imageName} as background for ${svgObj.name}`);

						const svgElement = svgObj.element;
						const viewBox = svgElement.getAttribute("viewBox").split(" ");

						// Remove any existing background images
						const existingImages = svgElement.querySelectorAll("image");
						existingImages.forEach(img => {
							const imgWidth = img.getAttribute("width");
							const imgHeight = img.getAttribute("height");

							if (imgWidth === viewBox[2] && imgHeight === viewBox[3]) {
								img.remove();
								console.log("Removed existing background image from SVG");
							}
						});

						// Remove existing foreignObject elements (videos)
						const existingForeignObjects = svgElement.querySelectorAll("foreignObject");
						existingForeignObjects.forEach(fo => {
							const foWidth = fo.getAttribute("width");
							const foHeight = fo.getAttribute("height");
							if (foWidth === viewBox[2] && foHeight === viewBox[3]) {
								fo.remove();
								console.log("Removed existing background video from SVG");
							}
						});

						// Create and add the background image
						const imageElement = document.createElementNS("http://www.w3.org/2000/svg", "image");
						imageElement.setAttribute("x", viewBox[0]);
						imageElement.setAttribute("y", viewBox[1]);
						imageElement.setAttribute("width", viewBox[2]);
						imageElement.setAttribute("height", viewBox[3]);
						imageElement.setAttribute("href", imageData.data); // Use the data URL
						imageElement.setAttribute("preserveAspectRatio", "xMidYMid meet");
						imageElement.setAttribute("data-original-filename", imageData.imageName || "");

						// Insert as the first child (background)
						if (svgElement.firstChild) {
							svgElement.insertBefore(imageElement, svgElement.firstChild);
						} else {
							svgElement.appendChild(imageElement);
						}

						console.log(`Successfully added background image ${imageData.imageName} to SVG ${svgObj.name}`);
				});
			});

			console.log(`Finished processing ${apiImages.length} background images`);
		}

		// Load backplate_image_floorplan files from File[] into imageList (Check Floorplans). Call after SVG load.
		function loadFloorplanFilesToImageList(files) {
			const floorplanFiles = Array.from(files).filter((f) => {
				const isImage =
					isRasterOrVideoFile(f) &&
					!String(f.type || "").startsWith("video/") &&
					!/\.(mp4|webm|ogg)$/i.test(f.name || "");
				const hasFloorplanInName =
					f.name.includes("backplate_image_floorplan") &&
					!f.name.includes("tower-floorplate");
				if (!isImage || !hasFloorplanInName) return false;
				if (isUnitPlateFileName(f.name)) return false;
				if (findMatchedSvgObjects(f.name, importedSVGs).length > 0) return false;
				return true;
			});
			if (floorplanFiles.length === 0) {
				if (_pendingCsvFilesForReScore && _pendingCsvFilesForReScore.length > 0) {
					const csvs = _pendingCsvFilesForReScore;
					_pendingCsvFilesForReScore = null;
					processMultipleCsvFiles(csvs);
				}
				return;
			}
			console.log(`📋 Auto-loading ${floorplanFiles.length} backplate_image_floorplan file(s) into Check Floorplans`);
			Promise.all(floorplanFiles.map((file) => new Promise((resolve, reject) => {
				const reader = new FileReader();
				reader.onload = (e) => resolve({ name: file.name, data: e.target?.result as string });
				reader.onerror = reject;
				reader.readAsDataURL(file);
			}))).then((results) => {
				imageList.splice(0, imageList.length);
				imageList.push(...results);
				const imageListContainer = document.getElementById("image-list-container");
				if (imageListContainer?.classList.contains("hidden")) imageListContainer.classList.remove("hidden");
				renderImageListCarousel();
				const svgElement = document.getElementById("svg-container")?.querySelector("svg");
				if (svgElement) previewBackplate(svgElement);
				showToast(`Loaded ${results.length} floorplan image(s) for overlay`, 'success');
				if (_pendingCsvFilesForReScore && _pendingCsvFilesForReScore.length > 0) {
					const csvs = _pendingCsvFilesForReScore;
					_pendingCsvFilesForReScore = null;
					processMultipleCsvFiles(csvs);
				}
			}).catch((err) => console.error('Error loading floorplan images:', err));
		}

		// Load API images into imageList for overlay / check-floorplans list
		function loadApiImagesToImageList(apiImages, source = 'unknown', opts = {}) {
			console.log(`🔄 loadApiImagesToImageList called with ${apiImages.length} images from source: ${source}`);
			console.log('API images:', apiImages.map(img => ({ name: img.imageName, mimeType: img.mimeType, dataLength: img.data?.length })));

			if (apiImages.length === 0) {
				console.log('No images to load');
				return;
			}

			if (imageList.length === 0) {
				console.log('Clearing existing imageList');
				imageList.splice(0, imageList.length);
			}

			let addedCount = 0;
			apiImages.forEach(img => {
				console.log(`Adding image: ${img.imageName}, mimeType: ${img.mimeType}, data length: ${img.data?.length}`);
				imageList.push({
					name: img.imageName,
					data: img.data
				});
				addedCount++;
			});

			console.log(`Added ${addedCount} images to imageList. Total images now: ${imageList.length}`);

			const imageListContainer = document.getElementById("image-list-container");
			if (imageListContainer) {
				if (imageListContainer.classList.contains("hidden")) {
					imageListContainer.classList.remove("hidden");
				}
			} else {
				console.error('Image list container not found!');
			}

			if (typeof renderImageListCarousel === 'function') {
				try { renderImageListCarousel(); } catch (e) { /* optional */ }
			}

			// Tower-QA overlay: attach preview listeners when an SVG is already present
			setTimeout(() => {
				const currentSVG = document.getElementById("svg-container")?.querySelector("svg");
				if (currentSVG) {
					previewBackplate(currentSVG);
				}
				if (importedSVGs.length > 0) {
					importedSVGs.forEach((svgInfo) => {
						previewBackplate(svgInfo.element);
					});
				}
			}, 100);

			console.log(`Successfully loaded ${apiImages.length} images from ${source}`);
			if (!opts.quiet) {
				showToast(`Loaded ${apiImages.length} floorplan image(s)`, 'success');
			}
		}

		/**
		 * Save edited room-label CSV back to the FTA file opened by Project Opener.
		 * Mirrors the Floorplan Generator bridge "Save to Floorplan Generator" button.
		 */
		function setupFtaCsvSaveButton(projectKey) {
			if (document.getElementById("fta-save-csv-btn")) return;
			const exportBtn = document.getElementById("export-csv-layer");
			if (!exportBtn || !exportBtn.parentElement) return;

			const btn = document.createElement("button");
			btn.id = "fta-save-csv-btn";
			btn.type = "button";
			btn.className = exportBtn.className || "button-style";
			btn.style.marginBottom = "10px";
			btn.style.marginLeft = "8px";
			btn.style.background = "#2a6";
			btn.style.color = "#fff";
			btn.textContent = "Save CSV to FTA";
			btn.title = "Write edited points back to the csv_floorplan file under For_The_App";

			btn.addEventListener("click", async () => {
				btn.disabled = true;
				try {
					const svg = document.querySelector("#svg-container svg");
					if (!svg) {
						showToast("No floorplan canvas to save from", "error");
						return;
					}
					const circles = Array.from(svg.querySelectorAll("g circle"));
					const rows = [];
					for (const c of circles) {
						const id = c.getAttribute("data-name") || c.getAttribute("id") || "";
						const cx = c.getAttribute("cx");
						const cy = c.getAttribute("cy");
						if (!id || cx == null || cy == null) continue;
						rows.push(`${id},${cx},${cy}`);
					}
					if (rows.length === 0) {
						showToast("No points to save", "warning");
						return;
					}
					const body = rows.join("\n") + "\n";
					const key = projectKey || getProjectKey() || "default";
					const resp = await fetch(`${API_BASE_URL}/api/project/${encodeURIComponent(key)}/csv`, {
						method: "PUT",
						headers: { "Content-Type": "text/csv" },
						body,
					});
					if (!resp.ok) {
						const txt = await resp.text();
						throw new Error(`HTTP ${resp.status}: ${txt}`);
					}
					const out = await resp.json().catch(() => ({}));
					showToast(
						out.written ? `Saved to FTA: ${out.written}` : "Saved CSV to FTA",
						"success"
					);
				} catch (e) {
					console.error("[ FTA Save ] failed:", e);
					showToast("Save to FTA failed: " + (e && e.message ? e.message : e), "error");
				} finally {
					btn.disabled = false;
				}
			});

			exportBtn.parentElement.appendChild(btn);
		}

