		function getOrCreatePointLayer() {
			const svg = globalSvgContainer.querySelector("svg");
			if (!svg) return null;
			let g = svg.querySelector("#g-instance");
			if (!g) {
				g = document.createElementNS("http://www.w3.org/2000/svg", "g");
				g.setAttribute("id", "g-instance");
				svg.appendChild(g);
			}
			return g;
		}

		function spawnCircle(id, cx, cy, data) {
			const g = getOrCreatePointLayer();
			if (!g) return null;
			const circle = document.createElementNS(
				"http://www.w3.org/2000/svg",
				"circle",
			);
			circle.setAttribute("id", id);
			circle.setAttribute("cx", cx);
			circle.setAttribute("cy", cy);
			circle.setAttribute("r", "30");
		circle.setAttribute("fill", "#87CEEB");
		circle.setAttribute("stroke", "none");
			data.forEach((e) => {
				circle.setAttribute(e.field, e.value);
			});
			g.appendChild(circle);

			return circle;
		}

		function isCsvFile(file) {
			if (!file) return false;
			const name = String(file.name || "").toLowerCase();
			return (
				file.type === "text/csv" ||
				file.type === "application/vnd.ms-excel" ||
				file.type === "application/csv" ||
				name.endsWith(".csv")
			);
		}

		function isSvgFile(file) {
			if (!file) return false;
			const name = String(file.name || "").toLowerCase();
			return file.type === "image/svg+xml" || name.endsWith(".svg");
		}

		function isRasterOrVideoFile(file) {
			if (!file) return false;
			const name = String(file.name || "").toLowerCase();
			const type = String(file.type || "").toLowerCase();
			return (
				type === "image/jpeg" ||
				type === "image/png" ||
				type === "image/webp" ||
				type.startsWith("video/") ||
				/\.(jpe?g|png|webp|mp4|webm|ogg)$/i.test(name)
			);
		}

