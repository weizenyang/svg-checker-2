			let dx = svgPt.x - edgeDragStartX;
			let dy = svgPt.y - edgeDragStartY;
			
			// SC-SEL-3: Apply axis lock when Shift is held
			const constrained = constrainAxisDelta(dx, dy, shiftHeld, svgPt.x, svgPt.y);
