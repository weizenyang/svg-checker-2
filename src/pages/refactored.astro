					type: "text/csv",
				});
			} catch (error) {
				console.error("Error fetching CSV data from server:", error);
			}

			if (imageFile && csvFile) {
				handleFileChange([imageFile], { pendingCsv: csvFile });
			} else if (imageFile) {
				handleFileChange(imageFile);
			} else if (csvFile) {
				handleFileChange(csvFile);
			}
