			if (isNaN(idx) || idx < 0 || idx >= pathEditVertices.length - 1) return;
			
			// SC-SEL-5: Handle multi-selection
			if (isCtrlOrCmd) {
				// Toggle this handle in selection
				toggleHandleSelection('edge', idx);
				renderPathEditHandles();
				return; // Don't start drag on Ctrl/Cmd click
			}
			
			// SC-SEL-5: If the handle is not selected, select it alone (Illustrator-style)
			if (!isHandleSelected('edge', idx)) {
				setHandleSelectionSingle('edge', idx);
				renderPathEditHandles();
