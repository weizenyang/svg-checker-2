		function highlightPathsWithoutMatchingImages() {
			const svgElement = document.getElementById("svg-container")?.querySelector("svg");
			if (!svgElement) return;
			const hasImages = imageList.length > 0;
			svgElement.querySelectorAll("path").forEach((path) => {
				const pathId = path.getAttribute("id") || path.id;
				const hasMatch = hasImages && pathId ? !!findMatchingImage(pathId) : false;
				if (!hasImages || hasMatch || !pathId) {
					path.classList.remove("no-matching-floorplan");
				} else {
					path.classList.add("no-matching-floorplan");
				}
			});
		}

