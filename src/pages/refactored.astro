		}

		function handleFilletDrag(svgPt) {
			if (!filletDragActive || filletDragIndex < 0) return;
			
			const v = pathEditVertices[filletDragIndex];
			const prev = pathEditVertices[filletDragIndex - 1];
			if (!v || !prev) return;
			
			// Determine the "prev" point for the incoming edge direction
			let prevX, prevY;
			if (prev.cmd === 'M') {
				// First vertex after M - incoming edge comes from last vertex before Z
				let lastBeforeZ = null;
				for (let i = pathEditVertices.length - 1; i >= 0; i--) {
					if (pathEditVertices[i].cmd === 'Z') continue;
					if (pathEditVertices[i].cmd !== 'M') {
						lastBeforeZ = pathEditVertices[i];
						break;
					}
				}
				if (lastBeforeZ) {
					prevX = lastBeforeZ.x;
					prevY = lastBeforeZ.y;
				} else {
					return;
				}
			} else {
				prevX = prev.x;
				prevY = prev.y;
			}
			
			// Compute drag distance along the edge direction
			const edgeDx = prevX - v.x;
			const edgeDy = prevY - v.y;
			const edgeLen = Math.sqrt(edgeDx * edgeDx + edgeDy * edgeDy);
			if (edgeLen < 0.001) return;
			
			// Project mouse delta onto edge direction
			const mouseDx = svgPt.x - filletDragStartX;
			const mouseDy = svgPt.y - filletDragStartY;
			const projectedDist = (mouseDx * edgeDx + mouseDy * edgeDy) / edgeLen;
			
			// New radius = initial + projected distance
			let newRadius = filletDragInitialRadius + projectedDist;
			
			// Clamp radius to adjacent edge lengths
			const maxRadius = computeMaxFilletRadius(pathEditVertices, filletDragIndex);
			newRadius = Math.max(0, Math.min(newRadius, maxRadius));
			
			v.filletRadius = newRadius;
			applyVertexChanges();
		}

		function endFilletDrag() {
			if (filletDragActive) {
				filletDragActive = false;
				filletDragIndex = -1;
				scheduleCsvPathCollisions();
			}
		}

		// SC-ROUND-1: Compute maximum fillet radius for a vertex (half of shorter adjacent edge)
		function computeMaxFilletRadius(vertices, vertexIdx) {
			const v = vertices[vertexIdx];
			const prev = vertices[vertexIdx - 1];
			let next = vertices[vertexIdx + 1];
			
			if (!v || !prev) return 0;
			
			// Determine the "prev" point for the incoming edge
			let prevX, prevY;
			if (prev.cmd === 'M') {
				// First vertex after M - incoming edge comes from last vertex before Z
				let lastBeforeZ = null;
				for (let i = vertices.length - 1; i >= 0; i--) {
					if (vertices[i].cmd === 'Z') continue;
					if (vertices[i].cmd !== 'M') {
						lastBeforeZ = vertices[i];
						break;
					}
				}
				if (lastBeforeZ) {
					prevX = lastBeforeZ.x;
					prevY = lastBeforeZ.y;
				} else {
					return 0;
				}
			} else {
				prevX = prev.x;
				prevY = prev.y;
			}
			
			// Compute edge lengths
			const len1 = Math.sqrt((v.x - prevX) ** 2 + (v.y - prevY) ** 2);
			
			let len2;
			if (next && next.cmd === 'Z') {
				// Closing corner - measure to first vertex after M
				const firstAfterM = vertices.find((vv, i) => i > 0 && vv.cmd !== 'M' && vv.cmd !== 'Z');
				if (firstAfterM) {
					len2 = Math.sqrt((firstAfterM.x - v.x) ** 2 + (firstAfterM.y - v.y) ** 2);
				} else {
					len2 = len1;
				}
			} else if (next) {
				len2 = Math.sqrt((next.x - v.x) ** 2 + (next.y - v.y) ** 2);
			} else {
				len2 = len1;
			}
			
			// Max radius is half of shorter edge (to avoid overlapping fillets)
			return Math.min(len1, len2) * 0.5;
		}

		// ─────────────────────────────────────────────────────────────────────────────
		// SC-SEL-2: Hit-test for selectable paths at a point (through overlays)
		// ─────────────────────────────────────────────────────────────────────────────

		function getSelectablePathAtPoint(svgPt) {
			const svg = document.querySelector('#svg-container svg');
			if (!svg) return null;
			
			const paths = Array.from(svg.querySelectorAll('path')).filter(isSelectablePath);
			let smallestPath = null;
			let smallestArea = Infinity;
			
			for (const path of paths) {
				try {
					if (pathContainsUserPoint(path, svg, svgPt.x, svgPt.y)) {
						const bbox = path.getBBox();
						const area = bbox.width * bbox.height;
						if (area < smallestArea) {
							smallestArea = area;
							smallestPath = path;
						}
					}
				} catch (e) {
					// Skip paths that fail hit-testing
				}
			}
			
			return smallestPath;
		}

		// ─────────────────────────────────────────────────────────────────────────────
