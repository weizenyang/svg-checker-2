					}
				} else if (v.cmd === 'T') {
					// SC-ROUND-1: Preserve smooth quadratic Bézier (T) commands
					newD += `T ${v.x} ${v.y} `;
				} else if (v.cmd === 'A') {
					// SC-ROUND-1: Preserve arc commands with full parameters
					if (v.rx !== undefined && v.ry !== undefined) {
						newD += `A ${v.rx} ${v.ry} ${v.rotation || 0} ${v.largeArc || 0} ${v.sweep || 0} ${v.x} ${v.y} `;
					} else {
						newD += `L ${v.x} ${v.y} `;
					}
				}
