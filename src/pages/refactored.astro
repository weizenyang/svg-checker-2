			// SC-SEL-5: Start multi-handle drag if there are selections
			if (handleSelection.length > 0) {
				multiHandleDragActive = true;
				multiHandleDragStartX = svgPt.x;
				multiHandleDragStartY = svgPt.y;
			}
			
			// Keep legacy single-drag tracking for compatibility
