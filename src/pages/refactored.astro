		// Floorplan Generator bridge (CSV roundtrip)
		//
		// Cross-origin notes:
		//   The bridge server sends CORS headers (Access-Control-Allow-Origin etc.),
		//   so cross-origin fetches from any page origin are allowed. Do NOT add a
		//   client-side origin "guard" that blocks fetches preemptively — it produces
		//   a misleading "Cross-origin restriction" error even when the bridge's CORS
		//   is correct. Just attempt the fetch; the catch handler below reports a
		//   helpful message only on a genuine failure.
		//
		//   The desktop app's "Edit CSV in Web Tool" action opens the checker proxied
		//   through the bridge itself, e.g.
		//     http://127.0.0.1:8765/refactored/?bridge=http://127.0.0.1:8765/session/<id>
		//   so page origin and bridge origin already match and even non-CORS setups work.
		// =========================================================
		// When this page is opened with `?bridge=<url>` from the desktop
		// Floorplan Generator, the local Python HTTP bridge serves:
		//   GET <bridge>/manifest.json  -> session metadata
		//   GET <bridge>/floorplan.png  -> type backplate (same file used for s1 & s2 names in UI)
		//   GET <bridge>/floorplan_s2.png -> still available (same bytes; optional)
		//   GET <bridge>/csv            -> 3-col `label,x,y` type-template CSV
		//                                  (template canvas space; column order vs disk only)
		//   PUT <bridge>/csv            -> save edits back; bridge swaps to disk
		//                                  `label,y,x` and rewrites the per-type templates
		// The bridge expects `label,x,y` in both directions, so we force
		// `flipYX = false` while bridge mode is active to match the
		// existing 3-col ingest path (see handleFileChange CSV branch).
		// Floorplan PNG and CSV are loaded via handleFileChange(..., { pendingCsv })
		// so CSV runs only after the raster FileReader onload inserts the backplate.
		(function setupFloorplanBridge() {
			const params = new URL(window.location.href).searchParams;
			const bridgeUrl = params.get("bridge");
			if (!bridgeUrl) return;

			console.log("[ FG Bridge ] active:", bridgeUrl);

			try {
				flipYX = false;
				const yxToggle = document.getElementById("yx-flip") as HTMLInputElement | null;
				if (yxToggle) {
					yxToggle.checked = false;
				}
			} catch (e) {
				console.warn("[ FG Bridge ] could not flip flipYX toggle:", e);
			}

			function showBridgeBanner(text, color) {
				let banner = document.getElementById("fg-bridge-banner");
				if (!banner) {
					banner = document.createElement("div");
					banner.id = "fg-bridge-banner";
					banner.style.position = "fixed";
					banner.style.top = "8px";
					banner.style.left = "50%";
					banner.style.transform = "translateX(-50%)";
					banner.style.padding = "6px 14px";
					banner.style.borderRadius = "6px";
					banner.style.zIndex = "9999";
					banner.style.fontFamily = "system-ui, sans-serif";
					banner.style.fontSize = "13px";
					banner.style.boxShadow = "0 2px 8px rgba(0,0,0,0.2)";
					document.body.appendChild(banner);
				}
				banner.style.background = color || "#333";
				banner.style.color = "#fff";
				banner.textContent = text;
				banner.style.display = "block";
				clearTimeout((banner as any)._fgTimer);
				(banner as any)._fgTimer = setTimeout(() => {
					banner.style.display = "none";
				}, 4500);
			}

			async function loadFromBridge() {
				let manifest: any = null;
				try {
					const r = await fetch(bridgeUrl + "/manifest.json", { cache: "no-store" });
					if (r.ok) manifest = await r.json();
				} catch (e) {
					console.warn("[ FG Bridge ] manifest fetch failed:", e);
				}

				const s1Base =
					(manifest && manifest.floorplan_s1_basename) ||
					"backplate_image_floorplan.png";
				const backplateFiles: File[] = [];

				const baseName =
					manifest && manifest.unit_name
						? `csv_floorplan_${manifest.unit_name}.csv`
						: "unit.csv";
				let fpFile: File;
				let csvFile: File;
				try {
					const [fpResp, csvResp] = await Promise.all([
						fetch(bridgeUrl + "/floorplan.png", { cache: "no-store" }),
						fetch(bridgeUrl + "/csv", { cache: "no-store" }),
					]);
					if (!fpResp.ok) throw new Error("floorplan.png HTTP " + fpResp.status);
					if (!csvResp.ok) throw new Error("csv HTTP " + csvResp.status);
					const fpBlob = await fpResp.blob();
					const csvText = await csvResp.text();
					fpFile = new File([fpBlob], s1Base, {
						type: fpBlob.type || "image/png",
					});
					backplateFiles.push(fpFile);
					// s1/s2 type backplates are the same asset; duplicate the blob for the
					// s2 filename so "Check Floorplans" lists both without a second request.
					if (manifest && manifest.floorplan_s2_basename) {
						const f2 = new File([fpBlob], manifest.floorplan_s2_basename, {
							type: fpBlob.type || "image/png",
						});
						backplateFiles.push(f2);
					}
					csvFile = new File([csvText], baseName, { type: "text/csv" });
					// Chain CSV after the floorplan data URL is applied (no fixed delay)
					handleFileChange([fpFile], { pendingCsv: csvFile });
				} catch (e) {
					console.error("[ FG Bridge ] floorplan/csv load failed:", e);
					const msg =
						e instanceof TypeError && /Failed to fetch/i.test(e.message)
							? "Bridge unreachable — is the Floorplan Generator still running and is the session still open?"
							: "Could not load floorplan or CSV from Floorplan Generator";
					showBridgeBanner(msg, "#a23");
					return;
				}

				// "Check Floorplans" overlay: both type backplates with real backplate_ filenames
				if (backplateFiles.length > 0 && typeof loadFloorplanFilesToImageList === "function") {
					setTimeout(() => {
						try {
							loadFloorplanFilesToImageList(backplateFiles);
						} catch (e) {
							console.warn("[ FG Bridge ] loadFloorplanFilesToImageList:", e);
						}
					}, 500);
				}

				const tlabel = manifest && manifest.type_name ? manifest.type_name : "";
				const ulabel = manifest && manifest.unit_name ? manifest.unit_name : "";
				const label = tlabel
					? `Floorplan Generator — type: ${tlabel}` + (ulabel ? ` (${ulabel})` : "")
					: ulabel
						? `Bridged from Floorplan Generator: ${ulabel}`
						: "Bridged from Floorplan Generator";
				showBridgeBanner(label, "#2a6");
			}

			function injectSaveBackButton() {
				if (document.getElementById("fg-save-back-btn")) return;
				const exportBtn = document.getElementById("export-csv-layer");
				if (!exportBtn || !exportBtn.parentElement) return;

				const btn = document.createElement("button");
				btn.id = "fg-save-back-btn";
				btn.type = "button";
				btn.className = exportBtn.className || "button-style";
				btn.style.marginBottom = "10px";
				btn.style.marginLeft = "8px";
				btn.style.background = "#2a6";
				btn.style.color = "#fff";
				btn.textContent = "Save to Floorplan Generator";
				btn.title = "Save edited points back to the per-type template CSV";

				btn.addEventListener("click", async () => {
					btn.disabled = true;
					try {
						const svg = document.querySelector("#svg-container svg");
						if (!svg) {
							showBridgeBanner("No SVG to save", "#a23");
							return;
						}
						const circles = Array.from(svg.querySelectorAll("g circle"));
						const rows: string[] = [];
						for (const c of circles) {
							const id = c.getAttribute("data-name") || c.getAttribute("id") || "";
							const cx = c.getAttribute("cx");
							const cy = c.getAttribute("cy");
							if (!id || cx == null || cy == null) continue;
							rows.push(`${id},${cx},${cy}`);
						}
						if (rows.length === 0) {
							showBridgeBanner("No points to save", "#a23");
							return;
						}
						const body = rows.join("\n");
						const resp = await fetch(bridgeUrl + "/csv", {
							method: "PUT",
							headers: { "Content-Type": "text/csv" },
							body,
						});
						if (!resp.ok) {
							const txt = await resp.text();
							throw new Error("HTTP " + resp.status + ": " + txt);
						}
						const out = await resp.json().catch(() => ({}));
						const w1 = out && out.written ? out.written : "";
						const w2 = out && out.written_s2 ? out.written_s2 : "";
						let msg = "Saved. Floorplan Generator template(s) updated.";
						if (w1) msg += " s1: " + w1;
						if (w2) msg += " s2: " + w2;
						showBridgeBanner(msg, "#2a6");
						// Optional: re-fetch transformed CSV from bridge (matches disk after round-trip)
						try {
							const verify = await fetch(bridgeUrl + "/csv", { cache: "no-store" });
							if (verify.ok) {
								console.log("[ FG Bridge ] GET /csv after save: OK, bytes=", (await verify.text()).length);
							}
						} catch (e) {
							console.warn("[ FG Bridge ] post-save csv verify fetch:", e);
						}
					} catch (e) {
						console.error("[ FG Bridge ] save failed:", e);
						showBridgeBanner("Save failed: " + (e as any).message, "#a23");
					} finally {
						btn.disabled = false;
					}
				});

				exportBtn.parentElement.appendChild(btn);
			}

			injectSaveBackButton();
			loadFromBridge();
		})();

		function openShapeBenchmarkDialog() {
			const toggle = document.getElementById("shape-benchmark-toggle");
			const dialog = document.getElementById("shape-benchmark-dialog") as HTMLDialogElement | null;
			if (!dialog || dialog.open) return;
			toggle?.setAttribute("aria-expanded", "true");
			dialog.showModal();
		}

		// Silhouette benchmark controls open in a dialog from the compact button.
		(function setupSilhouetteBenchToggle() {
			const toggle = document.getElementById("shape-benchmark-toggle");
			const dialog = document.getElementById("shape-benchmark-dialog") as HTMLDialogElement | null;
			const closeBtn = document.getElementById("shape-benchmark-dialog-close");
			if (!toggle || !dialog) return;
			toggle.addEventListener("click", () => {
				openShapeBenchmarkDialog();
			});
			const closeDialog = () => {
				dialog.close();
				toggle.setAttribute("aria-expanded", "false");
			};
			closeBtn?.addEventListener("click", closeDialog);
			dialog.addEventListener("close", () => {
				toggle.setAttribute("aria-expanded", "false");
			});
			dialog.addEventListener("click", (e) => {
				if (e.target === dialog) closeDialog();
			});
		})();
	</script>
</html>
