		function uploadImages(e) {
			const files = Array.from(e.target.files);

			const readFile = (file) => {
				return new Promise((resolve, reject) => {
					const reader = new FileReader();
					reader.onload = (data) =>
						resolve({ name: file.name, data: data.target.result });
					reader.onerror = (error) => reject(error);
					reader.readAsDataURL(file);
				});
			};

			Promise.all(Array.from(files).map(readFile))
				.then((results) => {
					imageList.splice(0, imageList.length);
					imageList.push(...results);
					renderImageListCarousel();
					
					// Only set up preview if SVG exists
					const svgElement = document.getElementById("svg-container")?.querySelector("svg");
					if (svgElement) {
						previewBackplate(svgElement);
					} else {
						console.log("No SVG found yet - preview will be set up when SVG is loaded");
					}
				})
				.catch((error) =>
					console.error("Error loading images:", error),
				);
		}

		// Helper function to parse image name and extract the 4th segment (with 2 dashes)
		function parseImageName(imageName) {
			if (!imageName) return null;
			const parts = imageName.split("_");
			if (parts.length < 4) return null;
			
			// Find the 4th segment (index 3) that contains exactly 2 dashes
			const fourthSegment = parts[3];
			if (!fourthSegment) return null;
			
			// Count dashes in the 4th segment
			const dashCount = (fourthSegment.match(/-/g) || []).length;
			if (dashCount === 2) {
				return fourthSegment;
			}
			
			return null;
		}

		// Helper function to get the unit identifier from a name (handles both image names and unit names)
		function getUnitIdentifier(name) {
			if (!name) return null;
			
			// First try parsing as image name (has 4+ segments with _)
			const parsedFromImage = parseImageName(name);
			if (parsedFromImage) return parsedFromImage;
			
			// If not found, check if the name itself is already in the format (e.g., "a-01-01")
			// Check if it has exactly 2 dashes (unit identifier format)
			const dashCount = (name.match(/-/g) || []).length;
			if (dashCount === 2 && !name.includes("_")) {
				// It's already a unit identifier (e.g., "a-01-01")
				return name;
			}
			
			return null;
		}

		// Helper function to get or create transformation entry
		function getImageTransform(imageName) {
			const identifier = getUnitIdentifier(imageName);
			if (!identifier) return null;
			
			if (!imageTransformLookup[identifier]) {
				imageTransformLookup[identifier] = {
					name: identifier,
					flip: false,
					rotation: 0
				};
			}
			
			return imageTransformLookup[identifier];
		}

		// Helper function to apply transformation to image element
		function applyImageTransform(imgElement, transform, importedRotation = null, importedFlip = null) {
			if (!imgElement || !transform) return;
			
			// Set transform origin to center (50% 50%) for rotation around center
			imgElement.style.transformOrigin = "center center";
			imgElement.style.transformOrigin = "50% 50%";
			
			// For preview: only use the CHANGE rotation and flip, not the final values
			// The final values (importedRotation + change, importedFlip XOR change) are only for export
			const rotationChange = transform.rotation || 0;
			
			// Calculate final flip to determine rotation direction (needed for rotation conversion)
			// Final flip: importedFlip XOR change
			const finalFlip = importedFlip !== null ? (importedFlip !== transform.flip) : transform.flip;
			
			// Convert rotation based on final flip state:
			// - If final flip is true: rotation is counter-clockwise (needs negation)
			// - If final flip is false: rotation is clockwise (no negation)
			const htmlRotation = finalFlip ? -rotationChange : rotationChange;
			
			// For preview: only use the change flip, not the final flip
			const flipChange = transform.flip || false;
			
			// Build transform string - apply rotation and flip
			let transformParts = [];
			
			// Apply change rotation only (converted to HTML convention)
			if (htmlRotation !== 0) {
				transformParts.push(`rotate(${htmlRotation}deg)`);
			}
			
			// Apply change flip only
			if (flipChange) {
				transformParts.push(`scaleX(-1)`);
			}
			
			// Combine all transforms
			const transformString = transformParts.join(" ");
			imgElement.style.transform = transformString || "none";
		}

		// Helper function to update preview text with transform values
		function updatePreviewText(imageName, transform) {
			const previewTextEl = document.getElementById("image-previewer-text");
			if (!previewTextEl || !imageName) return;
			
			// Find the original image to get its name
			const selectedImage = imageList.find((img) => img.name === imageName);
			if (!selectedImage) return;
			
			// Check if this unit exists in imported unit-reference
			// Match by the 4th segment (with 2 dashes) from the image name, or direct match for unit names
			// NOTE: Sequence of loading doesn't matter - matching happens on hover after all data is available
			const imageIdentifier = getUnitIdentifier(imageName);
			let importedUnit = null;
			
			console.log("🔍 Hover - Unit Matching:", {
				imageName: imageName,
				imageIdentifier: imageIdentifier,
				hasImportedData: !!importedUnitReference,
				importedDataCount: importedUnitReference?.length || 0,
				imageListCount: imageList.length
			});
			
			if (imageIdentifier && importedUnitReference) {
				// Try to find matching unit by identifier (handles both image names and unit names)
				importedUnit = importedUnitReference.find((unit: any) => {
					const unitIdentifier = getUnitIdentifier(unit.name || "");
					const matches = unitIdentifier === imageIdentifier;
					if (matches) {
						console.log("✅ Match found:", {
							unitName: unit.name,
							unitIdentifier: unitIdentifier,
							imageIdentifier: imageIdentifier,
							unitData: {
								name: unit.name,
								type: unit.type,
								rotation: unit.rotation,
								flip: unit.flip
							}
						});
					}
					return matches;
				});
				
				if (!importedUnit && imageIdentifier) {
					const availableIdentifiers = importedUnitReference
						.map((u: any) => getUnitIdentifier(u.name || ""))
						.filter(Boolean);
					console.log("❌ No match found for imageIdentifier:", imageIdentifier, "Available identifiers:", availableIdentifiers);
				}
			} else if (imageIdentifier) {
				console.log("⚠️ No imported unit-reference data available yet");
			} else {
				console.log("⚠️ Could not extract identifier from image name:", imageName);
			}
			
			// Get rotation CHANGE from transform (this is the delta, not the absolute value)
			const rotationChange = transform?.rotation || 0;
			const currentFlip = transform?.flip || false;
			
			// Get imported rotation (convert string to number if needed)
			const importedRotation = importedUnit ? 
				(typeof importedUnit.rotation === 'string' ? parseInt(importedUnit.rotation) : importedUnit.rotation) : 
				null;
			const importedFlip = importedUnit ? 
				(typeof importedUnit.flip === 'string' ? importedUnit.flip === 'true' : importedUnit.flip) : 
				null;
			
			// Calculate final rotation: importedRotation + rotationChange (change is added to imported)
			let finalRotation = importedRotation !== null ? importedRotation + rotationChange : rotationChange;
			
			// Calculate final flip value (imported XOR change)
			const finalFlip = importedFlip !== null ? (importedFlip !== currentFlip) : currentFlip;
			
			// Apply 180-degree offset if flip is true and rotation is 90/-90
			finalRotation = applyFlipRotationOffset(finalRotation, finalFlip);
			
			// Log offsets and changes
			console.log("📊 Unit Offsets & Changes:", {
				unitName: imageName,
				imageIdentifier: imageIdentifier,
				importedUnit: importedUnit ? {
					name: importedUnit.name,
					type: importedUnit.type,
					rotation: importedUnit.rotation,
					flip: importedUnit.flip
				} : null,
				currentTransform: transform ? {
					rotationChange: rotationChange,
					flipChange: currentFlip
				} : null,
				offsets: {
					rotation: importedRotation !== null ? {
						imported: importedRotation,
						change: rotationChange,
						final: finalRotation
					} : null,
					flip: importedFlip !== null ? {
						imported: importedFlip,
						change: currentFlip,
						final: finalFlip
					} : null
				}
			});
			
			// Format transform values
			let transformParts = [];
			let rotationDisplay = "";
			
			// If imported data exists AND transform has been applied, show change format
			if (importedRotation !== null && transform) {
				// Show: importedRotation -> finalRotation (where finalRotation = importedRotation + change + offset if applicable)
				rotationDisplay = `rot:${importedRotation}° -> ${finalRotation}°`;
				transformParts.push(rotationDisplay);
			} else if (transform && rotationChange !== 0) {
				// No imported data, just show the change as final rotation
				rotationDisplay = `rot:${finalRotation}°`;
				transformParts.push(rotationDisplay);
			} else if (importedRotation !== null) {
				// Show imported rotation even if no transform applied yet
				rotationDisplay = `rot:${importedRotation}°`;
				transformParts.push(rotationDisplay);
			}
			
			// Add flip if present - show final flip value (imported XOR change)
			if (transform) {
				if (finalFlip) {
					if (importedFlip !== null) {
						// Show imported -> final format
						transformParts.push(`<br>flip:${importedFlip} -> ${finalFlip}`);
					} else {
						transformParts.push("<br>flip:true");
					}
				}
			} else if (importedFlip !== null && importedFlip) {
				// Show imported flip if no transform
				transformParts.push("<br>flip:true");
			}
			
			// Determine if rotation display should be blue (exists in imported data)
			const rotationStyle = importedUnit && importedRotation !== null ? "color: #3b82f6; font-weight: normal;" : "font-weight: normal; color: #666;";
			const nameStyle = "font-weight: normal;";
			
			// Create structure with flex layout for spacing
			if (transformParts.length > 0) {
				previewTextEl.innerHTML = `
					<div style="display: flex; justify-content: space-between; align-items: center; width: 100%; font-size: 10px; font-weight: normal;">
						<span style="${nameStyle}">${selectedImage.name}</span>
						<span style="${rotationStyle}">${transformParts.join(", ")}</span>
					</div>
				`;
			} else {
				previewTextEl.innerHTML = `<div style="font-size: 10px; font-weight: normal;"><span style="${nameStyle}">${selectedImage.name}</span></div>`;
			}
		}

		// Function to get the image transformation lookup object
		function getImageTransformLookup() {
			// Return array of transformation objects
			return Object.values(imageTransformLookup);
		}

		// Expose lookup on window for debugging/export
		(window as any).getImageTransformLookup = getImageTransformLookup;

		// Find matching floorplan image for a path ID (same logic as hover handler)
		function findMatchingImage(pathId) {
			if (!pathId || imageList.length === 0) return null;
			const textReplacement = document.getElementById("text-replacement")?.value || "";
			if (useDefaultMatching) {
				const pathIdParts = pathId.split("_");
				const pathFinalThreeElements = pathIdParts.slice(-3).join("_");
				const pathNormalized = pathFinalThreeElements.replace(/[\s\-_]/g, "").toLowerCase();
				let match = imageList.find((image) => {
					const imageNormalized = image.name.replace(/[\s\-_]/g, "").toLowerCase();
					return imageNormalized.includes(pathNormalized);
				});
				if (!match) {
					match = imageList.find((image) =>
						image.name.split("_").join("").split("-").join("").includes(
							pathId.split("_").join("").split("-").join("").replace(textReplacement, "")
						)
					);
				}
				return match || null;
			}
			return imageList.find((image) =>
				image.name.split("_").join("").split("-").join("").includes(
					pathId.split("_").join("").split("-").join("").replace(textReplacement, "")
				)
			) || null;
		}

		function sanitizeZipFolderSegment(name) {
			return (
				String(name || "svg")
					.replace(/\.svg$/i, "")
					.replace(/[/\\:*?"<>|]+/g, "_")
					.replace(/\s+/g, "_")
					.slice(0, 64) || "svg"
			);
		}

		/**
		 * Add one SVG file, matched floorplans, and full-viewbox background images to zip.
		 * @param {InstanceType<typeof JSZip>} zip
		 * @param {{ name: string, element: SVGElement }} svgObj
		 * @param {string} pathPrefix use "" for flat zip or "folder/" for nested
		 * @returns {{ fileCount: number }}
		 */
		function addSvgBundleToZip(zip, svgObj, pathPrefix) {
			const prefix = pathPrefix || "";
			const svgEl = svgObj.element;
			const viewBox = svgEl.getAttribute("viewBox")?.split(" ").map(Number) || [0, 0, 4096, 4096];
			const vbW = viewBox[2];
			const vbH = viewBox[3];
			const seen = new Set();

			let svgName = svgObj.name || "floorplan";
			if (!svgName.toLowerCase().endsWith(".svg")) svgName += ".svg";
			zip.file(prefix + svgName, new XMLSerializer().serializeToString(svgEl.cloneNode(true)));
			seen.add(svgName);

			const matchingFloorplans = new Map();
			svgEl.querySelectorAll("path[id]").forEach((path) => {
				const match = findMatchingImage(path.id || path.getAttribute("id"));
				if (match && !matchingFloorplans.has(match.name)) {
					matchingFloorplans.set(match.name, match);
				}
			});
			matchingFloorplans.forEach((img) => {
				let name = img.name || "image";
				if (!name.includes(".")) {
					const m = (img.data || "").match(/data:image\/(\w+);/);
					name += m ? "." + m[1] : ".png";
				}
				if (seen.has(name)) {
					const base = name.replace(/\.[^/.]+$/, "");
					const ext = name.split(".").pop();
					let i = 1;
					while (seen.has(`${base}_${i}.${ext}`)) i++;
					name = `${base}_${i}.${ext}`;
				}
				seen.add(name);
				const m = (img.data || "").match(/^data:[^;]+;base64,(.+)$/);
				if (m) zip.file(prefix + name, m[1], { base64: true });
			});

			let bgCount = 0;
			svgEl.querySelectorAll("image").forEach((imgEl, idx) => {
				const w = imgEl.getAttribute("width");
				const h = imgEl.getAttribute("height");
				if (w == vbW && h == vbH) {
					const href =
						imgEl.getAttribute("href") || imgEl.getAttributeNS("http://www.w3.org/1999/xlink", "href");
					const origName = imgEl.getAttribute("data-original-filename");
					let name = origName || `tower-floorplate_${idx}.png`;
					if (!name.includes(".")) {
						const mt = (href || "").match(/data:image\/(\w+);/);
						name += mt ? "." + mt[1] : ".png";
					}
					if (seen.has(name)) {
						const base = name.replace(/\.[^/.]+$/, "");
						const ext = name.split(".").pop();
						let i = 1;
						while (seen.has(`${base}_${i}.${ext}`)) i++;
						name = `${base}_${i}.${ext}`;
					}
					seen.add(name);
					const m = (href || "").match(/^data:[^;]+;base64,(.+)$/);
					if (m) {
						zip.file(prefix + name, m[1], { base64: true });
						bgCount++;
					}
				}
			});

			return { fileCount: 1 + matchingFloorplans.size + bgCount };
		}

		async function runDownloadCanvasZip(scope) {
			const trigger = document.getElementById("download-canvas-zip-trigger");
			const label = document.getElementById("download-canvas-zip-label");
			if (!trigger || !label) return;

			if (scope === "this") {
				const currentSVGObj = importedSVGs?.[currentSVGIndex];
				if (!currentSVGObj) {
					showToast("No SVG loaded to download", "warning");
					return;
				}
				trigger.disabled = true;
				label.textContent = "Zipping…";
				try {
					const zip = new JSZip();
					const { fileCount } = addSvgBundleToZip(zip, currentSVGObj, "");
					const blob = await zip.generateAsync({ type: "blob" });
					const a = document.createElement("a");
					a.href = URL.createObjectURL(blob);
					a.download = "canvas-files.zip";
					a.click();
					URL.revokeObjectURL(a.href);
					showToast(`Downloaded ${fileCount} file(s) (this SVG)`, "success");
				} catch (err) {
					console.error("ZIP download error:", err);
					showToast("Download failed", "error");
				} finally {
					trigger.disabled = false;
					label.textContent = "Download ZIP";
				}
				return;
			}

			if (scope === "all") {
				if (!importedSVGs?.length) {
					showToast("No SVGs loaded to download", "warning");
					return;
				}
				trigger.disabled = true;
				label.textContent = "Zipping…";
				try {
					const zip = new JSZip();
					let totalFiles = 0;
					importedSVGs.forEach((svgObj, idx) => {
						const folder = `${idx}_${sanitizeZipFolderSegment(svgObj.name)}`;
						const { fileCount } = addSvgBundleToZip(zip, svgObj, `${folder}/`);
						totalFiles += fileCount;
					});
					const blob = await zip.generateAsync({ type: "blob" });
					const a = document.createElement("a");
					a.href = URL.createObjectURL(blob);
					a.download = "all-canvas-files.zip";
					a.click();
					URL.revokeObjectURL(a.href);
					showToast(
						`Downloaded ${totalFiles} file(s) from ${importedSVGs.length} SVG(s)`,
						"success",
					);
				} catch (err) {
					console.error("ZIP download error:", err);
					showToast("Download failed", "error");
				} finally {
					trigger.disabled = false;
					label.textContent = "Download ZIP";
				}
			}
		}

		(() => {
			const wrap = document.getElementById("download-canvas-zip-wrap");
			const trigger = document.getElementById("download-canvas-zip-trigger");
			const menu = document.getElementById("download-canvas-zip-menu");
			if (!wrap || !trigger || !menu) return;

			function closeMenu() {
				menu.classList.add("hidden");
				trigger.setAttribute("aria-expanded", "false");
			}
			function toggleMenu() {
				const open = menu.classList.contains("hidden");
				if (open) {
					menu.classList.remove("hidden");
					trigger.setAttribute("aria-expanded", "true");
				} else closeMenu();
			}

			trigger.addEventListener("click", (e) => {
				e.stopPropagation();
				toggleMenu();
			});
			menu.querySelectorAll(".download-canvas-zip-option").forEach((el) => {
				el.addEventListener("click", async (e) => {
					e.stopPropagation();
					const scope = el.getAttribute("data-zip-scope");
					closeMenu();
					await runDownloadCanvasZip(scope);
				});
			});
			document.addEventListener("click", closeMenu);
		})();

		(() => {
			const wrap = document.getElementById("export-menu-wrap");
			const trigger = document.getElementById("export-menu-trigger");
			const menu = document.getElementById("export-menu");
			if (!wrap || !trigger || !menu) return;

			function closeMenu() {
				menu.classList.remove("flex");
				menu.classList.add("hidden");
				trigger.setAttribute("aria-expanded", "false");
			}
			function openMenu() {
				menu.classList.remove("hidden");
				menu.classList.add("flex");
				trigger.setAttribute("aria-expanded", "true");
			}
			function toggleMenu() {
				if (menu.classList.contains("hidden")) openMenu();
				else closeMenu();
			}

			trigger.addEventListener("click", (e) => {
				e.stopPropagation();
				toggleMenu();
			});
			menu.addEventListener("click", (e) => {
				e.stopPropagation();
			});
