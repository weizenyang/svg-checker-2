				if (isCornerFilletEligible(pathEditVertices, i)) {
					const filletHandle = createFilletHandle(i, v, scale);
					if (filletHandle) {
						ui.appendChild(filletHandle);
					}
				}

				const nextIdx = i + 1;
				if (nextIdx < pathEditVertices.length) {
					const nextV = pathEditVertices[nextIdx];
					if (nextV.cmd !== 'Z' && nextV.cmd !== 'M') {
						const midX = (v.x + nextV.x) / 2;
						const midY = (v.y + nextV.y) / 2;

						// SC-SEL-5: Check if this edge is selected
						const edgeSelected = isHandleSelected('edge', i);

						const edgeHandle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
						edgeHandle.setAttribute('class', 'edge-handle');
						edgeHandle.setAttribute('data-edge-idx', i);
						edgeHandle.setAttribute('cx', midX);
						edgeHandle.setAttribute('cy', midY);
						edgeHandle.setAttribute('r', edgeSize / 2);
						// SC-SEL-5: Different fill/stroke for selected edges
						edgeHandle.setAttribute('fill', edgeSelected ? '#047857' : '#10b981');
						edgeHandle.setAttribute('stroke', edgeSelected ? '#fbbf24' : '#ffffff');
						edgeHandle.setAttribute('stroke-width', edgeSelected ? selectedStrokeWidth : strokeWidth);
						edgeHandle.style.cursor = 'move';
						edgeHandle.style.pointerEvents = 'all';
						ui.appendChild(edgeHandle);
					}
				}
			}
		}

		// SC-ROUND-1: Create a fillet handle (diamond shape) for a vertex
		function createFilletHandle(vertexIdx, v, scale) {
			const prev = pathEditVertices[vertexIdx - 1];
			if (!prev) return null;
			
			const filletSize = FILLET_HANDLE_SIZE * scale;
			const strokeWidth = 1.5 * scale;
			const radius = v.filletRadius || 0;
			
			// Determine the "prev" point for the incoming edge direction
			let prevX, prevY;
			if (prev.cmd === 'M') {
				// First vertex after M - incoming edge comes from last vertex before Z
				let lastBeforeZ = null;
				for (let i = pathEditVertices.length - 1; i >= 0; i--) {
					if (pathEditVertices[i].cmd === 'Z') continue;
					if (pathEditVertices[i].cmd !== 'M') {
						lastBeforeZ = pathEditVertices[i];
						break;
					}
				}
				if (lastBeforeZ) {
					prevX = lastBeforeZ.x;
					prevY = lastBeforeZ.y;
				} else {
					return null;
				}
			} else {
				prevX = prev.x;
				prevY = prev.y;
			}
			
			// Compute direction from vertex toward prev
			const dx = prevX - v.x;
			const dy = prevY - v.y;
			const len = Math.sqrt(dx * dx + dy * dy);
			if (len < 0.001) return null;
			
			// Position fillet handle offset from vertex along the incoming edge
			// The handle position indicates the current fillet tangent point
			const offsetDist = Math.max(radius, 8 * scale); // Min offset for visibility
			const handleX = v.x + (dx / len) * offsetDist;
			const handleY = v.y + (dy / len) * offsetDist;
			
			// Create diamond shape
			const handle = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
			const points = [
				`${handleX},${handleY - filletSize}`,
				`${handleX + filletSize},${handleY}`,
				`${handleX},${handleY + filletSize}`,
				`${handleX - filletSize},${handleY}`
			].join(' ');
			
			handle.setAttribute('class', 'fillet-handle');
			handle.setAttribute('data-fillet-idx', vertexIdx);
			handle.setAttribute('points', points);
			// Orange/amber color to distinguish from vertex (blue) and edge (green) handles
			handle.setAttribute('fill', radius > 0 ? '#f59e0b' : '#fbbf24');
			handle.setAttribute('stroke', '#ffffff');
			handle.setAttribute('stroke-width', strokeWidth);
			handle.style.cursor = 'ns-resize'; // Vertical resize cursor indicates drag direction
			handle.style.pointerEvents = 'all';
			
			// Add title tooltip showing current radius
			const title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
			title.textContent = `Fillet radius: ${radius.toFixed(1)}`;
			handle.appendChild(title);
			
			return handle;
		}

		function clearPathEditHandles() {
			const ui = getSelectionUi();
			if (ui) {
				ui.querySelectorAll('.vertex-handle, .edge-handle, .fillet-handle').forEach(el => el.remove());
			}
		}

		function startVertexDrag(handle, svgPt, isCtrlOrCmd) {
			const idx = parseInt(handle.getAttribute('data-vertex-idx'), 10);
			if (isNaN(idx) || idx < 0 || idx >= pathEditVertices.length) return;
			
			// SC-SEL-5: Handle multi-selection
			if (isCtrlOrCmd) {
				// Toggle this handle in selection
				toggleHandleSelection('vertex', idx);
				renderPathEditHandles();
				return; // Don't start drag on Ctrl/Cmd click
			}
			
			// SC-SEL-5: If the handle is not selected, select it alone (Illustrator-style)
			if (!isHandleSelected('vertex', idx)) {
				setHandleSelectionSingle('vertex', idx);
				renderPathEditHandles();
