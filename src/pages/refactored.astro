					: null;
				
				if (filletGeom) {
					// Output line to first tangent point, then arc to second tangent point
					newD += `L ${filletGeom.t1x} ${filletGeom.t1y} `;
					newD += `A ${filletGeom.r} ${filletGeom.r} 0 0 ${filletGeom.sweep} ${filletGeom.t2x} ${filletGeom.t2y} `;
