						csv = layers
							.flatMap((layer) =>
								layer.children.map(
									(child) =>
										`${layer.id} ${child.id},${child.x},${child.y}`,
								),
							)
							.join("\n");
					}
				}

				// SC-EXPORT-1: Use CSV source-file basename directly, skip formatExportFilename
				const baseName = getActiveCsvExportBasename();
				var blob = new Blob([csv], { type: "text/csv" });
