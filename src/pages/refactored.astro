			if (!ui || !pathEditTargetPath) return;

			clearPathEditHandles();

			const svg = document.querySelector('#svg-container svg');
			if (!svg) return;
			const ctm = svg.getScreenCTM();
			const scale = ctm ? 1 / ctm.a : 1;
			const vertexSize = VERTEX_HANDLE_SIZE * scale;
			const edgeSize = EDGE_HANDLE_SIZE * scale;
